<Page x:Class="WinProvision.Store.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Histórico"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      UseLayoutRounding="True">
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PageHeaderIconTileStyle}"><ui:SymbolIcon Symbol="Clock24" Style="{StaticResource PageHeaderSymbolIconStyle}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Histórico de operações" Style="{StaticResource FluentPageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock Text="Consulte instalações, atualizações e remoções recentes." Style="{StaticResource FluentPageSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PageToolbarContainerStyle}">
            <ui:Button Content="Limpar histórico" Appearance="Secondary"
                       Style="{StaticResource StoreActionButtonStyle}"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       ToolTip="Remover operações do histórico"
                       Click="ClearHistory_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:Button.Icon>
            </ui:Button>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16" Effect="{x:Null}">
            <Grid>
                <TextBlock x:Name="EmptyText" Text="As operações concluídas aparecerão aqui."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12" Margin="0,0,0,8"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap">
                                            <Run Text="{Binding KindLabel, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding AppName, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0">
                                            <Run Text="{Binding FinishedAtLocal, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding MethodLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="9,4" CornerRadius="{StaticResource CompactCornerRadius}"
                                            VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding StateLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Page>
