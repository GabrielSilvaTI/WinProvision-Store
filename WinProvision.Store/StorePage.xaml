<Page x:Class="WinProvision.Store.StorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:WinProvision.Store"
      ScrollViewer.CanContentScroll="False"
      Title="StorePage">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0: Cabeçalho Fixo -->
            <RowDefinition Height="Auto" />
            <!-- 1: Controles e Busca Fixos -->
            <RowDefinition Height="Auto" />
            <!-- 2: Lista de Resultados (Preenche o espaço restante e rola isolada) -->
            <RowDefinition Height="*" />
            <!-- 3: Rodapé / Status Fixo -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Loja de Apps" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Pesquise e instale aplicativos disponíveis através do winget." 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- BUSCA E AÇÕES -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <ui:TextBox x:Name="SearchTextBox" 
                        PlaceholderText="Pesquise aplicativos..." 
                        TextChanged="SearchTextBox_TextChanged"
                        KeyDown="SearchTextBox_KeyDown" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Adicionar seleção aos pacotes" 
                           Icon="{ui:SymbolIcon Add24}" 
                           Click="AddSelectionButton_Click" 
                           Margin="0,0,8,0" />
                <ui:Button Content="Recarregar catálogo" 
                           Icon="{ui:SymbolIcon ArrowClockwise24}" 
                           Click="RefreshButton_Click" />
            </StackPanel>
        </StackPanel>

        <!-- ÁREA ROLÁVEL ISOLADA COM ITEMTEMPLATE -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ResultsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox de Seleção -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <!-- Ícone do App -->
                                <Border Grid.Column="1" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding IconUrl}" Stretch="Uniform" />
                                </Border>

                                <!-- Informações do App -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Publisher, StringFormat=' ({0})'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11">
                                        <Run Text="ID: " />
                                        <Run Text="{Binding Id, Mode=OneWay}" />
                                        <Run Text="   Versão: " />
                                        <Run Text="{Binding Version, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Botão de Instalação -->
                                <ui:Button Grid.Column="3" VerticalAlignment="Center" Content="Instalar" Appearance="Primary"
                                           Click="InstallButton_Click" Tag="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- BARRA DE STATUS -->
        <TextBlock x:Name="StatusText" 
                   Grid.Row="3" 
                   Margin="0,12,0,0" 
                   Text="Pronto para pesquisar" 
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </Grid>
</Page>