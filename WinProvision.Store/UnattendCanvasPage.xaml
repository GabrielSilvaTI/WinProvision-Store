<Page x:Class="WinProvision.Store.UnattendCanvasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="Gerador de arquivo de resposta"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True">

    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Style="{StaticResource PageHeaderIconTileStyle}"><ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource PageHeaderSymbolIconStyle}" /></Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gerador de arquivo de resposta" Style="{StaticResource FluentPageTitleStyle}" />
                    <TextBlock Text="Canvas oficial do Schneegans." Style="{StaticResource FluentPageSubtitleStyle}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Abrir no Navegador"
                           Appearance="Secondary"
                           Click="OpenInBrowserButton_Click"
                           ToolTip="Abra o Canvas no navegador padrão para usar os recursos de tradução disponíveis nele."
                           Margin="0,0,8,0"
                           CornerRadius="{StaticResource ControlCornerRadius}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Open24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppCardBorderBrush}"
                Background="{DynamicResource AppCardBackgroundBrush}"
                Padding="1"
                Margin="0,0,0,16">
            <Grid>
                <wv2:WebView2 x:Name="GeneratorBrowser" />
                <Border x:Name="BrowserStatusPanel"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        Opacity="0.97"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="560">
                        <ui:SymbolIcon Symbol="Globe24"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <TextBlock Text="Abrindo o Canvas oficial"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                        <TextBlock x:Name="BrowserStatusText"
                                   Text="Carregando o gerador Schneegans…"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,8,0,0" />
                        <ui:Button x:Name="RetryButton"
                                   Content="Tentar novamente"
                                   Click="RetryButton_Click"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
