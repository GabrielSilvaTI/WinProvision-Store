<ui:FluentWindow x:Class="WinProvision.Store.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WinProvision.Store"
        xmlns:controls="clr-namespace:WinProvision.Store.Controls"
        Title="WinProvision Store"
        Height="720" Width="1180" MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ui:TitleBar Title="WinProvision Store v1.0.0">
                <!-- TrailingContent é hit-test visível "de fábrica" pelo próprio TitleBar
                     (ele mesmo trata cliques aqui como área interativa, não como arraste
                     de janela) - é o slot certo para botões extras, em vez de sobrepor
                     algo por cima manualmente. -->
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                        <ui:Button x:Name="QueueToggleButton"
                                   Appearance="Transparent"
                                   Padding="8"
                                   VerticalAlignment="Center"
                                   ToolTip="Fila de operações"
                                   Click="QueueToggleButton_Click">
                            <Grid>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                                <Border x:Name="QueueBadge"
                                        Width="16" Height="16" CornerRadius="8"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-6,-8,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="QueueBadgeText" Text="0" FontSize="9" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </ui:Button>

                        <Popup x:Name="QueuePopup"
                               PlacementTarget="{Binding ElementName=QueueToggleButton}"
                               Placement="Bottom"
                               HorizontalOffset="-360"
                               VerticalOffset="6"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <controls:OperationsQueuePanel x:Name="QueuePanelControl" />
                        </Popup>
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Grid>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            OpenPaneLength="216">

            <!-- Itens Principais do Menu -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Visão Geral" TargetPageType="{x:Type local:HomePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Pacotes" TargetPageType="{x:Type local:PackagesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="AppsListDetail24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Atualizações" TargetPageType="{x:Type local:UpdatesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Office" TargetPageType="{x:Type local:OfficePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="AppsAddIn24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Provisionamento" TargetPageType="{x:Type local:ProvisioningPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Desktop24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <!-- Itens do Rodapé (Configurações, Sobre, GitHub) -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Configurações" TargetPageType="{x:Type local:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Sobre">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="GitHub">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Code24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>

        <!-- Overlay de Detalhes do pacote: fica por cima de TUDO (TitleBar +
             NavigationView, daí o RowSpan="2") porque é declarado por último no Grid -
             no WPF, entre irmãos do mesmo painel, quem vem depois no XAML desenha por
             cima. Content é atribuído em code-behind (ver MainWindow.xaml.cs) porque o
             AppDetailsOverlay é resolvido via injeção de dependência, não instanciado
             direto aqui. Substitui a antiga AppDetailsWindow (janela/processo à parte). -->
        <ContentControl x:Name="DetailsOverlayHost" Grid.Row="0" Grid.RowSpan="2" Focusable="False" />
    </Grid>
</ui:FluentWindow>