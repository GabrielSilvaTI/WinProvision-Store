<ui:FluentWindow x:Class="WinProvision.Store.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:WinProvision.Store"
                 xmlns:controls="clr-namespace:WinProvision.Store.Controls"
                 Title="WinProvision Store"
                 Icon="Assets/app.ico"
                 Height="760"
                 Width="1240"
                 MinHeight="620"
                 MinWidth="820"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default"
                 Background="Transparent"
                 FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
                 TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
                 TextElement.FontSize="14"
                 TextOptions.TextRenderingMode="ClearType"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextHintingMode="Auto"
                 RenderOptions.ClearTypeHint="Enabled"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="WinProvision Store"
                     Height="48"
                     Background="Transparent"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     BorderThickness="0,0,0,1"
                     CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app_icon_256.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <ui:Button x:Name="QueueToggleButton"
                               Style="{StaticResource StoreActionButtonStyle}"
                               Appearance="Transparent"
                               MinWidth="40"
                               MinHeight="40"
                               Padding="8"
                               VerticalAlignment="Center"
                               ToolTip="Fila de operações"
                               AutomationProperties.Name="Abrir fila de operações"
                               Click="QueueToggleButton_Click">
                            <Grid>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                                <Border x:Name="QueueBadge"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="{StaticResource CompactCornerRadius}"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-6,-8,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="QueueBadgeText"
                                               Text="0"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           Transition="FadeInWithSlide"
                           TransitionDuration="220"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           ItemTemplate="{StaticResource StoreNavigationViewItemTemplate}"
                           OpenPaneLength="240"
                           CompactPaneLength="64"
                           IsPaneToggleVisible="True"
                           IsBackButtonVisible="Collapsed"
                           Background="Transparent"
                           BorderThickness="0"
                           BorderBrush="Transparent"
                           IsTopSeparatorVisible="False"
                           IsFooterSeparatorVisible="False">

            <!-- Itens principais de navegação. -->
            <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Descobrir" TargetPageType="{x:Type local:HomePage}" ToolTip="Descobrir aplicativos">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Atualizações" TargetPageType="{x:Type local:UpdatesPage}" ToolTip="Verificar e instalar atualizações">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Instalados" TargetPageType="{x:Type local:InstalledPackagesPage}" ToolTip="Gerenciar aplicativos instalados">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Box24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Coleções" TargetPageType="{x:Type local:PackagesPage}" ToolTip="Gerenciar coleções de pacotes">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Apps24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Office" TargetPageType="{x:Type local:OfficePage}" ToolTip="Gerenciar Microsoft Office">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DocumentText24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Provisionamento" TargetPageType="{x:Type local:ProvisioningPage}" ToolTip="Configurar o provisionamento do Windows">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Desktop24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Conta &amp; Sincronização" TargetPageType="{x:Type local:AccountSyncPage}" ToolTip="Conta e sincronização">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Person24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Configurações" TargetPageType="{x:Type local:SettingsPage}" ToolTip="Configurações do aplicativo">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Mais" TargetPageType="{x:Type local:MorePage}" ToolTip="Mais ferramentas e informações">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="MoreHorizontal24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>

        <!-- Painel compacto no conteúdo, sem alcançar a navegação lateral. -->
        <controls:OperationsQueuePanel x:Name="QueuePanel"
                                       Grid.Row="1"
                                       Width="480"
                                       MaxHeight="340"
                                       Margin="0,0,16,16"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Panel.ZIndex="10"
                                       Visibility="Collapsed" />

        <ui:SnackbarPresenter x:Name="MainSnackbarPresenter"
                              Grid.Row="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,16,20,0"
                              MaxWidth="420"
                              Panel.ZIndex="20" />

        <ui:ContentDialogHost x:Name="RootContentDialog"
                              Grid.RowSpan="2"
                              Panel.ZIndex="30">
            <ui:ContentDialogHost.Resources>
                <Style TargetType="ui:Button"
                       BasedOn="{StaticResource DialogActionButtonStyle}" />
            </ui:ContentDialogHost.Resources>
        </ui:ContentDialogHost>

        <!-- O overlay de detalhes ocupa a janela inteira para manter foco na ação atual. -->
        <ContentControl x:Name="DetailsOverlayHost"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Focusable="False"
                        Panel.ZIndex="40" />
    </Grid>
</ui:FluentWindow>
