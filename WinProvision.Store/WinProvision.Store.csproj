<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationManifest>app.manifest</ApplicationManifest>

		<!-- Facilita o publish em .exe único (self-contained), sem precisar passar tudo via linha de comando -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WPF-UI" Version="4.3.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
		<!-- Teste: decodificar webp que o WIC do WPF não decodifica nativamente -->
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\src\WinProvision.Core\WinProvision.Core.csproj" />
	</ItemGroup>

	<!-- Ícone genérico de fallback embutido direto no .exe (Assets/Icons/default_app.png).
	     Resource (não Content) pra ficar acessível via pack://application:,,,/... a
	     partir do assembly principal. O lote curado por app (CuratedIconCatalog) foi
	     removido: o bucket Cloudflare já cobre os mesmos apps, sem precisar recompilar
	     o .exe pra corrigir um ícone. -->
	<ItemGroup>
		<Resource Include="Assets\Icons\**\*.png" />
	</ItemGroup>

</Project>