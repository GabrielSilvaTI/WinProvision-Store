<Application x:Class="WinProvision.Store.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:WinProvision.Store.Converters"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Define o tema Dark padrão da WPF UI v4  -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/GradientProgressBar.xaml" />
                <ResourceDictionary Source="Styles/InstallActionBrushes.xaml" />
                <ResourceDictionary Source="Styles/VisualPolish.xaml" />
                <ResourceDictionary Source="Styles/ComboBoxStyle.xaml" />
                <ResourceDictionary Source="Styles/FluentSurface.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Available from the root dictionary to pages created during startup.  -->
            <CornerRadius x:Key="CompactCornerRadius">4</CornerRadius>

            <!--
                Ícones agora usam a attached property conv:AsyncImage.SourceUrl
                (download+decode assíncrono e cacheado) em vez de um converter
                síncrono na thread de UI — ver Converters/AsyncImage.cs
            -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:StageToSymbolConverter x:Key="StageToSymbolConverter" />
            <conv:StageStatusToFilledConverter x:Key="StageStatusToFilledConverter" />
            <conv:StageStatusToIconForegroundConverter x:Key="StageStatusToIconForegroundConverter" />

            <!--  Shared blue-gray base for dialogs and opaque page surfaces.  -->
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF1B2835" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#E8172A40" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#E0263446" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F02D4056" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E01D3047" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#E0263446" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#E02B3B50" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#8050657D" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#70475C75" />
            <SolidColorBrush x:Key="SurfaceFillColorDefaultBrush" Color="#E01D3047" />
            <SolidColorBrush x:Key="SurfaceFillColorSecondaryBrush" Color="#E02B3B50" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E02B3B50" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#E01D3047" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#8050657D" />
            <SolidColorBrush x:Key="RegionFillColorDefaultBrush" Color="#E8172A40" />
            <SolidColorBrush x:Key="RegionFillColorSecondaryBrush" Color="#E0263446" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#1688E8" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFC107" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#EF4444" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
