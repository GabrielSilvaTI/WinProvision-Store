<Page x:Class="WinProvision.Store.AccountSyncPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      ScrollViewer.CanContentScroll="False"
      Title="Conta &amp; Sincronização"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <!-- Tipografia Fluent -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="24" ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsRowSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SubMenuHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="Margin" Value="4,12,0,8" />
        </Style>

        <!-- Sidebar stat row -->
        <Style x:Key="SidebarStatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SidebarStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Standard Toggle Button Style -->
        <Style x:Key="StandardToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="110" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Estado Desmarcado Hover / Pressed -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </Trigger>

                            <!-- Estado Marcado (Checked) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InstallActionBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InstallActionBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InstallActionHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InstallActionHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InstallActionPressedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InstallActionPressedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button for Logs (Desativado / Ativado) -->
        <Style x:Key="LogToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource StandardToggleButtonStyle}">
            <Setter Property="Content" Value="Desativado" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="Ativado" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Button for Modo de Execução (Silencioso / UI visível) -->
        <Style x:Key="UiModeToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource StandardToggleButtonStyle}">
            <Setter Property="Content" Value="Silencioso" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="UI visível" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Border Background="Transparent" Margin="36,24,36,24" CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid Margin="36,24,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

        <!-- ================= Cabeçalho Global ================= -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,24">
            <TextBlock Style="{StaticResource PageHeaderIconStyle}" Text="&#xE77B;" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Conta &amp; Sincronização" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Sincronização na nuvem, backup local, perfis JSON e automação por linha de comando."
                           Style="{StaticResource CardSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- ================= Conteúdo Principal ================= -->
        <ScrollViewer Grid.Row="1" Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,0">



                <!-- ── Sub-menu: Perfil em Nuvem ── -->
                <TextBlock Text="Perfil em Nuvem" Style="{StaticResource SubMenuHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- Log Local -->
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE7C3;" FontSize="16" Margin="0,0,8,0"
                                                  FontFamily="Segoe Fluent Icons"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Gravar Log de Execução (/log)" Style="{StaticResource SettingsRowTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="Grava o histórico detalhado das ações em um arquivo de log local."
                                           Style="{StaticResource SettingsRowSubtitleStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="CliLogPathTextBox" Grid.Column="0"
                                            PlaceholderText="C:\WinProvision\exec.log"
                                            IsEnabled="{Binding IsChecked, ElementName=CliLogToggle}"
                                            TextChanged="CliField_Changed"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0" />
                                <ToggleButton x:Name="CliLogToggle" Grid.Column="1"
                                              Style="{StaticResource LogToggleButtonStyle}"
                                              Checked="CliField_Changed" Unchecked="CliField_Changed"
                                              VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>

                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                        <!-- Logs na Nuvem (/cloudlog) -->
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xEDE4;" FontSize="16" Margin="0,0,8,0"
                                                  FontFamily="Segoe Fluent Icons"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Logs na Nuvem (/cloudlog)" Style="{StaticResource SettingsRowTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="Transmite os logs de execução para telemetria e acompanhamento remoto."
                                           Style="{StaticResource SettingsRowSubtitleStyle}" />
                            </StackPanel>
                            <ToggleButton x:Name="CliCloudLogToggle" Grid.Column="1"
                                          Style="{StaticResource LogToggleButtonStyle}"
                                          Checked="CliField_Changed" Unchecked="CliField_Changed"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                        <!-- Modo de Execução -->
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE768;" FontSize="16" Margin="0,0,8,0"
                                                  FontFamily="Segoe Fluent Icons"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Modo de Execução" Style="{StaticResource SettingsRowTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="Defina se a tela gráfica de progresso será exibida durante a execução."
                                           Style="{StaticResource SettingsRowSubtitleStyle}" />
                            </StackPanel>
                            <ToggleButton x:Name="CliUiModeToggle" Grid.Column="1"
                                          Style="{StaticResource UiModeToggleButtonStyle}"
                                          IsChecked="True"
                                          Checked="CliField_Changed" Unchecked="CliField_Changed"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Sub-menu: Gerador de Comandos ── -->
                <TextBlock Text="Gerador de Comandos" Style="{StaticResource SubMenuHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Margin="24,16">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE943;" FontSize="16" Margin="0,0,10,0"
                                              FontFamily="Segoe Fluent Icons"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Comando Gerado" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="Execute este comando em um prompt com privilégios de administrador para provisionar a máquina."
                                               Style="{StaticResource SettingsRowSubtitleStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="{StaticResource ControlCornerRadius}" Background="#1A000000" Padding="12" Margin="24,0,24,16"
                                BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="1">
                            <TextBox x:Name="CliCommandPreviewTextBox" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent"
                                     FontFamily="Cascadia Mono, Consolas, Courier New"
                                     FontSize="12" TextWrapping="Wrap" AcceptsReturn="True"
                                     Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="24,0,24,16">
                            <ui:Button Content="Copiar comando" Appearance="Primary"
                                       Click="CopyCliCommandButton_Click" CornerRadius="{StaticResource ControlCornerRadius}"
                                       Background="{StaticResource InstallActionBrush}"
                                       MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                                       PressedBackground="{StaticResource InstallActionPressedBrush}"
                                       Foreground="White" PressedForeground="White">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= Painel Lateral ================= -->
        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top">

            <!-- ── Resumo da Conta ── -->
            <Border CornerRadius="{StaticResource OverlayCornerRadius}" BorderThickness="1"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    Padding="20">
                <StackPanel>

                    <!-- Título do painel -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:FontIcon Glyph="&#xE77B;" FontSize="18" Margin="0,0,8,0"
                                     FontFamily="Segoe Fluent Icons"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Resumo da Conta"
                                   FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Aptos, Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- ── Estado: Desconectado ── -->
                    <StackPanel x:Name="SidebarDisconnectedPanel">

                        <!-- Painel inicial: só o botão OAuth -->
                        <StackPanel x:Name="OAuthInitialPanel">
                            <TextBlock Text="Conecte sua conta GitHub para sincronizar seu perfil na nuvem."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />

                            <ui:Button x:Name="ConnectButton"
                                       Content="Entrar com GitHub"
                                       HorizontalAlignment="Stretch"
                                       Appearance="Primary"
                                       Click="ConnectButton_Click"
                                       CornerRadius="{StaticResource ControlCornerRadius}"
                                       Background="{StaticResource InstallActionBrush}"
                                       MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                                       PressedBackground="{StaticResource InstallActionPressedBrush}"
                                       Foreground="White" PressedForeground="White">
                                <ui:Button.Icon>
                                    <ui:ImageIcon Source="https://pub-166b41912a994dbe86583ba10596d673.r2.dev/Store/Icon_Database/github.cli.png"
                                                  Width="16" Height="16" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                        <!-- Painel de espera: mostra user_code enquanto aguarda autenticação -->
                        <StackPanel x:Name="OAuthWaitingPanel" Visibility="Collapsed">
                            <TextBlock Text="Acesse o endereço abaixo e insira o código:"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <!-- Link clicável -->
                            <TextBlock FontSize="12" Margin="0,0,0,10">
                                <Hyperlink x:Name="OAuthVerificationLink" NavigateUri="https://github.com/login/device"
                                           RequestNavigate="OAuthLink_RequestNavigate">
                                    github.com/login/device
                                </Hyperlink>
                            </TextBlock>

                            <!-- Código de usuário em destaque -->
                            <Border CornerRadius="{StaticResource OverlayCornerRadius}" Background="#1AFFFFFF" BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                                    BorderThickness="1" Padding="12,10" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OAuthUserCodeText"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="18" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    <ui:Button Grid.Column="1" Appearance="Secondary" CornerRadius="{StaticResource CompactCornerRadius}"
                                               Padding="6,4" ToolTip="Copiar código"
                                               Click="CopyOAuthCodeButton_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Copy24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </Border>

                            <!-- Status e cancelar -->
                            <TextBlock x:Name="OAuthStatusText"
                                       Text="Aguardando autenticação no browser..."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <ui:Button x:Name="CancelOAuthButton"
                                       Content="Cancelar"
                                       HorizontalAlignment="Stretch"
                                       Appearance="Secondary"
                                       Click="CancelOAuthButton_Click"
                                       CornerRadius="{StaticResource ControlCornerRadius}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>

                    </StackPanel>

                    <!-- ── Estado: Conectado ── -->
                    <StackPanel x:Name="SidebarConnectedPanel" Visibility="Collapsed">

                        <!-- Avatar (Foto de perfil do GitHub com fallback) -->
                        <Border Width="56" Height="56" CornerRadius="{StaticResource OverlayCornerRadius}"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                ClipToBounds="True"
                                HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Grid>
                                <ui:SymbolIcon Symbol="Person24" FontSize="28" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=SidebarAvatarImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <Image x:Name="SidebarAvatarImage"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=SidebarAvatarImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <!-- Login -->
                        <TextBlock x:Name="SidebarLoginText"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="GitHub"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />

                        <!-- Separador -->
                        <Rectangle Height="1" Fill="#0DFFFFFF" Margin="0,0,0,12" />

                        <!-- Linha: Sincronização -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Sincronização" Style="{StaticResource SidebarStatLabelStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="SidebarSyncStatusText" Grid.Column="1"
                                       Text="Ativa"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Style="{StaticResource SidebarStatValueStyle}" />
                        </Grid>

                        <!-- Linha: Última sync -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="12" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Última sync" Style="{StaticResource SidebarStatLabelStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="SidebarLastSyncText" Grid.Column="1"
                                       Style="{StaticResource SidebarStatValueStyle}" />
                        </Grid>

                        <!-- Separador -->
                        <Rectangle Height="1" Fill="#0DFFFFFF" Margin="0,8,0,12" />

                        <!-- Botão Desvincular -->
                        <ui:Button x:Name="DisconnectButton"
                                   Content="Desvincular"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Secondary"
                                   Click="DisconnectButton_Click"
                                   CornerRadius="{StaticResource ControlCornerRadius}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="LinkDismiss24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ── Card: Backup ── -->
            <Border CornerRadius="{StaticResource OverlayCornerRadius}" BorderThickness="1"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    Padding="20" Margin="0,16,0,0">
                <StackPanel>

                    <!-- Título -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:FontIcon Glyph="&#xEBD3;" FontSize="18" Margin="0,0,8,0"
                                     FontFamily="Segoe Fluent Icons"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Backup"
                                   FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Aptos, Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock x:Name="LocalBackupStatusText" Text="Último backup: nunca"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,14" />

                    <!-- Ação: Backup -->
                    <ui:Button x:Name="BackupButton"
                               Content="Backup"
                               HorizontalAlignment="Stretch"
                               Appearance="Secondary"
                               Click="BackupButton_Click"
                               CornerRadius="{StaticResource ControlCornerRadius}"
                               Margin="0,0,0,8">
                        <ui:Button.Icon>
                            <ui:FontIcon Glyph="&#xEBD3;" FontFamily="Segoe Fluent Icons" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- Ação: Importar -->
                    <ui:Button x:Name="ImportAllButton"
                               Content="Importar"
                               HorizontalAlignment="Stretch"
                               Appearance="Secondary"
                               Click="ImportAllButton_Click"
                               CornerRadius="{StaticResource ControlCornerRadius}"
                               Margin="0,0,0,8">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowImport24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- Ação: Exportar -->
                    <ui:Button x:Name="ExportAllButton"
                               Content="Exportar"
                               HorizontalAlignment="Stretch"
                               Appearance="Primary"
                               Click="ExportAllButton_Click"
                               CornerRadius="{StaticResource ControlCornerRadius}"
                               Background="{StaticResource InstallActionBrush}"
                               MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                               PressedBackground="{StaticResource InstallActionPressedBrush}"
                               Foreground="White" PressedForeground="White">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DocumentArrowRight24" />
                        </ui:Button.Icon>
                    </ui:Button>

                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ================= Rodapé com Status ================= -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3"
                   Margin="4,12,4,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontFamily="Segoe UI Variable Text" />
    </Grid>
    </Border>
</Page>
