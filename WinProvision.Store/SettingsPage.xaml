<Page x:Class="WinProvision.Store.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="SettingsPage"
      Background="Transparent"
    TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
    TextElement.FontSize="14"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True">

    <Page.Resources>
        <!-- Tipografia Fluent (Segoe UI Variable) -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        </Style>

        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Cartão de Configurações (Estilo Lista do Win11) -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#06FFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Estilos para as Linhas de Configuração internas -->
        <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        </Style>

        <Style x:Key="SettingsRowSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Menu Principal (Cards Largos idênticos à imagem base) -->
        <Style x:Key="MenuCardButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Background" Value="#06FFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="20" />
            <!-- Deixa o botão mais alto/largo -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Page.Resources>

    <!-- O SEGREDO ESTAVA AQUI: Removido o HorizontalAlignment="Left" que encolhia a tela -->
    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Cabeçalho Global ================= -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,32">
            <ui:SymbolIcon Symbol="Settings24" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Configurações" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Conta, aparência e backup do WinProvision Store, organizados por seção."
                           Style="{StaticResource CardSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- ================= Visão 1: Menu Principal (Drill-down) ================= -->
            <ScrollViewer x:Name="SettingsOverviewPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- MAXWIDTH 1000 + ALIGNMENT STRETCH: Preenche a tela mantendo proporção -->
                <StackPanel Margin="0,0,16,0" MaxWidth="1000" HorizontalAlignment="Stretch">

                    <!-- Conta -->
                    <ui:Button x:Name="AccountNavCard" Style="{StaticResource MenuCardButtonStyle}" Click="AccountNavCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- CAIXINHA DO ÍCONE PIXEL PERFECT (Igual a imagem) -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Background="{StaticResource AppSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource AppBorderSubtleBrush}" Margin="0,0,20,0">
                                <ui:SymbolIcon Symbol="PersonCircle24" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Conta" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Vínculo de conta GitHub, status da API e perfil de backup." Style="{StaticResource CardSubtitleStyle}" FontSize="13" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </ui:Button>

                    <!-- Aparência da UI -->
                    <ui:Button x:Name="AppearanceNavCard" Style="{StaticResource MenuCardButtonStyle}" Click="AppearanceNavCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Background="{StaticResource AppSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource AppBorderSubtleBrush}" Margin="0,0,20,0">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Aparência da UI" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Tema claro/escuro, efeitos de transparência (Mica/Acrylic) e cor de destaque." Style="{StaticResource CardSubtitleStyle}" FontSize="13" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </ui:Button>

                    <!-- Backup & Exportação -->
                    <ui:Button x:Name="BackupNavCard" Style="{StaticResource MenuCardButtonStyle}" Click="BackupNavCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Background="{StaticResource AppSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource AppBorderSubtleBrush}" Margin="0,0,20,0">
                                <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Backup &amp; Exportação" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Exportar perfil completo (.json), histórico local e sincronização na nuvem (Gist)." Style="{StaticResource CardSubtitleStyle}" FontSize="13" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </ui:Button>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Visão 2: Formulários das Seções ================= -->
            <Grid x:Name="SectionPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                    <ui:Button Appearance="Transparent" Padding="8,6" CornerRadius="6" Click="BackToSettingsButton_Click">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" />
                    </ui:Button>
                    <TextBlock x:Name="SectionTitleText" Style="{StaticResource PageTitleStyle}" FontSize="20" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- MESMA REGRA APLICADA AQUI para os formulários abrirem no exato tamanho dos cartões -->
                    <StackPanel Margin="0,0,16,0" MaxWidth="1000" HorizontalAlignment="Stretch">

                        <!-- ================= 1. CONTA ================= -->
                        <ScrollViewer x:Name="AccountSectionPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                                <TextBlock Text="Vínculo com o GitHub (Gist secreto)" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Guarda seu backup na nuvem, sobrevivendo a formatações. Gere um token no GitHub com permissão 'gist'." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>

                                            <!-- Desconectado -->
                                            <StackPanel x:Name="AccountConnectPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:PasswordBox x:Name="TokenPasswordBox" PlaceholderText="ghp_..." Width="200" Margin="0,0,8,0" />
                                                <ui:Button x:Name="ConnectButton" Content="Vincular conta" Appearance="Primary" Click="ConnectButton_Click" CornerRadius="6" />
                                            </StackPanel>

                                            <!-- Conectado -->
                                            <StackPanel x:Name="AccountConnectedPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock x:Name="ConnectedStatusText" Text="Conectado" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="Segoe UI Variable Text" />
                                                <ui:Button x:Name="DisconnectButton" Content="Desvincular" Appearance="Secondary" Click="DisconnectButton_Click" CornerRadius="6" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="24,16">
                                            <StackPanel>
                                                <TextBlock Text="Perfil e Webhook Padrão (CLI)" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Valores padrão carregados automaticamente na tela de Gerador de Comando CLI." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="340" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Caminho ou URL do perfil .json" Style="{StaticResource SettingsRowTitleStyle}" />
                                            </StackPanel>
                                            <ui:TextBox x:Name="DefaultProfilePathTextBox" Grid.Column="1" PlaceholderText="https://gist..." VerticalAlignment="Center" />
                                        </Grid>

                                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="340" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="URL do Webhook (Discord/Slack)" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock x:Name="WebhookConfiguredStatusText" Text="Não configurado" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <ui:Button x:Name="RemoveWebhookButton" Content="Remover" Appearance="Transparent" Padding="4,0" Margin="8,0,0,0" FontSize="12" Click="RemoveWebhookButton_Click" Visibility="Collapsed" />
                                                </StackPanel>
                                            </StackPanel>
                                            <ui:PasswordBox x:Name="DefaultWebhookPasswordBox" Grid.Column="1" PlaceholderText="https://discord.com/api..." VerticalAlignment="Center" />
                                        </Grid>

                                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                                        <StackPanel Orientation="Horizontal" Margin="24,16" HorizontalAlignment="Right">
                                            <ui:Button x:Name="UseCurrentCliValuesButton" Content="Copiar valores atuais da CLI" Appearance="Secondary" Click="UseCurrentCliValuesButton_Click" CornerRadius="6" Margin="0,0,12,0" />
                                            <ui:Button x:Name="SaveDefaultsButton" Content="Salvar Padrões" Appearance="Primary" Click="SaveDefaultsButton_Click" CornerRadius="6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= 2. APARÊNCIA ================= -->
                        <ScrollViewer x:Name="AppearanceSectionPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Tema do Aplicativo" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Substitui a configuração padrão do Windows." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button x:Name="LightThemeButton" Content="Claro" Appearance="Secondary" Margin="0,0,8,0" Click="LightThemeButton_Click" CornerRadius="6">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="WeatherSunny24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                                <ui:Button x:Name="DarkThemeButton" Content="Escuro" Appearance="Secondary" Click="DarkThemeButton_Click" CornerRadius="6">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="WeatherMoon24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid Margin="24,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                            <TextBlock Text="Cache local" Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Limpa catálogo, ícones e metadados temporários. Perfis, backups e configurações não são afetados." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                        </StackPanel>
                                        <ui:Button x:Name="ClearCacheButton" Grid.Column="1" Content="Limpar cache" Appearance="Secondary" VerticalAlignment="Center" Click="ClearCacheButton_Click" CornerRadius="6">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Broom24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= 3. BACKUP & EXPORTAÇÃO ================= -->
                        <ScrollViewer x:Name="BackupSectionPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Exportação Manual -->
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                                <TextBlock Text="Exportar perfil completo (.json)" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Gera um único arquivo .json combinando todas as guias de pacotes e as configurações de provisionamento atuais." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                            <ui:Button x:Name="ExportAllButton" Grid.Column="1" Content="Exportar .json" Appearance="Primary" VerticalAlignment="Center" Click="ExportAllButton_Click" CornerRadius="6">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="DocumentArrowRight24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Nuvem -->
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="24,16">
                                            <StackPanel>
                                                <TextBlock Text="Sincronização" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Recupere ou force o backup da sua biblioteca atual." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                                        <!-- Nuvem (Gist) -->
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Nuvem (Gist GitHub)" Style="{StaticResource SettingsRowTitleStyle}" />

                                                <!-- Desconectado -->
                                                <StackPanel x:Name="CloudBackupDisconnectedPanel" Margin="0,4,0,0">
                                                    <TextBlock Text="Nenhuma conta vinculada ainda." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                                                    <ui:Button Content="Vincular Conta" Appearance="Transparent" Padding="4,2" HorizontalAlignment="Left" Click="GoToAccountButton_Click" FontSize="12" />
                                                </StackPanel>

                                                <!-- Conectado -->
                                                <StackPanel x:Name="CloudBackupConnectedPanel" Margin="0,4,0,0" Visibility="Collapsed">
                                                    <TextBlock x:Name="CloudBackupStatusText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button x:Name="SyncNowButton" Content="Forçar Sync" Appearance="Secondary" Margin="0,0,8,0" Click="SyncNowButton_Click" CornerRadius="6">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="ArrowSync24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                                <ui:Button x:Name="RestoreButton" Content="Restaurar" Appearance="Secondary" Click="RestoreButton_Click" CornerRadius="6">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="CloudArrowDown24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                                        <!-- Backup Local Automático -->
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Backup Local Automático" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock x:Name="LocalBackupStatusText" Text="Salvo automaticamente a cada mudança." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                            <ui:Button x:Name="RestoreLocalButton" Grid.Column="1" Content="Restaurar backup local" Appearance="Secondary" VerticalAlignment="Center" Click="RestoreLocalButton_Click" CornerRadius="6">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= Rodapé com StatusText ================= -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" 
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontFamily="Segoe UI Variable Text" />
    </Grid>
</Page>