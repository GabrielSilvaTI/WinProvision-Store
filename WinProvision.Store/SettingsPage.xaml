<Page x:Class="WinProvision.Store.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="Configurações"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <!--  Tipografia Fluent  -->
        <Style x:Key="PageTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardSubtitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!--  Cartão de Configurações (Estilo Lista do Win11)  -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.2"
                                      BlurRadius="24"
                                      ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Estilos para as Linhas de Configuração internas  -->
        <Style x:Key="SettingsRowTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        </Style>

        <Style x:Key="SettingsRowSubtitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Page.Resources>

    <Border Background="Transparent"
            Margin="36,24,36,24"
            CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid Margin="36,24,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ================= Cabeçalho Global =================  -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,32">
                <TextBlock Style="{StaticResource PageHeaderIconStyle}" Text="&#xE713;" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Configurações" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Aparência e manutenção do aplicativo."
                               Style="{StaticResource CardSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <!--  ================= Conteúdo Principal =================  -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                <StackPanel Margin="0,0,16,0"
                            MaxWidth="1000"
                            HorizontalAlignment="Stretch">

                    <!--  1. Tema  -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="24,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,24,0">
                                    <TextBlock Text="Tema do Aplicativo" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="Escolha entre o tema claro ou escuro para a interface." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:Button x:Name="LightThemeButton"
                                               Content="Claro"
                                               Appearance="Secondary"
                                               Margin="0,0,8,0"
                                               Click="LightThemeButton_Click"
                                               CornerRadius="{StaticResource ControlCornerRadius}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="WeatherSunny24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="DarkThemeButton"
                                               Content="Escuro"
                                               Appearance="Secondary"
                                               Click="DarkThemeButton_Click"
                                               CornerRadius="{StaticResource ControlCornerRadius}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="WeatherMoon24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  2. Cache local  -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,24,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Cache Local" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="Limpa catálogo de pacotes, ícones e metadados temporários baixados da rede." Style="{StaticResource SettingsRowSubtitleStyle}" />
                            </StackPanel>
                            <ui:Button x:Name="ClearCacheButton"
                                       Grid.Column="1"
                                       Content="Limpar cache"
                                       Appearance="Secondary"
                                       VerticalAlignment="Center"
                                       Click="ClearCacheButton_Click"
                                       CornerRadius="{StaticResource ControlCornerRadius}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Broom24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!--  ================= Rodapé com status e versão =================  -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontFamily="Segoe UI Variable Text" />
                <TextBlock x:Name="VersionText"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontFamily="Segoe UI Variable Text"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Page>
