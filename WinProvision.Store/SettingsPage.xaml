<Page x:Class="WinProvision.Store.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="Configurações"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <!--  Tipografia Fluent  -->
        <Style x:Key="PageTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardSubtitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!--  Cartão de Configurações (Estilo Lista do Win11)  -->
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.2"
                                      BlurRadius="24"
                                      ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Estilos para as Linhas de Configuração internas  -->
        <Style x:Key="SettingsRowTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        </Style>

        <Style x:Key="SettingsRowSubtitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Page.Resources>

    <Border Background="Transparent"
            Margin="{StaticResource PageContentMargin}"
            CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ================= Cabeçalho Global =================  -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,32">
                <TextBlock Style="{StaticResource FluentPageIconStyle}" Text="&#xE713;" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Configurações" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Personalize o aplicativo."
                               Style="{StaticResource CardSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <!--  ================= Conteúdo Principal =================  -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                <StackPanel Margin="0,0,16,0"
                            MaxWidth="1000"
                            HorizontalAlignment="Stretch">

                    <!--  1. Tema  -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="24,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,24,0">
                                    <TextBlock Text="Tema do Aplicativo" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="Escolha um tema para o aplicativo." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:Button x:Name="LightThemeButton"
                                               Content="Claro"
                                               Appearance="Secondary"
                                               Margin="0,0,8,0"
                                               Click="LightThemeButton_Click"
                                               CornerRadius="{StaticResource ControlCornerRadius}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="WeatherSunny24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="DarkThemeButton"
                                               Content="Escuro"
                                               Appearance="Secondary"
                                               Click="DarkThemeButton_Click"
                                               CornerRadius="{StaticResource ControlCornerRadius}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="WeatherMoon24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Método preferido para instalações  -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,24,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Método de instalação" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock x:Name="InstallMethodDescriptionText"
                                           Text="Automático tenta outros métodos se uma instalação falhar."
                                           Style="{StaticResource SettingsRowSubtitleStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="InstallMethodComboBox"
                                      Grid.Column="1"
                                      Width="230"
                                      MinHeight="38"
                                      VerticalAlignment="Center"
                                      SelectionChanged="InstallMethodComboBox_SelectionChanged">
                                <ComboBoxItem Content="Automático (recomendado)" Tag="Automatic" />
                                <ComboBoxItem Content="API COM do WinGet" Tag="ComApi" />
                                <ComboBoxItem Content="API da WinProvision Store" Tag="WinProvisionApi" />
                                <ComboBoxItem Content="WinGet CLI" Tag="WingetCli" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!--  2. Cache local  -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,24,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Cache Local" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="Remove os dados temporários baixados pelo aplicativo." Style="{StaticResource SettingsRowSubtitleStyle}" />
                            </StackPanel>
                            <ui:Button x:Name="ClearCacheButton"
                                       Grid.Column="1"
                                       Content="Limpar cache"
                                       Appearance="Secondary"
                                       VerticalAlignment="Center"
                                       Click="ClearCacheButton_Click"
                                       CornerRadius="{StaticResource ControlCornerRadius}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Broom24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!--  3. Atualizações do app  -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Margin="24,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,24,0">
                                    <TextBlock Text="Atualizações do WinProvision Store" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock x:Name="UpdateSubtitleText"
                                               Text="Procura uma versão mais recente."
                                               Style="{StaticResource SettingsRowSubtitleStyle}" />
                                </StackPanel>
                                <ui:Button x:Name="CheckUpdateButton"
                                           Grid.Column="1"
                                           Content="Verificar atualizações"
                                           Appearance="Secondary"
                                           VerticalAlignment="Center"
                                           Click="CheckUpdateButton_Click"
                                           CornerRadius="{StaticResource ControlCornerRadius}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>

                            <Border x:Name="UpdateAvailablePanel"
                                    Visibility="Collapsed"
                                    Margin="0,16,0,0"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0">
                                        <TextBlock x:Name="UpdateAvailableText"
                                                   FontWeight="Medium"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="UpdateProgressText"
                                                   Style="{StaticResource SettingsRowSubtitleStyle}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                    <ui:Button x:Name="InstallUpdateButton"
                                               Grid.Column="1"
                                               Content="Atualizar agora"
                                               Appearance="Primary"
                                               VerticalAlignment="Center"
                                               Click="InstallUpdateButton_Click"
                                               CornerRadius="{StaticResource ControlCornerRadius}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </Border>

                            <ProgressBar x:Name="UpdateProgressBar"
                                         Style="{StaticResource GradientProgressBarStyle}"
                                         Height="4"
                                         Margin="0,16,0,0"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="0"
                                         Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!--  ================= Rodapé com status e versão =================  -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontFamily="Segoe UI Variable Text" />
                <TextBlock x:Name="VersionText"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontFamily="Segoe UI Variable Text"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Page>
