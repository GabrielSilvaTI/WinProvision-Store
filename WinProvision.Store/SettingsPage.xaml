<Page x:Class="WinProvision.Store.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="SettingsPage">

    <Page.Resources>
        <!-- Mesmo cartão "de vidro" usado na OfficePage — mantém a identidade visual entre as páginas. -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#26FFFFFF" Offset="0" />
                        <GradientStop Color="#0DFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#38FFFFFF" Offset="0" />
                        <GradientStop Color="#14FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF000000" Direction="270" ShadowDepth="3" BlurRadius="20" Opacity="0.30" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ui:SymbolIcon Symbol="Settings24" FontSize="32" Margin="0,0,14,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Configurações" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Backup da sua seleção de pacotes — local sempre, na nuvem se você quiser."
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0" MaxWidth="640" HorizontalAlignment="Left">

                <!-- ================= Exportar perfil completo ================= -->
                <!-- Junta TODAS as guias de pacotes abertas + o provisionamento atual num
                     único .json — o mesmo formato que /auto e /Provision esperam. Diferente
                     de "Sincronizar agora" (que sobe pro backup local/Gist sem gerar
                     arquivo), este botão salva um arquivo pra você levar/distribuir. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Exportar perfil completo" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Gera um único .json com todos os pacotes (todas as guias) e os ajustes de provisionamento atuais — pronto para usar com /auto &lt;caminho ou URL&gt;."
                                           Style="{StaticResource CardSubtitleStyle}" />
                            </StackPanel>

                            <ui:SymbolIcon Grid.Column="1" Symbol="DocumentArrowRight24" FontSize="22" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <ui:Button x:Name="ExportAllButton" Content="Exportar tudo (.json)" Appearance="Secondary"
                                   Style="{StaticResource ActionButtonStyle}" Margin="0,16,0,0"
                                   HorizontalAlignment="Left" Click="ExportAllButton_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowExport24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!-- ================= Backup local ================= -->
                <!-- Sempre ativo, não depende de login: roda sozinho a cada instalar/remover
                     (ver BackupAutoSyncService) e também pelo botão "Sincronizar agora" abaixo. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Backup local" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Todas as suas guias de pacotes, guardadas nesta máquina automaticamente a cada instalação ou remoção — não exige login."
                                           Style="{StaticResource CardSubtitleStyle}" />
                            </StackPanel>

                            <ui:SymbolIcon Grid.Column="1" Symbol="Laptop24" FontSize="22" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <TextBlock x:Name="LocalBackupStatusText" Text="Verificando backup local..."
                                   Margin="0,12,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <ui:Button x:Name="RestoreLocalButton" Content="Restaurar do backup local"
                                   Appearance="Secondary" Style="{StaticResource ActionButtonStyle}"
                                   Click="RestoreLocalButton_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!-- ================= Backup na nuvem (GitHub) ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Backup na nuvem (GitHub)" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Opcional. Conecte uma conta GitHub para também guardar o backup num Gist secreto — assim ele sobrevive mesmo se você formatar ou trocar de máquina."
                                           Style="{StaticResource CardSubtitleStyle}" />
                            </StackPanel>

                            <ui:SymbolIcon Grid.Column="1" Symbol="CloudSync24" FontSize="22" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- Estado: desconectado -->
                        <StackPanel x:Name="ConnectPanel" Margin="0,16,0,0">
                            <TextBlock Text="Personal Access Token do GitHub (com permissão &quot;gist&quot;)"
                                       FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ui:PasswordBox x:Name="TokenPasswordBox" PlaceholderText="ghp_..." Margin="0,0,0,10" />
                            <ui:Button x:Name="ConnectButton" Content="Conectar" Appearance="Primary"
                                       HorizontalAlignment="Left" Click="ConnectButton_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="PlugConnected24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12">
                                Gere o token em github.com → Settings → Developer settings → Personal access tokens,
                                marcando o escopo "gist". O token fica salvo apenas nesta máquina, criptografado.
                            </TextBlock>
                        </StackPanel>

                        <!-- Estado: conectado -->
                        <StackPanel x:Name="ConnectedPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ConnectedStatusText" Text="Conectado" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="SyncNowButton" Content="Sincronizar agora" Appearance="Primary"
                                           Style="{StaticResource ActionButtonStyle}" Click="SyncNowButton_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSync24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="RestoreButton" Content="Restaurar da nuvem" Appearance="Secondary"
                                           Style="{StaticResource ActionButtonStyle}" Click="RestoreButton_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="DisconnectButton" Content="Desconectar" Appearance="Secondary"
                                           Click="DisconnectButton_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="PlugDisconnected24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Margin="4,4,4,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
