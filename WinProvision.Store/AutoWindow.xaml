<ui:FluentWindow x:Class="WinProvision.Store.AutoWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:WinProvision.Store.Controls"
                 xmlns:conv="clr-namespace:WinProvision.Store.Converters"
                 Title="WinProvision Auto"
                 WindowState="Maximized"
                 WindowStartupLocation="CenterScreen"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="pack://application:,,,/Assets/app.ico"
                 FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
                 TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
                 TextOptions.TextRenderingMode="ClearType"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextHintingMode="Auto"
                 RenderOptions.ClearTypeHint="Enabled"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">

    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>
        <Style x:Key="AutoTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F8FAFF" />
        </Style>
        <Style x:Key="AutoCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#3D0B172B" />
            <Setter Property="BorderBrush" Value="#3B557391" />
        </Style>
        <Style TargetType="ui:Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="#020817">
        <Image Source="pack://application:,,,/Assets/Background.png"
               Stretch="UniformToFill"
               Opacity="0.98"
               IsHitTestVisible="False" />
        <Border Background="#2B020817" IsHitTestVisible="False" />

        <!-- Barra de título nativa (minimizar/maximizar/fechar), como no design de
             referência. O espaço já reservado (Margin top=58 no Grid abaixo) existia
             mas ficava vazio sem isso — janela não tinha nenhum controle de captura. -->
        <ui:TitleBar Title=""
                     Height="46"
                     VerticalAlignment="Top"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     CanMaximize="False"
                     Background="Transparent" />

        <!-- Full-screen composition: the proportions intentionally follow the reference
             instead of centering a small dashboard in the middle of the monitor. -->
        <Grid Margin="34,58,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1.13*" />
                </Grid.ColumnDefinitions>

                <!-- Primary workspace -->
                <Border Grid.Column="0"
                        Margin="0,0,16,0"
                        Style="{StaticResource AutoCardStyle}"
                        Background="#4A071225"
                        Padding="45,38,45,34">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="WinProvision "
                                               Style="{StaticResource AutoTitleStyle}"
                                               Foreground="#F8FAFF" />
                                    <TextBlock Text="Auto"
                                               Style="{StaticResource AutoTitleStyle}"
                                               Foreground="#4EA8FF" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock Text="Configurando seu computador. Estamos preparando seu ambiente de trabalho."
                                               FontSize="13.5"
                                               Foreground="#C5CFDE" />
                                    <TextBlock Text="  •  "
                                               FontSize="13.5"
                                               Foreground="#65758D" />
                                    <TextBlock Text="{Binding ProfileName}"
                                               FontSize="13.5"
                                               Foreground="#AEBBD0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding GlobalProgressText}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#F5F7FC" />
                                <TextBlock Text=" concluído"
                                           FontSize="12"
                                           Foreground="#8998AE"
                                           Margin="5,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Global progress -->
                        <Grid Grid.Row="1" Height="8" Margin="0,29,0,29" ClipToBounds="True">
                            <Border Background="#26364F" CornerRadius="4" />
                            <Border Background="#6DBBFF"
                                    CornerRadius="4"
                                    HorizontalAlignment="Stretch"
                                    RenderTransformOrigin="0,0.5"
                                    conv:AnimatedProgress.Percent="{Binding GlobalProgress}">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                            <Border Width="92" CornerRadius="4" Background="#BFE6FF" Opacity="0.18"
                                    HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-92" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="-92" To="760" Duration="0:0:1.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>

                        <!-- Dynamic stage collection. The JSON decides which cards exist. -->
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,2,0">
                            <ItemsControl ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:StageItemControl Margin="0,0,0,10" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right information rail -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="69" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="264" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <Ellipse Width="8" Height="8" Fill="#39C965" Margin="0,0,9,0" />
                        <TextBlock Text="Status: " FontSize="12" Foreground="#AAB8CC" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#F3F6FC" />
                    </StackPanel>

                    <!-- Purpose -->
                    <Border Grid.Row="1"
                            Style="{StaticResource AutoCardStyle}"
                            Background="#6416133A"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Width="52" Height="52"
                                    CornerRadius="14"
                                    Background="#3A2C3B52"
                                    BorderBrush="#3D4C68"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <Image Source="pack://application:,,,/Assets/app_icon_256.png"
                                       Width="30" Height="30"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Margin="0,13,0,0"
                                       Text="Mais que instalação, um ambiente pronto para o que importa."
                                       FontSize="19"
                                       LineHeight="25"
                                       FontWeight="SemiBold"
                                       Foreground="#F5F7FC"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,9,0,0"
                                       Text="ESTABILIDADE  •  DESEMPENHO  •  PRODUTIVIDADE"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="#B8AEE0" />
                        </Grid>
                    </Border>

                    <!-- System information -->
                    <Border Grid.Row="3"
                            Style="{StaticResource AutoCardStyle}"
                            Background="#5E0C182D"
                            Padding="20,17">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Desktop24"
                                               FontSize="19"
                                               Foreground="#53B9FF"
                                               VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Margin="9,0,0,0"
                                           Text="Informações do sistema"
                                           FontSize="14.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F1F5FB"
                                           VerticalAlignment="Center" />
                                <ui:SymbolIcon Grid.Column="2"
                                               Symbol="ChevronRight24"
                                               FontSize="15"
                                               Foreground="#71839B"
                                               VerticalAlignment="Center" />
                            </Grid>

                            <Border Grid.Row="1" Background="#263B56" />

                            <Grid Grid.Row="2" Margin="0,7,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Windows" FontSize="11.5" Foreground="#A3B1C4" />
                                <TextBlock Grid.Column="1" Text="{Binding SysInfo.WindowsVersion}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F2F5FB" TextAlignment="Right" />
                            </Grid>
                            <Border Grid.Row="3" Background="#263B56" />

                            <Grid Grid.Row="4" Margin="0,7,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Arquitetura" FontSize="11.5" Foreground="#A3B1C4" />
                                <TextBlock Grid.Column="1" Text="{Binding SysInfo.Architecture}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F2F5FB" />
                            </Grid>
                            <Border Grid.Row="5" Background="#263B56" />

                            <Grid Grid.Row="6" Margin="0,7,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Processador" FontSize="11.5" Foreground="#A3B1C4" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SysInfo.ProcessorName}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F2F5FB"
                                           TextAlignment="Right"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SysInfo.ProcessorName}" />
                            </Grid>
                            <Border Grid.Row="7" Background="#263B56" />

                            <Grid Grid.Row="8" Margin="0,7,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Memória RAM" FontSize="11.5" Foreground="#A3B1C4" />
                                <TextBlock Grid.Column="1" Text="{Binding SysInfo.RamSize}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F2F5FB" />
                            </Grid>
                            <Border Grid.Row="9" Background="#263B56" />

                            <Grid Grid.Row="10" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Disco" FontSize="11.5" Foreground="#A3B1C4" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SysInfo.DiskSpace}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F2F5FB"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SysInfo.DiskSpace}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Philosophy -->
                    <Border Grid.Row="5"
                            Style="{StaticResource AutoCardStyle}"
                            Background="#57101A2D"
                            Padding="20,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="#54C6FF" />
                                <TextBlock Text="Nosso propósito"
                                           Margin="10,0,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#F1F5FB"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Margin="0,17,0,0"
                                       Text="Entregar um Windows pronto, leve e confiável, para você focar no que realmente importa."
                                       FontSize="12.5"
                                       LineHeight="18"
                                       Foreground="#C2CCDB"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,11,0,0"
                                       Text="Sempre em frente."
                                       FontSize="12.5"
                                       FontStyle="Italic"
                                       Foreground="#F0F4FA" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="— WinProvision"
                                       FontSize="10.5"
                                       Foreground="#8293AA" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    Style="{StaticResource AutoCardStyle}"
                    Background="#4A071225"
                    Padding="44,0,20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="143" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20"
                                CornerRadius="10"
                                BorderBrush="#8495AD"
                                BorderThickness="1">
                            <Viewbox Width="11" Height="11"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Info24" Foreground="#C2CCDB" />
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{Binding FooterMessage}"
                                   FontSize="11.5"
                                   Foreground="#AEBACB"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="{Binding CloseButtonText}"
                               Appearance="Secondary"
                               Background="#33475F"
                               Foreground="#F1F5FB"
                               BorderBrush="#4A607A"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               Height="44"
                               Padding="18,0"
                               Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
