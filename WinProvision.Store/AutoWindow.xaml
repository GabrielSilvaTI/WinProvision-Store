<ui:FluentWindow x:Class="WinProvision.Store.AutoWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:WinProvision.Store.Controls"
                 xmlns:conv="clr-namespace:WinProvision.Store.Converters"
                 Title="WinProvision Orchestrator"
                 WindowState="Maximized"
                 WindowStartupLocation="CenterScreen"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="pack://application:,,,/Assets/app.ico"
                 FontFamily="{StaticResource StoreFontFamily}"
                 TextElement.FontFamily="{StaticResource StoreFontFamily}"
                 TextOptions.TextRenderingMode="ClearType"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextHintingMode="Auto"
                 RenderOptions.ClearTypeHint="Enabled"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">

    <ui:FluentWindow.Resources>
        <LinearGradientBrush x:Key="OrchestratorTitleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFE082" Offset="0" />
            <GradientStop Color="#FFFFB74D" Offset="0.55" />
            <GradientStop Color="#FFFF8A3D" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource StoreFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>
        <Style x:Key="OrchestratorTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource StorePageTitleStyle}">
            <Setter Property="FontFamily" Value="{StaticResource StoreDisplayFontFamily}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="Transparent">

        <!--
            Barra de título nativa (minimizar/maximizar/fechar), como no design de
            referência. O espaço já reservado (Margin top=58 no Grid abaixo) existia
            mas ficava vazio sem isso — janela não tinha nenhum controle de captura.
        -->
        <ui:TitleBar Title=""
                     Height="46"
                     VerticalAlignment="Top"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     CanMaximize="False"
                     Background="Transparent" />

        <!--
            Full-screen composition: the proportions intentionally follow the reference
            instead of centering a small dashboard in the middle of the monitor.
        -->
        <Grid Margin="24,58,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!--  Primary workspace  -->
                <Border Grid.Column="0"
                        Style="{StaticResource StoreCardSurfaceStyle}"
                        Margin="0,0,16,0"
                        Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0" Style="{StaticResource PageHeaderIconTileStyle}">
                                <Image Source="pack://application:,,,/Assets/app_icon_256.png"
                                       Width="26" Height="26" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="WinProvision " Style="{StaticResource OrchestratorTitleStyle}" />
                                    <TextBlock Text="Orchestrator" Style="{StaticResource OrchestratorTitleStyle}"
                                               Foreground="{StaticResource OrchestratorTitleBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProfileName}"
                                           Style="{StaticResource StoreSubtitleStyle}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GlobalProgressText}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text=" concluído"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="5,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!--  Global progress  -->
                        <Grid x:Name="GlobalProgressTrack"
                              Grid.Row="1"
                              Height="8"
                              Margin="0,20,0,20"
                              ClipToBounds="True">
                            <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="{StaticResource CompactCornerRadius}" />
                            <Border Background="{DynamicResource InstallActionBrush}"
                                    CornerRadius="{StaticResource CompactCornerRadius}"
                                    HorizontalAlignment="Stretch"
                                    RenderTransformOrigin="0,0.5"
                                    conv:AnimatedProgress.Percent="{Binding GlobalProgress}">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="GlobalProgressShimmer"
                                    Width="92"
                                    CornerRadius="{StaticResource CompactCornerRadius}"
                                    Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                    Opacity="0.18"
                                    HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="GlobalProgressShimmerTransform" X="-92" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <!--  Dynamic stage collection. The JSON decides which cards exist.  -->
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,2,0">
                            <ItemsControl ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:StageItemControl Margin="0,0,0,10" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--  Right information rail  -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24"
                                       FontSize="16"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       Margin="0,0,8,0" />
                        <TextBlock Text="Estado: "
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <!--  Purpose  -->
                    <Border Grid.Row="2"
                            Style="{StaticResource StoreCardSurfaceStyle}"
                            Margin="0"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <Image Source="pack://application:,,,/Assets/app_icon_256.png"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Margin="0,13,0,0"
                                       Text="Seu computador, pronto para usar."
                                       FontSize="16"
                                       LineHeight="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,9,0,0"
                                       Text="WinProvision Store"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <!--  System information  -->
                    <Border Grid.Row="4"
                            Style="{StaticResource StoreCardSurfaceStyle}"
                            Margin="0"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40"
                                        Style="{StaticResource PageHeaderIconTileStyle}"
                                        Margin="0">
                                    <ui:SymbolIcon Symbol="Desktop24"
                                                   Style="{StaticResource PageHeaderSymbolIconStyle}"
                                                   FontSize="19" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="9,0,0,0"
                                           Text="Informações do sistema"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <Grid Grid.Row="2" Margin="0,7,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Windows"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SysInfo.WindowsVersion}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextAlignment="Right" />
                            </Grid>
                            <Border Grid.Row="3" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <Grid Grid.Row="4" Margin="0,7,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Arquitetura"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SysInfo.Architecture}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                            <Border Grid.Row="5" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <Grid Grid.Row="6" Margin="0,7,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Processador"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SysInfo.ProcessorName}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextAlignment="Right"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SysInfo.ProcessorName}" />
                            </Grid>
                            <Border Grid.Row="7" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <Grid Grid.Row="8" Margin="0,7,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Memória RAM"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SysInfo.RamSize}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                            <Border Grid.Row="9" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <Grid Grid.Row="10" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Disco"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SysInfo.DiskSpace}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SysInfo.DiskSpace}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Philosophy  -->
                    <Border x:Name="PurposePanel"
                            Grid.Row="6"
                            Style="{StaticResource StoreCardSurfaceStyle}"
                            Margin="0"
                            Padding="20,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24"
                                               FontSize="18"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Nosso propósito"
                                           Margin="10,0,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Margin="0,17,0,0"
                                       Text="Preparamos o Windows para você começar a usar."
                                       FontSize="12.5"
                                       LineHeight="18"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,11,0,0"
                                       Text="WinProvision Store"
                                       FontSize="12.5"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="— WinProvision"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="CloudTrackingPanel"
                            Grid.Row="6"
                            Style="{StaticResource StoreCardSurfaceStyle}"
                            Margin="0"
                            Padding="16"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="40" Height="40"
                                        Style="{StaticResource PageHeaderIconTileStyle}"
                                        Margin="0">
                                    <ui:SymbolIcon Symbol="Cloud24"
                                                   Style="{StaticResource PageHeaderSymbolIconStyle}"
                                                   FontSize="19" />
                                </Border>
                                <TextBlock Text="Acompanhe esta execução"
                                           Margin="12,0,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="140"
                                        Height="140"
                                        Padding="3"
                                        Background="White"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        ToolTip="QR Code para acompanhar os logs desta execução">
                                    <Image x:Name="CloudTrackingQrImage"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.EdgeMode="Aliased" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Leia o código com a câmera para acompanhar os logs."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="LINK DA EXECUÇÃO"
                                               Margin="0,12,0,5"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:TextBox x:Name="CloudTrackingUrlTextBox"
                                                Height="34"
                                                Padding="9,4"
                                                FontSize="10.5"
                                                IsReadOnly="True"
                                                TextWrapping="NoWrap"
                                                MaxLines="1"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTip="Link completo dos logs desta execução"
                                                Cursor="IBeam" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <ui:Button Content="Abrir logs"
                                                   Style="{StaticResource StoreActionButtonStyle}"
                                                   Appearance="Primary"
                                                   Click="OpenCloudTrackingUrl_Click"
                                                   Margin="0,0,8,0" />
                                        <ui:Button Content="Copiar link"
                                                   Style="{StaticResource StoreActionButtonStyle}"
                                                   Click="CopyCloudTrackingUrl_Click"
                                                   ToolTip="Copiar o link completo para a área de transferência" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!--  Footer  -->
            <Border Grid.Row="1"
                    Style="{StaticResource PageStatusBarStyle}"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FooterMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="{Binding CloseButtonText}"
                               Style="{StaticResource StoreActionButtonStyle}"
                               Appearance="Secondary"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               MinWidth="112"
                               Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
