<Page x:Class="WinProvision.Store.UpdatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="UpdatesPage"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="PageTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentPageTitleStyle}" />

        <Style x:Key="CardTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCardTitleStyle}" />

        <Style x:Key="CardStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.2"
                                      BlurRadius="24"
                                      ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Cartão de atualização: a seleção usa o mesmo contorno verde de Pacotes/Office.  -->
        <DataTemplate x:Key="UpgradableCardTemplate">
            <Border Width="214"
                    Height="248"
                    Margin="0,0,16,16"
                    Padding="14"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Cursor="Hand"
                    MouseLeftButtonUp="UpdateItemCard_Click"
                    Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelectedForUpdate}" Value="True">
                                <Setter Property="BorderBrush" Value="#4CAF6B" />
                                <Setter Property="Background" Value="#154CAF6B" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelectedForUpdate}" Value="True" />
                                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#254CAF6B" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:SymbolIcon Grid.Row="0"
                                   Symbol="CheckmarkCircle24"
                                   FontSize="20"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedForUpdate}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF6B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                Margin="0,4,0,12">
                        <Border Width="56"
                                Height="56"
                                Margin="0,0,0,10"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                ClipToBounds="True"
                                HorizontalAlignment="Center">
                            <Grid>
                                <ui:SymbolIcon Symbol="Box24"
                                               FontSize="32"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=UpdateCardImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <Image x:Name="UpdateCardImage"
                                       conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                       Stretch="Uniform"
                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=UpdateCardImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <WrapPanel HorizontalAlignment="Center" Margin="0,5,0,4">
                            <Border Background="{DynamicResource AppBorderSubtleBrush}"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Margin="2">
                                <TextBlock Text="{Binding SourceLabel}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Background="{DynamicResource AppOperationSuccessSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Margin="2">
                                <TextBlock Text="{Binding AvailableVersion, StringFormat={}Nova: {0}}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </WrapPanel>
                        <TextBlock FontSize="11"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding CurrentVersion}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="  →  " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding AvailableVersion}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </TextBlock>
                    </StackPanel>

                    <ui:Button Grid.Row="2"
                               Content="Atualizar agora"
                               Appearance="Secondary"
                               Padding="12,6"
                               HorizontalAlignment="Center"
                               IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBooleanConverter}}"
                               Click="SingleUpdateButton_Click">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                        <Setter Property="Content" Value="Atualizando..." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Lista compacta: mesma seleção dos cartões, com maior densidade de informação.  -->
        <DataTemplate x:Key="UpgradableListTemplate">
            <Border Padding="12,10"
                    Margin="0,0,0,6"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Cursor="Hand"
                    MouseLeftButtonUp="UpdateItemCard_Click"
                    Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelectedForUpdate}" Value="True">
                                <Setter Property="BorderBrush" Value="#4CAF6B" />
                                <Setter Property="Background" Value="#154CAF6B" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelectedForUpdate}" Value="True" />
                                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#254CAF6B" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid MinHeight="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="CheckmarkCircle24"
                                   FontSize="20"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedForUpdate}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF6B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <Border Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Grid>
                            <ui:SymbolIcon Symbol="Box24"
                                           FontSize="22"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=UpdateListImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Image x:Name="UpdateListImage"
                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                   Stretch="Uniform"
                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=UpdateListImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Id}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="0,0,12,0">
                        <Border Background="{DynamicResource AppBorderSubtleBrush}"
                                CornerRadius="10"
                                Padding="8,2"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,4">
                            <TextBlock Text="{Binding SourceLabel}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock FontSize="11"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding CurrentVersion}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="  →  " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding AvailableVersion}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </TextBlock>
                    </StackPanel>

                    <ui:Button Grid.Column="4"
                               Content="Atualizar agora"
                               Appearance="Primary"
                               Padding="12,6"
                               Margin="0,0,6,0"
                               Height="36"
                               VerticalAlignment="Center"
                               IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBooleanConverter}}"
                               Click="SingleUpdateButton_Click">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                        <Setter Property="Content" Value="Atualizando..." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Grid.Column="5"
                               Content="Detalhes"
                               Appearance="Secondary"
                               Padding="10,6"
                               Margin="0,0,4,0"
                               Height="36"
                               VerticalAlignment="Center"
                               ToolTip="Ver detalhes do aplicativo e da atualização"
                               Click="DetailsMenuItem_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Info24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Grid.Column="6"
                               Appearance="Transparent"
                               Padding="8,6"
                               Height="36"
                               VerticalAlignment="Center"
                               ToolTip="Ignorar esta versão"
                               Click="IgnoreVersionMenuItem_Click">
                        <ui:SymbolIcon Symbol="Dismiss24"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PageContentMargin}"
          MaxWidth="1600"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Style="{StaticResource FluentPageIconStyle}" Text="&#xE895;" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Atualizações" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Veja e instale atualizações."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontFamily="Segoe UI Variable Text"
                           Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource PageColumnGap}" />
                <ColumnDefinition Width="{StaticResource PageSidebarWidth}" />
            </Grid.ColumnDefinitions>

            <!--  ================= COLUNA ESQUERDA =================  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="EmptyStatePanel"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Style="{StaticResource CardStyle}"
                        VerticalAlignment="Center"
                        Margin="0"
                        Padding="0,32"
                        Visibility="{Binding Items.Count, ElementName=UpdatesList, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64"
                                Height="64"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                Background="#1A107C10"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="ShieldTask24"
                                           FontSize="32"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <TextBlock Text="Tudo atualizado"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="EmptyStateText"
                                   Text="Nenhuma atualização disponível."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource CardStyle}"
                        Padding="20,20,20,0"
                        Visibility="{Binding Items.Count, ElementName=UpdatesList, Converter={StaticResource CountToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Atualizações disponíveis"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Border Background="#1AFFFFFF"
                                        CornerRadius="{StaticResource OverlayCornerRadius}"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Items.Count, ElementName=UpdatesList}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ToggleButton x:Name="GridViewToggleButton"
                                              IsChecked="True"
                                              Padding="8,4"
                                              Margin="0,0,4,0"
                                              Click="GridViewToggleButton_Click"
                                              ToolTip="Visualização em cartões">
                                    <ui:SymbolIcon Symbol="Grid24" FontSize="18" />
                                </ToggleButton>
                                <ToggleButton x:Name="ListViewToggleButton"
                                              Padding="8,4"
                                              Click="ListViewToggleButton_Click"
                                              ToolTip="Visualização em lista">
                                    <ui:SymbolIcon Symbol="List24" FontSize="18" />
                                </ToggleButton>
                            </StackPanel>

                            <ui:Button x:Name="SelectAllButton"
                                       Grid.Column="2"
                                       Style="{StaticResource SelectAllButtonStyle}"
                                       HorizontalAlignment="Right"
                                       Click="SelectAllCheckBox_Click"
                                       ToolTip="Selecionar ou limpar todas">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon x:Name="SelectAllIcon"
                                                   Symbol="CheckmarkCircle24"
                                                   FontSize="16"
                                                   Margin="0,0,6,0" />
                                    <TextBlock x:Name="SelectAllText"
                                               Text="Selecionar todos"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <Rectangle Grid.Row="0"
                                   Height="1"
                                   Fill="#0DFFFFFF"
                                   VerticalAlignment="Bottom" />

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="GridViewScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                                <ItemsControl x:Name="UpdatesList"
                                              ItemTemplate="{StaticResource UpgradableCardTemplate}"
                                              Background="Transparent">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       SnapsToDevicePixels="True"
                                                       UseLayoutRounding="True" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer x:Name="ListViewScrollViewer"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                                <ItemsControl x:Name="UpdatesListView"
                                              ItemTemplate="{StaticResource UpgradableListTemplate}"
                                              Background="Transparent" />
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,12">
                            <TextBlock Text="{Binding Text, ElementName=StatusText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--  ================= COLUNA DIREITA =================  -->
            <StackPanel Grid.Column="2">

                <Border Style="{StaticResource CardStyle}"
                        Padding="{StaticResource Spacing24}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Status das Atualizações"
                                           Style="{StaticResource CardTitleStyle}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Última busca: Ainda não realizada"
                                           x:Name="LastSearchText"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ArrowClockwise24"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <TextBlock Text="{Binding Items.Count, ElementName=UpdatesList}"
                                   FontSize="48"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Atualizações disponíveis"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,24" />

                        <Rectangle Height="1"
                                   Fill="#0DFFFFFF"
                                   Margin="0,0,0,24" />

                        <TextBlock x:Name="StatusText"
                                   Text="Aguardando verificação..."
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,16"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />

                        <Border Background="#1AFFC107"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="12,8"
                                HorizontalAlignment="Center"
                                Visibility="{Binding Items.Count, ElementName=UpdatesList, Converter={StaticResource CountToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24"
                                               FontSize="16"
                                               Foreground="#FFC107"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Atualizações pendentes"
                                           Foreground="#FFC107"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  2. Cartão Ações Rápidas  -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="{StaticResource Spacing24}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="Ações Rápidas"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0,0,0,16" />

                        <ui:Button x:Name="UpdateSelectedButton"
                                   Background="{StaticResource InstallActionBrush}"
                                   MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                                   PressedBackground="{StaticResource InstallActionPressedBrush}"
                                   Foreground="White"
                                   PressedForeground="White"
                                   Height="44"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Margin="0,0,0,12"
                                   CornerRadius="{StaticResource ControlCornerRadius}"
                                   Click="UpdateSelectedButton_Click">
                            <Grid Width="220" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Grid.Column="0"
                                             Glyph="&#xE896;"
                                             FontFamily="Segoe Fluent Icons"
                                             FontSize="16"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="Atualizar Selecionados"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </ui:Button>

                        <UniformGrid Columns="1" Margin="-3,0,-3,0">
                            <!--  Botão Toggle de Atualizações Automáticas  -->
                            <ToggleButton x:Name="AutoUpdateToggle"
                                          Height="40"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center"
                                          Margin="3"
                                          Padding="8,4"
                                          ToolTip="Verifica atualizações ao iniciar o computador."
                                          Checked="AutoUpdateToggle_Checked"
                                          Unchecked="AutoUpdateToggle_Unchecked">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="ToggleRoot"
                                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Padding="8,4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ToggleRoot" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ToggleRoot" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="ToggleRoot" Property="Background" Value="#154CAF6B" />
                                                            <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="#4CAF6B" />
                                                            <Setter Property="Foreground" Value="#4CAF6B" />
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsChecked" Value="True" />
                                                                <Condition Property="IsMouseOver" Value="True" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="ToggleRoot" Property="Background" Value="#254CAF6B" />
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Grid.Column="0"
                                                 Glyph="&#xECC5;"
                                                 FontFamily="Segoe Fluent Icons"
                                                 FontSize="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="Atualizações Automáticas"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>

                            <ui:Button x:Name="CheckUpdatesButton"
                                       Appearance="Secondary"
                                       Height="40"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center"
                                       Margin="3"
                                       Click="CheckUpdatesButton_Click">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Grid.Column="0"
                                                 Glyph="&#xE72C;"
                                                 FontFamily="Segoe Fluent Icons"
                                                 FontSize="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="Verificar Atualizações"
                                               FontSize="12"
                                               TextWrapping="NoWrap"
                                               TextTrimming="None"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>
                        </UniformGrid>

                        <ProgressBar x:Name="BusyIndicator"
                                     Height="4"
                                     Margin="0,16,0,0"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
