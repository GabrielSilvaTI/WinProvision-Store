<Page x:Class="WinProvision.Store.UpdatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="UpdatesPage"
      Background="Transparent"
    TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
    TextElement.FontSize="14"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Auto"
    RenderOptions.ClearTypeHint="Enabled"
    UseLayoutRounding="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Template dos Itens da Lista -->
        <DataTemplate x:Key="UpgradableItemTemplate">
            <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                              IsChecked="{Binding IsSelectedForUpdate, Mode=TwoWay}"
                              IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBooleanConverter}}"
                              Checked="ItemCheckBox_Changed" Unchecked="ItemCheckBox_Changed" />

                    <!-- Ícone do App com Fallback Box24 via AsyncImage.HasContent -->
                    <Border Grid.Column="1" Width="32" Height="32" Margin="0,0,16,0" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <ui:SymbolIcon Symbol="Box24" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=AppImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            <Image x:Name="AppImage" conv:AsyncImage.SourceUrl="{Binding IconUrl}" Stretch="Uniform"
                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=AppImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" FontFamily="Segoe UI Variable Text">
                        <Run Text="{Binding CurrentVersion, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="  →  " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding AvailableVersion, Mode=OneWay}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    </TextBlock>

                    <ui:Button Grid.Column="4" Content="Atualizar agora" Appearance="Secondary" 
                               Padding="16,6" Margin="16,0,8,0" VerticalAlignment="Center"
                               IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBooleanConverter}}"
                               Click="SingleUpdateButton_Click">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                        <Setter Property="Content" Value="Atualizando..." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Grid.Column="5" Appearance="Transparent" Padding="8,6" VerticalAlignment="Center">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Detalhes" Click="DetailsMenuItem_Click" />
                                <MenuItem Header="Ignorar esta versão" Click="IgnoreVersionMenuItem_Click" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                        <ui:SymbolIcon Symbol="MoreVertical24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Atualizações" Style="{StaticResource PageTitleStyle}" />
                <TextBlock                                 Text="Atualize seus aplicativos."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontFamily="Segoe UI Variable Text" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- ================= COLUNA ESQUERDA ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="EmptyStatePanel" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource CardStyle}" VerticalAlignment="Center" Margin="0,40,0,0" Padding="0,48"
                        Visibility="{Binding Items.Count, ElementName=UpdatesList, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1A107C10" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="ShieldTask24" FontSize="32" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <TextBlock Text="Tudo atualizado" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock x:Name="EmptyStateText"                         Text="Nenhuma atualização disponível." 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Visibility="{Binding Items.Count, ElementName=UpdatesList, Converter={StaticResource CountToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="20,16,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Atualizações disponíveis" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border Background="#1AFFFFFF" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Items.Count, ElementName=UpdatesList}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <ui:Button x:Name="SelectAllButton"
                                       Grid.Column="1"
                                       Style="{StaticResource SelectAllButtonStyle}"
                                       HorizontalAlignment="Right"
                                       Click="SelectAllCheckBox_Click"
                                       ToolTip="Selecionar ou desmarcar todas as atualizações">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="SelectAllIcon" Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock x:Name="SelectAllText" Text="Selecionar todos" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <Rectangle Grid.Row="0" Height="1" Fill="#0DFFFFFF" VerticalAlignment="Bottom" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False" behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                            <ItemsControl x:Name="UpdatesList" ItemTemplate="{StaticResource UpgradableItemTemplate}" Background="Transparent" />
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,12">
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12">
                                <Run Text="{Binding Items.Count, ElementName=UpdatesList, Mode=OneWay}" />
                                <Run Text=" atualização(ões) disponível(is)" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= COLUNA DIREITA ================= -->
            <StackPanel Grid.Column="2">

                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Status das Atualizações" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4" />
                                <TextBlock Text="Última busca: Ainda não realizada" x:Name="LastSearchText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <TextBlock Text="{Binding Items.Count, ElementName=UpdatesList}" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Atualizações disponíveis" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />

                        <Rectangle Height="1" Fill="#0DFFFFFF" Margin="0,0,0,24" />

                        <TextBlock x:Name="StatusText" Text="Aguardando verificação..." HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" TextAlignment="Center" />

                        <Border Background="#1AFFC107" CornerRadius="6" Padding="12,8" HorizontalAlignment="Center" 
                                Visibility="{Binding Items.Count, ElementName=UpdatesList, Converter={StaticResource CountToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#FFC107" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Atualizações pendentes" Foreground="#FFC107" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Cartão Ações Rápidas -->
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Ações Rápidas" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,16" />

                        <!-- Botão Toggle de Atualizações Automáticas -->
                        <ToggleButton x:Name="AutoUpdateToggle" 
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,12"
                                      Padding="12,6" ToolTip="Verifica e atualiza os aplicativos em segundo plano ao ligar o computador."
                                      Checked="AutoUpdateToggle_Checked" Unchecked="AutoUpdateToggle_Unchecked">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ToggleRoot"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="12,6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ToggleRoot" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ToggleRoot" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ToggleRoot" Property="Background" Value="#154CAF6B" />
                                                        <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="#4CAF6B" />
                                                        <Setter Property="Foreground" Value="#4CAF6B" />
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsChecked" Value="True" />
                                                            <Condition Property="IsMouseOver" Value="True" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="ToggleRoot" Property="Background" Value="#254CAF6B" />
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,8,0" />
                                <TextBlock Text="Atualizações Automáticas" />
                            </StackPanel>
                        </ToggleButton>

                        <ui:Button x:Name="UpdateSelectedButton" Content="Atualizar Selecionados" 
                                   Background="{DynamicResource SystemAccentColorPrimaryBrush}" 
                                   Foreground="White" BorderBrush="Transparent"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,12"
                                   Click="UpdateSelectedButton_Click" IsEnabled="False">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button x:Name="CheckUpdatesButton" Content="Verificar Atualizações" Appearance="Secondary" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Click="CheckUpdatesButton_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ProgressBar x:Name="BusyIndicator" Height="4" Margin="0,16,0,0" 
                                     IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>