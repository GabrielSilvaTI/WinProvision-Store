<Page x:Class="WinProvision.Store.ProvisioningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      ScrollViewer.CanContentScroll="False"
      Title="ProvisioningPage"
      Background="Transparent"
    TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
    TextElement.FontSize="14"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Auto"
    RenderOptions.ClearTypeHint="Enabled"
    UseLayoutRounding="True">

    <Page.Resources>
        <!-- Tipografia Fluent (Segoe UI Variable) -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Cartão Clássico (Para a Sidebar de Resumo) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
        </Style>

        <!-- NOVO: Cartão de Configurações (Estilo Lista do Win11, sem Padding interno para as linhas tocarem a borda) -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
        </Style>

        <!-- Estilo de Item do Menu de Contexto do Windows 11 -->
        <Style x:Key="Win11MenuItemStyle" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilos para as Linhas de Configuração -->
        <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        </Style>

        <Style x:Key="SettingsRowSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Menu Principal (Cards Largos) -->
        <Style x:Key="MenuCardButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MouseOverBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="PressedBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>

        <!-- Estilos para os Textos de Estatística (Resumo) -->
        <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Item da lista de alterações -->
        <Style x:Key="ChangeItemStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Margin="32,24" MaxWidth="1600" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Cabeçalho Global ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Desktop24" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Provisionamento" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Configure a máquina ou exporte um perfil."
                               Style="{StaticResource CardSubtitleStyle}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="ImportButton" Content="Importar" Appearance="Secondary" Margin="0,0,8,0" Click="ImportButton_Click" CornerRadius="6" Height="36">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowImport24" FontSize="16" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button x:Name="ExportButton" Content="Exportar" Appearance="Secondary" Margin="0,0,12,0" Click="ExportButton_Click" CornerRadius="6" Height="36">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="16" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button x:Name="ApplyButton" Content="Aplicar agora" Appearance="Primary" Click="ApplyButton_Click" CornerRadius="6" Height="36" Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="PlayCircle24" FontSize="16" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- ================= Corpo (Drill-down + Sidebar) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="420" />
                <ColumnDefinition Width="32" />
                <!-- Espaço -->
                <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ESQUERDA: Menu Principal OU Formulários de Seção -->
            <Grid Grid.Column="0">

                <!-- Visão 1: Menu de Seções -->
                <ScrollViewer x:Name="ProfileOverviewPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                    <StackPanel Margin="0,0,8,0">
                        <ui:Button x:Name="PersonalizationNavCard" Style="{StaticResource MenuCardButtonStyle}" Click="PersonalizationNavCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="PaintBrush24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Personalização" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="Tema, barra de tarefas e papel de parede." Style="{StaticResource CardSubtitleStyle}" FontSize="13" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Button>

                        <ui:Button x:Name="UpdatesNavCard" Style="{StaticResource MenuCardButtonStyle}" Click="UpdatesNavCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSync24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Atualizações" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="Defina como o sistema deve buscar e instalar atualizações." Style="{StaticResource CardSubtitleStyle}" FontSize="13" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Button>

                        <ui:Button x:Name="AdvancedNavCard" Style="{StaticResource MenuCardButtonStyle}" Click="AdvancedNavCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Settings24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Configurações Avançadas" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="Nome da máquina, região, energia e ponto de restauração." Style="{StaticResource CardSubtitleStyle}" FontSize="13" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Button>

                        <ui:Button x:Name="JsonNavCard" Style="{StaticResource MenuCardButtonStyle}" Click="JsonNavCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Code24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Visualização do JSON" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="Dados de identificação e o código JSON completo gerado." Style="{StaticResource CardSubtitleStyle}" FontSize="13" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Button>

                        <ui:Button x:Name="CliNavCard" Style="{StaticResource MenuCardButtonStyle}" Click="CliNavCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="WindowConsole20" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Gerador de Comando CLI Nativo" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="Monte o comando de terminal para aplicar um perfil remoto." Style="{StaticResource CardSubtitleStyle}" FontSize="13" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Visão 2: Formulários das Seções -->
                <Grid x:Name="SectionPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho de Retorno Breadcrumb -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                        <ui:Button Appearance="Transparent" Padding="8,6" CornerRadius="6" Click="BackToProfileButton_Click">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" />
                        </ui:Button>
                        <TextBlock x:Name="SectionTitleText" Style="{StaticResource PageTitleStyle}" FontSize="20" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                        <StackPanel Margin="0,0,12,0">

                            <!-- ================= 1. Personalização ================= -->
                            <StackPanel x:Name="PersonalizationSectionPanel" Visibility="Collapsed">

                                <!-- Bloco 1: Tema e Barra de Tarefas -->
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>

                                        <!-- Tema -->
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Tema do sistema" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Escolha o tema visual do sistema." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" SelectionChanged="Field_Changed">
                                                <ComboBoxItem Content="Não alterar" Tag="NaoDefinido" IsSelected="True" />
                                                <ComboBoxItem Content="Claro" Tag="Claro" />
                                                <ComboBoxItem Content="Escuro" Tag="Escuro" />
                                            </ComboBox>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                                        <!-- Alinhamento Barra de Tarefas -->
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Alinhamento da barra de tarefas" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Apenas Windows 11." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                            <ComboBox x:Name="TaskbarAlignmentComboBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" SelectionChanged="Field_Changed">
                                                <ComboBoxItem Content="Não alterar" Tag="NaoDefinido" IsSelected="True" />
                                                <ComboBoxItem Content="Esquerda" Tag="Esquerda" />
                                                <ComboBoxItem Content="Centro" Tag="Centro" />
                                            </ComboBox>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                                        <!-- Caixa de Pesquisa -->
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Caixa de pesquisa" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Apenas Windows 11." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                            <ComboBox x:Name="TaskbarSearchBoxComboBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" SelectionChanged="Field_Changed">
                                                <ComboBoxItem Content="Não alterar" Tag="NaoDefinido" IsSelected="True" />
                                                <ComboBoxItem Content="Oculta" Tag="Oculta" />
                                                <ComboBoxItem Content="Apenas ícone" Tag="ApenasIcone" />
                                                <ComboBoxItem Content="Caixa completa" Tag="CaixaCompleta" />
                                            </ComboBox>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                                        <!-- Auto Hide -->
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="Ocultar a barra de tarefas automaticamente" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Faz a barra recolher quando não está em uso." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                            <CheckBox x:Name="TaskbarAutoHideCheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="Field_Changed" Unchecked="Field_Changed" />
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- Bloco 2: Wallpaper -->
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <!-- Título da Seção do Cartão -->
                                        <Grid Margin="24,16">
                                            <StackPanel>
                                                <TextBlock Text="Papel de Parede" Style="{StaticResource SettingsRowTitleStyle}" />
                                                <TextBlock Text="Escolha uma imagem para o plano de fundo da área de trabalho." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#0DFFFFFF" />

                                        <!-- Linha de Ação do Wallpaper -->
                                        <Grid Margin="24,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail -->
                                            <Border Grid.Column="0" Width="100" Height="64" CornerRadius="6" ClipToBounds="True" Background="#1AFFFFFF" Margin="0,0,16,0">
                                                <Image x:Name="WallpaperPreviewImage" Stretch="UniformToFill" />
                                            </Border>

                                            <!-- Textos -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Imagem" FontWeight="Medium" FontFamily="Segoe UI Variable Text" />
                                                <TextBlock x:Name="WallpaperFileNameText" Text="Nenhuma imagem selecionada." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Botões -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button x:Name="ClearWallpaperButton" Content="Restaurar padrão" Appearance="Secondary" VerticalAlignment="Center" Click="ClearWallpaperButton_Click" CornerRadius="6" Margin="0,0,8,0" Visibility="Collapsed" />
                                                <ui:Button x:Name="SelectWallpaperButton" Content="Alterar imagem" Appearance="Secondary" VerticalAlignment="Center" Click="SelectWallpaperButton_Click" CornerRadius="6" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ================= CARD SANDBOX / VM: SIMULAÇÃO DA ÁREA DE TRABALHO (16:9 COMPLETO) ================= -->
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,24" Background="#0CFFFFFF" ClipToBounds="True">
                                    <Grid>
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="Auto" />
                                         </Grid.RowDefinitions>

                                         <!-- Barra de Título da Janela Sandbox / VM -->
                                         <Border Grid.Row="0" Background="#14000000" Padding="16,10">
                                             <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="Auto" />
                                                     <ColumnDefinition Width="*" />
                                                     <ColumnDefinition Width="Auto" />
                                                 </Grid.ColumnDefinitions>

                                                 <!-- Status do Ambiente Virtual -->
                                                 <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                     <Border Width="8" Height="8" CornerRadius="4" Background="#4CAF50" Margin="0,0,10,0" VerticalAlignment="Center">
                                                         <Border.Effect>
                                                             <DropShadowEffect Color="#4CAF50" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                                                         </Border.Effect>
                                                     </Border>
                                                     <TextBlock Text="Ambiente Virtual • Simulação da Área de Trabalho" FontSize="12" FontWeight="SemiBold"
                                                                FontFamily="Segoe UI Variable Display, Aptos Display, Segoe UI" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                     <Border Margin="12,0,0,0" Background="#16FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                         <TextBlock x:Name="DesktopPreviewThemeTag" Text="Windows 11 (16:9 Widescreen)" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                     </Border>
                                                 </StackPanel>

                                                 <!-- Controles Decorativos da VM (Minimizar, Maximizar, Fechar) -->
                                                 <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                     <Border Width="10" Height="10" CornerRadius="5" Background="#26FFFFFF" Margin="0,0,6,0" />
                                                     <Border Width="10" Height="10" CornerRadius="5" Background="#26FFFFFF" Margin="0,0,6,0" />
                                                     <Border Width="10" Height="10" CornerRadius="5" Background="#26FFFFFF" />
                                                 </StackPanel>
                                             </Grid>
                                         </Border>

                                         <Rectangle Grid.Row="0" Height="1" Fill="#14FFFFFF" VerticalAlignment="Bottom" />

                                         <!-- BANDEJA DE APLICATIVOS (Pacotes Selecionados para Arrastar) -->
                                         <Border Grid.Row="1" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="16,12">
                                             <Grid>
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                 </Grid.RowDefinitions>

                                                 <!-- Cabeçalho da Bandeja de Apps -->
                                                 <Grid Grid.Row="0" Margin="0,0,0,10">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*" />
                                                         <ColumnDefinition Width="Auto" />
                                                     </Grid.ColumnDefinitions>

                                                     <StackPanel Grid.Column="0">
                                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                             <ui:SymbolIcon Symbol="Apps24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                                             <TextBlock Text="Aplicativos de Pacotes • Arraste para a Área de Trabalho" FontSize="13" FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                             <Border Background="#200078D4" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                 <TextBlock x:Name="AvailablePackagesCountText" Text="0 aplicativo(s)" FontSize="11" Foreground="#60A5FA" FontWeight="Medium" />
                                                             </Border>
                                                         </StackPanel>
                                                         <TextBlock Text="Arraste os aplicativos abaixo para a Área de Trabalho virtual para posicionar seus atalhos (ou clique no botão '+' para adicionar automaticamente na grade)."
