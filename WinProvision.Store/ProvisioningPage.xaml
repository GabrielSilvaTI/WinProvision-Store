                                                         <Border Width="1280" Height="720" Background="#01000000"
                                                                 PreviewMouseLeftButtonDown="DesktopMenuBackdrop_MouseDown"
                                                                 PreviewMouseRightButtonDown="DesktopMenuBackdrop_MouseDown" />

                                                         <!-- Menu Principal -->
                                                         <Border x:Name="DesktopContextMenuMain" Width="240" CornerRadius="8" Background="#F2202020" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="4" Canvas.Left="100" Canvas.Top="100">
                                                             <Border.Effect>
                                                                 <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55" />
                                                             </Border.Effect>
                                                             <StackPanel>
                                                                 <!-- Exibir > -->
                                                                 <Border x:Name="MenuItemExibir" Style="{StaticResource Win11MenuItemStyle}" MouseEnter="MenuItemExibir_MouseEnter" MouseLeave="MenuItemExibir_MouseLeave" PreviewMouseLeftButtonUp="MenuItemExibir_Click">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                             <ColumnDefinition Width="24" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                         <TextBlock Grid.Column="1" Text="Exibir" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                         <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- Classificar por > -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                             <ColumnDefinition Width="24" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock Text="&#xE8CB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                         <TextBlock Grid.Column="1" Text="Classificar por" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                         <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- Atualizar -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}" PreviewMouseLeftButtonUp="MenuItemAtualizar_Click">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
