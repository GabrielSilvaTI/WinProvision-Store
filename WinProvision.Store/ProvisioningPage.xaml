                                                                         <TextBlock.Effect>
                                                                             <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.95" />
                                                                         </TextBlock.Effect>
                                                                     </TextBlock>
                                                                 </StackPanel>
                                                             </Border>

                                                             <!-- Microsoft Edge (Ícone oficial do Windows 11) -->
                                                             <Border x:Name="DesktopIconEdge" Width="76" Height="82" CornerRadius="4" Background="Transparent" Canvas.Left="16" Canvas.Top="106" Cursor="Hand"
                                                                     MouseLeftButtonDown="DesktopIcon_MouseLeftButtonDown"
                                                                     MouseMove="DesktopIcon_MouseMove"
                                                                     MouseLeftButtonUp="DesktopIcon_MouseLeftButtonUp"
                                                                     MouseRightButtonUp="DesktopIcon_MouseRightButtonUp">
                                                                 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                     <Image x:Name="ImageEdge" Source="pack://application:,,,/Assets/Desktop/edge.png" Width="44" Height="44" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                     <TextBlock Text="Microsoft Edge" FontSize="11" Foreground="#FFFFFF" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="Segoe UI Variable Text, Segoe UI">
                                                                         <TextBlock.Effect>
                                                                             <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.95" />
                                                                         </TextBlock.Effect>
                                                                     </TextBlock>
                                                                 </StackPanel>
                                                             </Border>

                                                         </Canvas>
                                                     </Canvas>

                                                     <!-- Barra de Tarefas Oficial do Windows 11 (48px de altura proporcional) -->
                                                     <Border x:Name="DesktopPreviewTaskbar" Height="48" VerticalAlignment="Bottom"
                                                             BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF"
                                                             Background="#D91C1C1C">
                                                         <Grid Margin="12,0">
                                                             <!-- Ícones Principais da Barra de Tarefas (Alinhamento Centro ou Esquerda) -->
                                                             <StackPanel x:Name="DesktopPreviewTaskbarIcons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                 
                                                                 <!-- Botão Iniciar (Windows 11 oficial) -->
                                                                 <Border Width="44" Height="44" CornerRadius="6" Background="Transparent" VerticalAlignment="Center">
                                                                     <Image Source="pack://application:,,,/Assets/Desktop/start.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                 </Border>

                                                                 <!-- Caixa de Pesquisa Adaptável (&#xE721;) -->
                                                                 <!-- 1. Caixa Completa -->
                                                                 <Border x:Name="DesktopPreviewSearchBoxFull" Width="200" Height="32" CornerRadius="16" Background="#26FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" VerticalAlignment="Center" Padding="12,0" Margin="4,0,2,0">
                                                                     <Grid VerticalAlignment="Center">
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="Auto" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock Grid.Column="0" x:Name="DesktopPreviewSearchIcon" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                         <TextBlock Grid.Column="1" x:Name="DesktopPreviewSearchText" Text="Pesquisar" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- 2. Apenas Ícone -->
                                                                 <Border x:Name="DesktopPreviewSearchBoxIcon" Width="44" Height="44" CornerRadius="6" Background="Transparent" VerticalAlignment="Center" Visibility="Collapsed" Margin="4,0,2,0">
                                                                     <TextBlock x:Name="DesktopPreviewSearchIconOnly" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                 </Border>

                                                                 <!-- Explorador de Arquivos (Ícone oficial do Windows 11) -->
                                                                 <Border Width="44" Height="44" CornerRadius="6" Background="Transparent" VerticalAlignment="Center">
                                                                     <Image Source="pack://application:,,,/Assets/Desktop/explorer.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                 </Border>

                                                                 <!-- Microsoft Edge (Ícone oficial do Windows 11) -->
                                                                 <Border Width="44" Height="44" CornerRadius="6" Background="Transparent" VerticalAlignment="Center">
                                                                     <Image Source="pack://application:,,,/Assets/Desktop/edge.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                 </Border>

                                                             </StackPanel>

                                                             <!-- Bandeja do Sistema (Canto Direito - Idêntico ao Windows 11) -->
                                                             <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                 <!-- Ícone de Chevron (ChevronUp: &#xE70E;) -->
                                                                 <Border Width="24" Height="36" Background="Transparent" VerticalAlignment="Center">
                                                                     <TextBlock x:Name="DesktopPreviewTrayChevron" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                 </Border>
                                                                 
                                                                 <!-- Indicador de Idioma (POR PTB2) -->
                                                                 <Border Height="36" Background="Transparent" Padding="4,2" VerticalAlignment="Center" Margin="2,0,2,0">
                                                                     <StackPanel VerticalAlignment="Center">
                                                                         <TextBlock x:Name="DesktopPreviewTrayLang1" Text="POR" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" LineHeight="10" TextAlignment="Center" />
                                                                         <TextBlock x:Name="DesktopPreviewTrayLang2" Text="PTB2" FontSize="7.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" LineHeight="9" TextAlignment="Center" />
                                                                     </StackPanel>
                                                                 </Border>

                                                                 <!-- Pílula de Configurações Rápidas (Rede e Som) -->
                                                                 <Border Height="36" CornerRadius="4" Background="Transparent" Padding="6,0" VerticalAlignment="Center" Margin="2,0,2,0">
                                                                     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                         <!-- Ícone de Rede / Desktop (Monitor com cabo: &#xE839;) -->
                                                                         <TextBlock x:Name="DesktopPreviewTrayWifi" Text="&#xE839;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                         <!-- Ícone de Volume / Speaker (&#xE767;) -->
                                                                         <TextBlock x:Name="DesktopPreviewTraySpeaker" Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                     </StackPanel>
                                                                 </Border>

                                                                 <!-- Pílula de Relógio e Data -->
                                                                 <Border Height="36" CornerRadius="4" Background="Transparent" Padding="6,0" VerticalAlignment="Center" Margin="2,0,4,0">
                                                                     <StackPanel VerticalAlignment="Center">
                                                                         <TextBlock x:Name="DesktopPreviewClockText" Text="22:50" FontSize="11.5" FontWeight="SemiBold"
                                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                                                                         <TextBlock x:Name="DesktopPreviewDateText" Text="03/09/2026" FontSize="10"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                                                     </StackPanel>
                                                                 </Border>

                                                                 <!-- Borda de Desktop Peek na extrema direita -->
                                                                 <Rectangle Width="1" Height="20" Fill="#20FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                 <Border Width="4" Height="48" Background="Transparent" />
                                                             </StackPanel>
                                                         </Grid>
                                                     </Border>

                                                     <!-- Indicador de Barra Oculta (quando TaskbarAutoHide = true) -->
                                                     <Border x:Name="DesktopPreviewAutoHideIndicator" Height="4" VerticalAlignment="Bottom" Background="#99FFFFFF" Visibility="Collapsed" />

                                                     <!-- Overlay do Menu de Contexto da Área de Trabalho (Windows 11 Fluent) -->
                                                     <Canvas x:Name="DesktopMenuOverlay" Width="1280" Height="720" Background="Transparent" Visibility="Collapsed">
