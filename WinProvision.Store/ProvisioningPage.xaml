<Page x:Class="WinProvision.Store.ProvisioningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Title="ProvisioningPage">

    <Page.Resources>
        <!-- Mesmo cartão "de vidro" usado na SettingsPage/OfficePage — mantém a identidade visual entre as páginas. -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#26FFFFFF" Offset="0" />
                        <GradientStop Color="#0DFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#38FFFFFF" Offset="0" />
                        <GradientStop Color="#14FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF000000" Direction="270" ShadowDepth="3" BlurRadius="20" Opacity="0.30" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="NavCardStyle" TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="InfoRowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Item da lista de alterações (Perfil/JSON) — um "•" + o rótulo amigável (ex.: "Tema: Escuro"). -->
        <Style x:Key="ChangeItemStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Desktop24" FontSize="32" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Provisionamento" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Perfil para a máquina-alvo: aplicado na hora (se for esta máquina) ou exportado como perfil .json para outra máquina via linha de comando (/Provision)."
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="ImportButton" Content="Importar" Appearance="Secondary"
                           Style="{StaticResource ActionButtonStyle}" Click="ImportButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowImport24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="ExportButton" Content="Exportar" Appearance="Secondary"
                           Style="{StaticResource ActionButtonStyle}" Click="ExportButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowExport24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="ApplyButton" Content="Aplicar agora" Appearance="Primary"
                           Click="ApplyButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="PlayCircle24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Menu lateral de seções (esquerda) + conteúdo (direita): a visão principal é o
             Perfil/JSON; cada cartão do menu abre sua seção no lugar do Perfil, com um botão
             "Voltar" para retornar. Tudo aqui vira campo do ProvisioningManifest — inclusive
             Atualizações & Drivers e Ponto de Restauração, que não são mais ações "ao vivo" na
             máquina onde o perfil é montado, e sim toggles executados pelo
             ProvisioningService.ApplyAsync quando o perfil é de fato aplicado na máquina-alvo
             (botão "Aplicar agora" acima, ou CLI /Provision). -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Menu de seções ================= -->
            <StackPanel Grid.Column="0">
                <ui:CardAction x:Name="PersonalizationNavCard" Style="{StaticResource NavCardStyle}" Click="PersonalizationNavCard_Click">
                    <ui:CardAction.Icon>
                        <ui:SymbolIcon Symbol="PaintBrush24" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <TextBlock Text="Personalização" FontWeight="SemiBold" />
                        <TextBlock Text="Tema, barra de tarefas e papel de parede." Style="{StaticResource CardSubtitleStyle}" FontSize="12" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction x:Name="UpdatesNavCard" Style="{StaticResource NavCardStyle}" Click="UpdatesNavCard_Click">
                    <ui:CardAction.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <TextBlock Text="Atualizações" FontWeight="SemiBold" />
                        <TextBlock Text="Defina como o sistema deve buscar e instalar atualizações." Style="{StaticResource CardSubtitleStyle}" FontSize="12" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction x:Name="AdvancedNavCard" Style="{StaticResource NavCardStyle}" Click="AdvancedNavCard_Click">
                    <ui:CardAction.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <TextBlock Text="Configurações Avançadas" FontWeight="SemiBold" />
                        <TextBlock Text="Nome da máquina, região, energia e ponto de restauração." Style="{StaticResource CardSubtitleStyle}" FontSize="12" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction x:Name="JsonNavCard" Style="{StaticResource NavCardStyle}" Click="JsonNavCard_Click">
                    <ui:CardAction.Icon>
                        <ui:SymbolIcon Symbol="Code24" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <TextBlock Text="Visualização do JSON" FontWeight="SemiBold" />
                        <TextBlock Text="Dados do perfil e o JSON completo gerado." Style="{StaticResource CardSubtitleStyle}" FontSize="12" />
                    </StackPanel>
                </ui:CardAction>
            </StackPanel>

            <!-- ================= Conteúdo: Perfil (padrão) ou seção escolhida ================= -->
            <Grid Grid.Column="2">

                <!-- ===== Visão do Perfil — padrão ao abrir a página ===== -->
                <ScrollViewer x:Name="ProfileOverviewPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>

                            <!-- Alterações do Perfil -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Alterações do Perfil" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="O que este perfil vai levar quando você exportar ou aplicar agora." Style="{StaticResource CardSubtitleStyle}" Margin="0,2,0,16" />

                                    <TextBlock x:Name="NoChangesText" Text="Nenhuma alteração ainda — ajuste algo em Personalização, Atualizações ou Configurações Avançadas."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                    <ItemsControl x:Name="ChangesListItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                    <TextBlock Text="•" Margin="0,0,8,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource ChangeItemStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Resumo do Perfil -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Resumo do Perfil" Style="{StaticResource CardTitleStyle}" />

                                    <Grid Margin="0,16,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="SectionsConfiguredCountText" Text="0" Style="{StaticResource StatValueStyle}" />
                                            <TextBlock Text="Seções configuradas" Style="{StaticResource StatLabelStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="KeysModifiedCountText" Text="0" Style="{StaticResource StatValueStyle}" />
                                            <TextBlock Text="Chaves modificadas" Style="{StaticResource StatLabelStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="WarningsCountText" Text="0" Style="{StaticResource StatValueStyle}" />
                                            <TextBlock Text="Advertências" Style="{StaticResource StatLabelStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="ProfileValidIcon" Symbol="CheckmarkCircle24" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <TextBlock x:Name="ProfileValidText" Text="Perfil válido" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Seções abertas a partir do menu lateral ===== -->
                <Grid x:Name="SectionPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button Appearance="Transparent" Padding="6" Click="BackToProfileButton_Click">
                            <ui:SymbolIcon Symbol="ArrowLeft24" />
                        </ui:Button>
                        <TextBlock x:Name="SectionTitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0" MaxWidth="640" HorizontalAlignment="Left">

                            <!-- ================= Seção: Personalização ================= -->
                            <StackPanel x:Name="PersonalizationSectionPanel" Visibility="Collapsed">

                        <!-- ================= Tema e barra de tarefas ================= -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tema e barra de tarefas" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Alinhamento e caixa de pesquisa só têm efeito no Windows 11."
                                                   Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>

                                    <ui:SymbolIcon Grid.Column="1" Symbol="PaintBrush24" FontSize="22" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <TextBlock Text="Tema do sistema" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6" />
                                <ComboBox x:Name="ThemeComboBox" SelectionChanged="Field_Changed">
                                    <ComboBoxItem Content="Não alterar" Tag="NaoDefinido" IsSelected="True" />
                                    <ComboBoxItem Content="Claro" Tag="Claro" />
                                    <ComboBoxItem Content="Escuro" Tag="Escuro" />
                                </ComboBox>

                                <TextBlock Text="Alinhamento da barra de tarefas" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                                <ComboBox x:Name="TaskbarAlignmentComboBox" SelectionChanged="Field_Changed">
                                    <ComboBoxItem Content="Não alterar" Tag="NaoDefinido" IsSelected="True" />
                                    <ComboBoxItem Content="Esquerda" Tag="Esquerda" />
                                    <ComboBoxItem Content="Centro" Tag="Centro" />
                                </ComboBox>

                                <TextBlock Text="Caixa de pesquisa" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                                <ComboBox x:Name="TaskbarSearchBoxComboBox" SelectionChanged="Field_Changed">
                                    <ComboBoxItem Content="Não alterar" Tag="NaoDefinido" IsSelected="True" />
                                    <ComboBoxItem Content="Oculta" Tag="Oculta" />
                                    <ComboBoxItem Content="Apenas ícone" Tag="ApenasIcone" />
                                    <ComboBoxItem Content="Caixa completa" Tag="CaixaCompleta" />
                                </ComboBox>

                                <CheckBox x:Name="TaskbarAutoHideCheckBox" Content="Ocultar a barra de tarefas automaticamente"
                                          Margin="0,16,0,0" Checked="Field_Changed" Unchecked="Field_Changed" />
                            </StackPanel>
                        </Border>

                        <!-- ================= Wallpaper ================= -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Papel de parede" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="A imagem escolhida viaja em Base64 dentro do próprio perfil .json — ao aplicar, é salva em C:\ProgramData\WinProvision\Wallpaper e definida como papel de parede."
                                                   Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>

                                    <ui:SymbolIcon Grid.Column="1" Symbol="ImageMultiple24" FontSize="22" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <Border Width="220" Height="124" CornerRadius="8" Margin="0,16,0,10" ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}" HorizontalAlignment="Left">
                                    <Image x:Name="WallpaperPreviewImage" Stretch="UniformToFill" />
                                </Border>

                                <TextBlock x:Name="WallpaperFileNameText" Text="Nenhuma imagem selecionada."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                <ui:Button x:Name="SelectWallpaperButton" Content="Escolher imagem..." Appearance="Secondary"
                                           HorizontalAlignment="Left" Click="SelectWallpaperButton_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ImageAdd24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                            </StackPanel>

                            <!-- ================= Seção: Atualizações (Windows Update) ================= -->
                            <StackPanel x:Name="UpdatesSectionPanel" Visibility="Collapsed">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Atualizações do Windows" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Busca e instala todas as atualizações de qualidade/segurança e drivers pendentes (via WUAPI) na máquina-alvo, automaticamente no momento em que este perfil for aplicado — não nesta máquina, agora."
                                                   Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>

                                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowDownload24" FontSize="22" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <CheckBox x:Name="AutoInstallWindowsUpdatesCheckBox"
                                          Content="Instalar atualizações e drivers automaticamente ao aplicar este perfil"
                                          Margin="0,16,0,0" Checked="Field_Changed" Unchecked="Field_Changed" />
                            </StackPanel>
                        </Border>

                            </StackPanel>

                            <!-- ================= Seção: Configurações Avançadas ================= -->
                            <StackPanel x:Name="AdvancedSectionPanel" Visibility="Collapsed">

                        <!-- ================= Nome e região ================= -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nome e região" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Nome da máquina requer reinício. Região cobre só a localização (SetUserGeoName) — formato de data/hora/moeda não tem ajuste aqui."
                                                   Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>

                                    <ui:SymbolIcon Grid.Column="1" Symbol="Laptop24" FontSize="22" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <TextBlock x:Name="CurrentMachineNameText" Text="Nome atual:"
                                           Margin="0,16,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <ui:TextBox x:Name="MachineNameTextBox" PlaceholderText="Deixe em branco para não alterar" TextChanged="Field_Changed" />

                                <TextBlock Text="Região" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6" />
                                <ComboBox x:Name="RegionComboBox" SelectionChanged="Field_Changed">
                                    <ComboBoxItem Content="Não alterar" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="Brasil" Tag="BR" />
                                    <ComboBoxItem Content="Estados Unidos" Tag="US" />
                                    <ComboBoxItem Content="Portugal" Tag="PT" />
                                    <ComboBoxItem Content="Espanha" Tag="ES" />
                                    <ComboBoxItem Content="Alemanha" Tag="DE" />
                                    <ComboBoxItem Content="França" Tag="FR" />
                                    <ComboBoxItem Content="Reino Unido" Tag="GB" />
                                    <ComboBoxItem Content="Itália" Tag="IT" />
                                    <ComboBoxItem Content="Japão" Tag="JP" />
                                    <ComboBoxItem Content="Argentina" Tag="AR" />
                                    <ComboBoxItem Content="México" Tag="MX" />
                                    <ComboBoxItem Content="Canadá" Tag="CA" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- ================= Energia ================= -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Plano de energia" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Troca o plano ativo do Windows (equivalente a powercfg /setactive)."
                                                   Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>

                                    <ui:SymbolIcon Grid.Column="1" Symbol="BatteryCharge24" FontSize="22" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <ComboBox x:Name="PowerPlanComboBox" Margin="0,16,0,0" SelectionChanged="Field_Changed">
                                    <ComboBoxItem Content="Não alterar" Tag="NaoDefinido" IsSelected="True" />
                                    <ComboBoxItem Content="Economia de energia" Tag="Economia" />
                                    <ComboBoxItem Content="Equilibrado" Tag="Equilibrado" />
                                    <ComboBoxItem Content="Alto desempenho" Tag="AltoDesempenho" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- ================= Ponto de restauração ================= -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ponto de restauração" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Cria um ponto de restauração (via WMI SystemRestore) na máquina-alvo, automaticamente no início da aplicação deste perfil — o Windows limita a 1 a cada 24h por padrão."
                                                   Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>

                                    <ui:SymbolIcon Grid.Column="1" Symbol="History32" FontSize="22" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <CheckBox x:Name="AutoCreateRestorePointCheckBox"
                                          Content="Criar ponto de restauração automaticamente ao aplicar este perfil"
                                          Margin="0,16,0,0" Checked="Field_Changed" Unchecked="Field_Changed" />
                            </StackPanel>
                        </Border>

                            </StackPanel>

                            <!-- ================= Seção: Visualização do JSON ================= -->
                            <StackPanel x:Name="JsonSectionPanel" Visibility="Collapsed">

                        <!-- ================= Informações do Perfil ================= -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Informações do Perfil" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Dados de identificação do perfil de provisionamento (até 14 caracteres cada)." Style="{StaticResource CardSubtitleStyle}" Margin="0,2,0,16" />

                                <TextBlock Text="Nome do Perfil" Style="{StaticResource FieldLabelStyle}" />
                                <ui:TextBox x:Name="ProfileNameTextBox" MaxLength="14" PlaceholderText="Sem nome"
                                            TextChanged="Field_Changed" Margin="0,0,0,14" />

                                <TextBlock Text="Criador" Style="{StaticResource FieldLabelStyle}" />
                                <ui:TextBox x:Name="ProfileCreatorTextBox" MaxLength="14" PlaceholderText="WinProvision"
                                            TextChanged="Field_Changed" Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Data de Criação" Style="{StaticResource InfoRowLabelStyle}" />
                                    <TextBlock x:Name="ProfileCreatedAtText" Grid.Column="1" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ================= Visualização do JSON ================= -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Visualização do JSON" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Confira abaixo o JSON completo do perfil de provisionamento." Style="{StaticResource CardSubtitleStyle}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" x:Name="OpenFullEditorButton" Content="Abrir editor completo" Appearance="Secondary"
                                               VerticalAlignment="Top" Click="OpenFullEditorButton_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Notepad24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <Border CornerRadius="8" Background="#33000000" Padding="12">
                                    <TextBox x:Name="JsonPreviewTextBox"
                                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                                             TextWrapping="NoWrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Height="320" />
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ChangesDetectedText" Grid.Column="0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <ui:Button Grid.Column="1" Content="Copiar JSON" Appearance="Secondary" Click="CopyJsonButton_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Copy24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="4,8,4,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
