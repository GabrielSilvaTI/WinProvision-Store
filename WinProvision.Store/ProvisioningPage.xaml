                                                                     </Grid>
                                                                 </Border>

                                                                 <Rectangle Height="1" Fill="#1FFFFFFF" Margin="8,4" />

                                                                 <!-- Novo > -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                             <ColumnDefinition Width="24" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                         <TextBlock Grid.Column="1" Text="Novo" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                         <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <Rectangle Height="1" Fill="#1FFFFFFF" Margin="8,4" />

                                                                 <!-- Configurações de exibição -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                         <TextBlock Grid.Column="1" Text="Configurações de exibição" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- Personalizar -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                         <TextBlock Grid.Column="1" Text="Personalizar" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- Opção de Remoção de Atalho (quando selecionado um ícone adicionado) -->
                                                                 <Rectangle x:Name="MenuSeparatorRemoveShortcut" Height="1" Fill="#1FFFFFFF" Margin="8,4" Visibility="Collapsed" />
                                                                 <Border x:Name="MenuItemRemoveShortcut" Style="{StaticResource Win11MenuItemStyle}" PreviewMouseLeftButtonUp="MenuItemRemoveShortcut_Click" Visibility="Collapsed">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#EF4444" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                         <TextBlock Grid.Column="1" Text="Remover atalho da área de trabalho" FontSize="12" Foreground="#FCA5A5" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                     </Grid>
                                                                 </Border>
                                                             </StackPanel>
                                                         </Border>

                                                         <!-- Submenu de "Exibir" -->
                                                         <Border x:Name="DesktopContextMenuSubExibir" Width="260" CornerRadius="8" Background="#F2202020" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="4" Visibility="Collapsed" Canvas.Left="340" Canvas.Top="100">
                                                             <Border.Effect>
                                                                 <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55" />
                                                             </Border.Effect>
                                                             <StackPanel>
                                                                 <!-- Ícones grandes -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}" PreviewMouseLeftButtonUp="MenuIconSize_Large_Click">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock x:Name="MenuCheckLarge" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                                                                         <TextBlock Grid.Column="1" Text="Ícones grandes" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- Ícones médios -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}" PreviewMouseLeftButtonUp="MenuIconSize_Medium_Click">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock x:Name="MenuCheckMedium" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible" />
                                                                         <TextBlock Grid.Column="1" Text="Ícones médios" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- Ícones pequenos -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}" PreviewMouseLeftButtonUp="MenuIconSize_Small_Click">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock x:Name="MenuCheckSmall" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                                                                         <TextBlock Grid.Column="1" Text="Ícones pequenos" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <Rectangle Height="1" Fill="#1FFFFFFF" Margin="8,4" />

                                                                 <!-- Organizar ícones automaticamente -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}" PreviewMouseLeftButtonUp="MenuAutoArrange_Click">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock x:Name="MenuCheckAutoArrange" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                                                                         <TextBlock Grid.Column="1" Text="Organizar ícones automaticamente" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <!-- Alinhar ícones à grade -->
                                                                 <Border Style="{StaticResource Win11MenuItemStyle}" PreviewMouseLeftButtonUp="MenuAlignToGrid_Click">
                                                                     <Grid>
                                                                         <Grid.ColumnDefinitions>
                                                                             <ColumnDefinition Width="28" />
                                                                             <ColumnDefinition Width="*" />
                                                                         </Grid.ColumnDefinitions>
                                                                         <TextBlock x:Name="MenuCheckAlignToGrid" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible" />
                                                                         <TextBlock Grid.Column="1" Text="Alinhar ícones à grade" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                     </Grid>
                                                                 </Border>

                                                                 <Rectangle Height="1" Fill="#1FFFFFFF" Margin="8,4" />

                                                                 <!-- Mostrar ícones da área de trabalho (Permite ocultar/exibir todos os ícones) -->
                                                                 <Border x:Name="MenuItemToggleDesktopIcons" Style="{StaticResource Win11MenuItemStyle}" PreviewMouseLeftButtonUp="MenuItemToggleDesktopIcons_Click">
