<Page x:Class="WinProvision.Store.ProvisioningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      ScrollViewer.CanContentScroll="False"
      Title="ProvisioningPage"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <!-- Cartões de configuração consomem a superfície compartilhada do app. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource StoreCardSurfaceStyle}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!--  Estilo de Item do Menu de Contexto do Windows 11  -->
        <Style x:Key="Win11MenuItemStyle" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="{StaticResource CompactCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Estilos para as Linhas de Configuração  -->
        <Style x:Key="SettingsRowTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        </Style>

        <Style x:Key="SettingsRowSubtitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

    </Page.Resources>

    <Border Background="Transparent"
            Margin="{StaticResource PageContentMargin}"
            MaxWidth="600"
            HorizontalAlignment="Center"
            CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ================= Cabeçalho Global =================  -->
            <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Style="{StaticResource PageHeaderIconTileStyle}"><ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource PageHeaderSymbolIconStyle}" /></Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Provisionamento" Style="{StaticResource StorePageTitleStyle}" />
                        <TextBlock Text="Configure o Windows e exporte um perfil reutilizável."
                                   Style="{StaticResource StoreSubtitleStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:Button x:Name="ApplyButton"
                               Content="Aplicar agora"
                               Visibility="Collapsed"
                               Appearance="Primary"
                               Style="{StaticResource StoreActionButtonStyle}"
                               Click="ApplyButton_Click"
                               Height="36"
                               ToolTip="Aplicar as configurações selecionadas">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="PlayCircle24" FontSize="16" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Pesquisa alinhada à página Configurações. -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="ProvisioningSearchBox"
                            Grid.Column="1"
                            MaxWidth="320"
                            HorizontalAlignment="Stretch"
                            MinHeight="36"
                            PlaceholderText="Pesquisar opções de provisionamento"
                            Icon="Search24"
                            ClearButtonEnabled="True"
                            AutomationProperties.Name="Pesquisar opções de provisionamento"
                            TextChanged="ProvisioningSearchBox_TextChanged"
                            KeyDown="ProvisioningSearchBox_KeyDown" />
                <TextBlock x:Name="ProvisioningSearchResultText"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Visibility="Collapsed"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </Grid>

            <!--  ================= Corpo =================  -->
            <Grid Grid.Row="2">
                <Grid>

                    <!--  Visão 1: Menu de Seções  -->
                    <ScrollViewer x:Name="ProfileOverviewPanel"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                        <StackPanel Margin="0,0,8,0">
                            <StackPanel x:Name="ProvisioningSearchResultsPanel" Visibility="Collapsed">
                                <TextBlock Text="Resultados da pesquisa" Style="{StaticResource StoreSectionTitleStyle}" Margin="0,0,0,12" />
                                <StackPanel x:Name="ProvisioningSearchResultsList" />
                                <Border x:Name="ProvisioningSearchEmptyText"
                                        Style="{StaticResource PageEmptyStateCardStyle}"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0">
                                    <StackPanel HorizontalAlignment="Center" MaxWidth="360">
                                        <Border Width="44" Height="44"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                            <ui:SymbolIcon Symbol="Search24"
                                                           FontSize="22"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Nenhuma opção encontrada"
                                                   Style="{StaticResource FluentCardTitleStyle}"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="Tente outro termo para localizar a configuração desejada."
                                                   Style="{StaticResource StoreCardSubtitleStyle}"
                                                   TextAlignment="Center"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="ProvisioningCategoriesPanel">
                            <TextBlock Text="Categorias" Style="{StaticResource StoreSectionTitleStyle}" Margin="0,0,0,12" />
                            <ui:Button x:Name="PersonalizationNavCard"
                                       Style="{StaticResource PageNavigationCardStyle}"
                                       Click="PersonalizationNavCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,16,0"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource FluentPanelElevatedBrush}">
                                        <ui:SymbolIcon Symbol="PaintBrush24" FontSize="20"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Personalização" Style="{StaticResource FluentCardTitleStyle}" />
                                        <TextBlock Text="Tema, barra de tarefas e plano de fundo."
                                                   Style="{StaticResource StoreCardSubtitleStyle}"
                                                   FontSize="13" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="2"
                                                   Symbol="ChevronRight24"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>

                            <ui:Button x:Name="AdvancedNavCard"
                                       Style="{StaticResource PageNavigationCardStyle}"
                                       Click="AdvancedNavCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,16,0"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource FluentPanelElevatedBrush}">
                                        <ui:SymbolIcon Symbol="Settings24" FontSize="20"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Configurações Avançadas" Style="{StaticResource FluentCardTitleStyle}" />
                                        <TextBlock Text="Nome, região, energia e restauração."
                                                   Style="{StaticResource StoreCardSubtitleStyle}"
                                                   FontSize="13" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="2"
                                                   Symbol="ChevronRight24"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>

                            <ui:Button x:Name="JsonNavCard"
                                       Style="{StaticResource PageNavigationCardStyle}"
                                       Click="JsonNavCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,16,0"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource FluentPanelElevatedBrush}">
                                        <ui:SymbolIcon Symbol="Code24" FontSize="20"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Visualização do JSON" Style="{StaticResource FluentCardTitleStyle}" />
                                        <TextBlock Text="Identificação e perfil JSON."
                                                   Style="{StaticResource StoreCardSubtitleStyle}"
                                                   FontSize="13" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="2"
                                                   Symbol="ChevronRight24"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>

                            <ui:Button x:Name="OrchestratorNavCard"
                                       Style="{StaticResource PageNavigationCardStyle}"
                                       Click="OrchestratorNavCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,16,0"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource FluentPanelElevatedBrush}">
                                        <Image x:Name="OrchestratorIcon" Width="20" Height="20"
                                               Source="pack://application:,,,/Assets/WinProvisionStore_White.png"
                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="WinProvision Orchestrator" Style="{StaticResource FluentCardTitleStyle}" />
                                        <TextBlock Text="Prepare a instalação automática do app e deste perfil."
                                                   Style="{StaticResource StoreCardSubtitleStyle}"
                                                   FontSize="13" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Visão 2: Formulários das Seções  -->
                    <Grid x:Name="SectionPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Cabeçalho de Retorno Breadcrumb  -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,24">
                            <ui:Button Appearance="Transparent"
                                       Padding="8,6"
                                       CornerRadius="{StaticResource ControlCornerRadius}"
                                       Click="BackToProfileButton_Click">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" />
                            </ui:Button>
                            <TextBlock x:Name="SectionTitleText"
                                       Style="{StaticResource FluentPageTitleStyle}"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                            <StackPanel Margin="0,0,12,0">

                                <!--  ================= 1. Personalização =================  -->
                                <StackPanel x:Name="PersonalizationSectionPanel" Visibility="Collapsed">

                                    <!--  Bloco 1: Tema e Barra de Tarefas  -->
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>

                                            <!--  Tema  -->
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Tema do sistema" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Escolha o tema visual do sistema." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <ComboBox x:Name="ThemeComboBox"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="Field_Changed">
                                                    <ComboBoxItem Content="Não alterar"
                                                                  Tag="NaoDefinido"
                                                                  IsSelected="True" />
                                                    <ComboBoxItem Content="Claro" Tag="Claro" />
                                                    <ComboBoxItem Content="Escuro" Tag="Escuro" />
                                                </ComboBox>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <!--  Alinhamento Barra de Tarefas  -->
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Alinhamento da barra de tarefas" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Apenas Windows 11." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <ComboBox x:Name="TaskbarAlignmentComboBox"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="Field_Changed">
                                                    <ComboBoxItem Content="Não alterar"
                                                                  Tag="NaoDefinido"
                                                                  IsSelected="True" />
                                                    <ComboBoxItem Content="Esquerda" Tag="Esquerda" />
                                                    <ComboBoxItem Content="Centro" Tag="Centro" />
                                                </ComboBox>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <!--  Caixa de Pesquisa  -->
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Caixa de pesquisa" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Apenas Windows 11." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <ComboBox x:Name="TaskbarSearchBoxComboBox"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="Field_Changed">
                                                    <ComboBoxItem Content="Não alterar"
                                                                  Tag="NaoDefinido"
                                                                  IsSelected="True" />
                                                    <ComboBoxItem Content="Oculta" Tag="Oculta" />
                                                    <ComboBoxItem Content="Apenas ícone" Tag="ApenasIcone" />
                                                    <ComboBoxItem Content="Caixa completa" Tag="CaixaCompleta" />
                                                </ComboBox>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <!--  Auto Hide  -->
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Ocultar a barra de tarefas automaticamente" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Faz a barra recolher quando não está em uso." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <CheckBox x:Name="TaskbarAutoHideCheckBox"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Checked="Field_Changed"
                                                          Unchecked="Field_Changed" />
                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                    <!--  Bloco 2: Wallpaper  -->
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <!--  Título da Seção do Cartão  -->
                                            <Grid Margin="24,16">
                                                <StackPanel>
                                                    <TextBlock Text="Papel de Parede" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Escolha uma imagem para a área de trabalho." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <!--  Linha de Ação do Wallpaper  -->
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Thumbnail  -->
                                                <Border Grid.Column="0"
                                                        Width="100"
                                                        Height="64"
                                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                                        ClipToBounds="True"
                                                        Background="{DynamicResource StoreBrush_1AFFFFFF}"
                                                        Margin="0,0,16,0">
                                                    <Image x:Name="WallpaperPreviewImage" Stretch="UniformToFill" />
                                                </Border>

                                                <!--  Textos  -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,16,0">
                                                    <TextBlock Text="Imagem"
                                                               FontWeight="Medium"
                                                               FontFamily="Segoe UI Variable Text" />
                                                    <TextBlock x:Name="WallpaperFileNameText"
                                                               Text="Nenhuma imagem selecionada."
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!--  Botões  -->
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <ui:Button x:Name="ClearWallpaperButton"
                                                               Content="Restaurar padrão"
                                                               Appearance="Secondary"
                                                               VerticalAlignment="Center"
                                                               Click="ClearWallpaperButton_Click"
                                                               CornerRadius="{StaticResource ControlCornerRadius}"
                                                               Margin="0,0,8,0"
                                                               Visibility="Collapsed" />
                                                    <ui:Button x:Name="SelectWallpaperButton"
                                                               Content="Alterar imagem"
                                                               Appearance="Secondary"
                                                               VerticalAlignment="Center"
                                                               Click="SelectWallpaperButton_Click"
                                                               CornerRadius="{StaticResource ControlCornerRadius}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Prévia ilustrativa da área de trabalho -->
                                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,24" Padding="16" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                                <TextBlock Text="Prévia da área de trabalho" Style="{StaticResource PageSectionHeaderStyle}" />
                                                <TextBlock Text="Visualize o papel de parede e a barra de tarefas antes de aplicar. Esta prévia é ilustrativa."
                                                           Style="{StaticResource StoreCardSubtitleStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Stretch">
                                                <Border Width="1280" Height="720" ClipToBounds="True" Background="{DynamicResource StoreBrush_0F172A}">
                                                    <Grid>
                                                        <Image x:Name="DesktopPreviewWallpaper" Stretch="UniformToFill" />
                                                        <Canvas x:Name="DesktopPreviewIconLayer" Height="672" VerticalAlignment="Top" IsHitTestVisible="False">
                                                            <StackPanel Width="88" Canvas.Left="16" Canvas.Top="16">
                                                                <Image Source="pack://application:,,,/Assets/Desktop/recycle_bin.png" Width="44" Height="44" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Lixeira" FontSize="11" Foreground="{DynamicResource StoreBrush_FFFFFF}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0">
                                                                    <TextBlock.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Color="{DynamicResource StoreColor_000000}" Opacity="0.9" /></TextBlock.Effect>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Canvas>
                                                        <Border x:Name="DesktopPreviewTaskbar" Height="48" VerticalAlignment="Bottom" ClipToBounds="True"
                                                                Background="{DynamicResource StoreBrush_D91C1C1C}">
                                                            <Grid>
                                                                <!-- Simula o backdrop-filter: blur() usado pela barra do win11React. -->
                                                                <Image Source="{Binding Source, ElementName=DesktopPreviewWallpaper}" Height="720" VerticalAlignment="Bottom"
                                                                       Stretch="Fill" IsHitTestVisible="False">
                                                                    <Image.Effect><BlurEffect Radius="18" RenderingBias="Performance" /></Image.Effect>
                                                                </Image>
                                                                <Border x:Name="DesktopPreviewTaskbarTint" Background="#BF202020" />
                                                                <Grid Margin="4,0,0,0">
                                                                    <StackPanel x:Name="DesktopPreviewTaskbarIcons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Border Width="38" Height="38" Margin="3,0" CornerRadius="4" Background="Transparent">
                                                                            <Image Source="pack://application:,,,/Assets/Desktop/start.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border x:Name="DesktopPreviewSearchBoxIcon" Width="38" Height="38" Visibility="Collapsed" Margin="3,0" CornerRadius="4">
                                                                            <Path x:Name="DesktopPreviewSearchIconOnly" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M13.5,13.5 L19,19 M15.5,8.5 A7,7 0 1 1 1.5,8.5 A7,7 0 1 1 15.5,8.5" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                                        </Border>
                                                                        <Border Width="38" Height="38" Margin="3,0" CornerRadius="4"><Grid><Image Source="pack://application:,,,/Assets/Desktop/Taskbar/settings.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Width="6" Height="3" Background="#BFFFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,1" CornerRadius="2" /></Grid></Border>
                                                                        <Border Width="38" Height="38" Margin="3,0" CornerRadius="4"><Grid><Image Source="pack://application:,,,/Assets/Desktop/Taskbar/explorer.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Width="6" Height="3" Background="#BFFFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,1" CornerRadius="2" /></Grid></Border>
                                                                        <Border Width="38" Height="38" Margin="3,0" CornerRadius="4"><Grid><Image Source="pack://application:,,,/Assets/Desktop/Taskbar/edge.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Width="6" Height="3" Background="#BFFFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,1" CornerRadius="2" /></Grid></Border>
                                                                        <Border Width="38" Height="38" Margin="3,0" CornerRadius="4"><Grid><Image Source="pack://application:,,,/Assets/Desktop/Taskbar/store.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Width="6" Height="3" Background="#BFFFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,1" CornerRadius="2" /></Grid></Border>
                                                                        <Border Width="38" Height="38" Margin="3,0" CornerRadius="4"><Grid><Image Source="pack://application:,,,/Assets/Desktop/Taskbar/spotify.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Width="6" Height="3" Background="#BFFFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,1" CornerRadius="2" /></Grid></Border>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                                                        <Border Width="28" Height="48" CornerRadius="4"><Path x:Name="DesktopPreviewTrayChevron" Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M1,4 L4,1 L7,4" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Border>
                                                                        <Border Width="72" Height="48" CornerRadius="4"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="24">
                                                                            <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,7,0">
                                                                                <Path x:Name="DesktopPreviewTrayWifi" Data="M1,6 C5,2 13,2 17,6 M4,9 C7,6 11,6 14,9 M7,12 C8.5,10.5 9.5,10.5 11,12" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                                                                <Ellipse x:Name="DesktopPreviewTrayWifiDot" Width="2.2" Height="2.2" Fill="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                                                            </Grid>
                                                                            <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                                <Path x:Name="DesktopPreviewTraySpeaker" Data="M2,7 H5 L9,4 V14 L5,11 H2 Z" Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                                <Path x:Name="DesktopPreviewTraySpeakerWaves" Data="M11,7 C13,8 13,10 11,11 M13,5 C17,8 17,10 13,13" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                                                            </Grid>
                                                                            <Grid Width="18" Height="16" VerticalAlignment="Center">
                                                                                <Border x:Name="DesktopPreviewTrayBattery" Width="13" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1" CornerRadius="2" BorderBrush="{DynamicResource TextFillColorSecondaryBrush}">
                                                                                    <Border x:Name="DesktopPreviewTrayBatteryLevel" Width="6" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" Background="{DynamicResource TextFillColorSecondaryBrush}" CornerRadius="1" />
                                                                                </Border>
                                                                                <Border x:Name="DesktopPreviewTrayBatteryTerminal" Width="2" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource TextFillColorSecondaryBrush}" CornerRadius="0,1,1,0" />
                                                                            </Grid>
                                                                        </StackPanel></Border>
                                                                        <Border Height="48" Padding="8,0" CornerRadius="4"><StackPanel VerticalAlignment="Center">
                                                                            <TextBlock x:Name="DesktopPreviewClockText" Text="22:50" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                                                            <TextBlock x:Name="DesktopPreviewDateText" Text="29/09/2026" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                                        </StackPanel></Border>
                                                                        <Border Width="4" Height="48" Margin="2,0,0,0" BorderThickness="1,0,0,0" BorderBrush="#33FFFFFF" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="DesktopPreviewAutoHideIndicator" Height="4" VerticalAlignment="Bottom" Background="{DynamicResource StoreBrush_99FFFFFF}" Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!--  ================= 2. Avançadas =================  -->
                                <StackPanel x:Name="AdvancedSectionPanel" Visibility="Collapsed">

                                    <StackPanel Margin="4,0,4,16">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Settings24"
                                                           FontSize="22"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center" />
                                            <TextBlock Text="Sistema" Style="{StaticResource PageSectionHeaderStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="Altere as configurações do sistema."
                                                   Style="{StaticResource StoreCardSubtitleStyle}"
                                                   Margin="32,2,0,0" />
                                    </StackPanel>

                                    <!--  Nome e Região  -->
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Nome da Máquina" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Alterar o nome requer reinício." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Atual: "
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock x:Name="CurrentMachineNameText"
                                                                   Text="PC"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <ui:TextBox x:Name="MachineNameTextBox"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            PlaceholderText="Deixe em branco p/ não alterar"
                                                            TextChanged="Field_Changed" />
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Região" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Define a região do Windows." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <ComboBox x:Name="RegionComboBox"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="Field_Changed">
                                                    <ComboBoxItem Content="Não alterar"
                                                                  Tag=""
                                                                  IsSelected="True" />
                                                    <ComboBoxItem Content="Brasil" Tag="BR" />
                                                    <ComboBoxItem Content="Estados Unidos" Tag="US" />
                                                    <ComboBoxItem Content="Portugal" Tag="PT" />
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  Energia  -->
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Plano de energia" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Escolha o plano de energia do Windows." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <ComboBox x:Name="PowerPlanComboBox"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="Field_Changed">
                                                    <ComboBoxItem Content="Não alterar"
                                                                  Tag="NaoDefinido"
                                                                  IsSelected="True" />
                                                    <ComboBoxItem Content="Economia de energia" Tag="Economia" />
                                                    <ComboBoxItem Content="Equilibrado" Tag="Equilibrado" />
                                                    <ComboBoxItem Content="Alto desempenho" Tag="AltoDesempenho" />
                                                </ComboBox>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <!--  Tela desliga  -->
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="180" />
                                                    <ColumnDefinition Width="220" MinWidth="150" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Quando desligar a tela" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Defina quando a tela será desligada." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Na tomada"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,0,0,4" />
                                                    <ComboBox x:Name="DisplayTimeoutAcComboBox"
                                                              Grid.Row="1"
                                                              VerticalAlignment="Top"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="Field_Changed"
                                                              Tag="int-minutes"
                                                              MaxDropDownHeight="280">
                                                        <ComboBoxItem Content="Não alterar"
                                                                      Tag="-1"
                                                                      IsSelected="True" />
                                                        <ComboBoxItem Content="1 minuto" Tag="1" />
                                                        <ComboBoxItem Content="2 minutos" Tag="2" />
                                                        <ComboBoxItem Content="3 minutos" Tag="3" />
                                                        <ComboBoxItem Content="5 minutos" Tag="5" />
                                                        <ComboBoxItem Content="10 minutos" Tag="10" />
                                                        <ComboBoxItem Content="15 minutos" Tag="15" />
                                                        <ComboBoxItem Content="20 minutos" Tag="20" />
                                                        <ComboBoxItem Content="25 minutos" Tag="25" />
                                                        <ComboBoxItem Content="30 minutos" Tag="30" />
                                                        <ComboBoxItem Content="45 minutos" Tag="45" />
                                                        <ComboBoxItem Content="1 hora" Tag="60" />
                                                        <ComboBoxItem Content="1 hora e meia" Tag="90" />
                                                        <ComboBoxItem Content="2 horas" Tag="120" />
                                                        <ComboBoxItem Content="3 horas" Tag="180" />
                                                        <ComboBoxItem Content="Nunca" Tag="0" />
                                                    </ComboBox>
                                                </Grid>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <!--  PC suspende  -->
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="180" />
                                                    <ColumnDefinition Width="220" MinWidth="150" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Quando suspender o PC" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Defina quando o computador entrará em suspensão." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Na tomada"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,0,0,4" />
                                                    <ComboBox x:Name="StandbyTimeoutAcComboBox"
                                                              Grid.Row="1"
                                                              VerticalAlignment="Top"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="Field_Changed"
                                                              Tag="int-minutes"
                                                              MaxDropDownHeight="280">
                                                        <ComboBoxItem Content="Não alterar"
                                                                      Tag="-1"
                                                                      IsSelected="True" />
                                                        <ComboBoxItem Content="1 minuto" Tag="1" />
                                                        <ComboBoxItem Content="2 minutos" Tag="2" />
                                                        <ComboBoxItem Content="3 minutos" Tag="3" />
                                                        <ComboBoxItem Content="5 minutos" Tag="5" />
                                                        <ComboBoxItem Content="10 minutos" Tag="10" />
                                                        <ComboBoxItem Content="15 minutos" Tag="15" />
                                                        <ComboBoxItem Content="20 minutos" Tag="20" />
                                                        <ComboBoxItem Content="25 minutos" Tag="25" />
                                                        <ComboBoxItem Content="30 minutos" Tag="30" />
                                                        <ComboBoxItem Content="45 minutos" Tag="45" />
                                                        <ComboBoxItem Content="1 hora" Tag="60" />
                                                        <ComboBoxItem Content="1 hora e meia" Tag="90" />
                                                        <ComboBoxItem Content="2 horas" Tag="120" />
                                                        <ComboBoxItem Content="3 horas" Tag="180" />
                                                        <ComboBoxItem Content="Nunca" Tag="0" />
                                                    </ComboBox>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  Restauração  -->
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Ponto de restauração" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Cria um ponto de restauração antes de aplicar as mudanças." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <CheckBox x:Name="AutoCreateRestorePointCheckBox"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Checked="Field_Changed"
                                                          Unchecked="Field_Changed" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  Limpeza de Arquivos Temporários ao Logon  -->
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Limpar arquivos temporários ao fazer Logon" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Limpa os arquivos temporários sempre que você entrar no Windows." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <CheckBox x:Name="AutoCleanTempOnLogonCheckBox"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Checked="Field_Changed"
                                                          Unchecked="Field_Changed" />
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <Grid Margin="24,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,16,0">
                                                    <TextBlock x:Name="CleanTempTaskStatusText"
                                                               Text="Status da tarefa no sistema: Verificando…"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <ui:Button x:Name="ScheduleCleanTempNowButton"
                                                               Content="Agendar Tarefa Agora"
                                                               Appearance="Secondary"
                                                               CornerRadius="{StaticResource ControlCornerRadius}"
                                                               Click="ScheduleCleanTempNowButton_Click">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="CalendarClock24" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>

                                <!--  ================= 4. JSON =================  -->
                                <StackPanel x:Name="JsonSectionPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Informação OEM" Style="{StaticResource SettingsRowTitleStyle}" />
                                                </StackPanel>
                                                <ui:TextBox x:Name="ProfileNameTextBox"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            MaxLength="14"
                                                            PlaceholderText="Sem nome"
                                                            TextChanged="Field_Changed" />
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Nome do Perfil" Style="{StaticResource SettingsRowTitleStyle}" />
                                                </StackPanel>
                                                <ui:TextBox x:Name="ProfileCreatorTextBox"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            MaxLength="14"
                                                            PlaceholderText="WinProvision"
                                                            TextChanged="Field_Changed" />
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource StoreBrush_0DFFFFFF}" />

                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Data de Criação" Style="{StaticResource SettingsRowTitleStyle}" />
                                                </StackPanel>
                                                <TextBlock x:Name="ProfileCreatedAtText"
                                                           Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Variable Text"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="Código JSON" Style="{StaticResource SettingsRowTitleStyle}" />
                                                    <TextBlock Text="Veja o perfil JSON atualizado." Style="{StaticResource SettingsRowSubtitleStyle}" />
                                                </StackPanel>
                                                <ui:Button x:Name="OpenFullEditorButton"
                                                           Grid.Column="1"
                                                           Content="Editor completo"
                                                           Appearance="Secondary"
                                                           VerticalAlignment="Center"
                                                           Click="OpenFullEditorButton_Click"
                                                           CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="Notepad24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </Grid>

                                            <Border CornerRadius="{StaticResource ControlCornerRadius}"
                                                    Background="{DynamicResource StoreBrush_1A000000}"
                                                    Padding="12"
                                                    Margin="24,0,24,16"
                                                    BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                                                    BorderThickness="1">
                                                <TextBox x:Name="JsonPreviewTextBox"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         FontFamily="Cascadia Mono, Consolas, Courier New"
                                                         FontSize="12"
                                                         TextWrapping="NoWrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         Height="260"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <Grid Margin="24,0,24,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ChangesDetectedText"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontFamily="Segoe UI Variable Text" />
                                                <ui:Button Grid.Column="1"
                                                           Content="Copiar JSON"
                                                           Appearance="Secondary"
                                                           Click="CopyJsonButton_Click"
                                                           CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="Copy24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="OrchestratorSectionPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Margin="24,20">
                                            <TextBlock Text="Prepare o FirstLogon do Schneegans"
                                                       Style="{StaticResource SettingsRowTitleStyle}" />
                                            <TextBlock Text="Publique o perfil e o script no seu Gist secreto. Depois, cole o comando curto no FirstLogon para instalar o app e aplicar este perfil automaticamente."
                                                       Style="{StaticResource SettingsRowSubtitleStyle}"
                                                       Margin="0,6,0,16" />
                                            <TextBlock Text="Exibição durante a execução"
                                                       Style="{StaticResource SettingsRowTitleStyle}"
                                                       Margin="0,0,0,8" />
                                            <StackPanel Margin="0,0,0,16">
                                                <RadioButton x:Name="OrchestratorDisplayUiRadio"
                                                             GroupName="OrchestratorDisplayMode"
                                                             Content="Exibir a interface do WinProvision"
                                                             IsChecked="True"
                                                             Margin="0,2,0,6"
                                                             Checked="OrchestratorOptions_Changed" />
                                                <RadioButton x:Name="OrchestratorDisplayTerminalRadio"
                                                             GroupName="OrchestratorDisplayMode"
                                                             Content="Exibir o progresso no Terminal"
                                                             Margin="0,2,0,0"
                                                             Checked="OrchestratorOptions_Changed" />
                                            </StackPanel>
                                            <TextBlock Text="Rastreamento de logs"
                                                       Style="{StaticResource SettingsRowTitleStyle}"
                                                       Margin="0,0,0,8" />
                                            <StackPanel Margin="0,0,0,16">
                                                <RadioButton x:Name="OrchestratorLogsLocalRadio"
                                                             GroupName="OrchestratorLogMode"
                                                             Content="Salvar neste computador"
                                                             IsChecked="True"
                                                             Margin="0,2,0,6"
                                                             Checked="OrchestratorOptions_Changed" />
                                                <RadioButton x:Name="OrchestratorLogsCloudRadio"
                                                             GroupName="OrchestratorLogMode"
                                                             Content="Acompanhar pela nuvem"
                                                             Margin="0,2,0,0"
                                                             Checked="OrchestratorOptions_Changed" />
                                            </StackPanel>
                                            <StackPanel x:Name="OrchestratorLocalLogPathPanel" Margin="0,0,0,16">
                                                <TextBlock Text="Arquivo de log TXT no computador de destino"
                                                           Style="{StaticResource StoreCardSubtitleStyle}"
                                                           Margin="0,0,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="OrchestratorLogPathTextBox"
                                                             IsReadOnly="True"
                                                             VerticalContentAlignment="Center"
                                                             Padding="10,6"
                                                             Text="Selecione o destino do arquivo TXT"
                                                             ToolTip="Caminho usado no computador que executar o Orchestrator" />
                                                    <ui:Button Grid.Column="1"
                                                               Content="Escolher arquivo..."
                                                               Appearance="Secondary"
                                                               Margin="8,0,0,0"
                                                               Click="ChooseOrchestratorLogPathButton_Click"
                                                               CornerRadius="{StaticResource ControlCornerRadius}" />
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Text="Uma cópia local é mantida como segurança. O modo nuvem também envia os logs para acompanhamento remoto."
                                                       Style="{StaticResource StoreCardSubtitleStyle}"
                                                       Margin="0,0,0,16" />
                                            <Border CornerRadius="{StaticResource ControlCornerRadius}"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                                    Background="{DynamicResource FluentPanelElevatedBrush}"
                                                    Margin="0,0,0,12">
                                                <TextBox x:Name="BootstrapCommandTextBox"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="12"
                                                         FontFamily="Cascadia Mono, Consolas, Courier New"
                                                         FontSize="13"
                                                         TextWrapping="Wrap"
                                                         MinHeight="48"
                                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="O Gist é secreto, mas qualquer pessoa com o link pode ler o perfil e executar o script. Publique novamente depois de alterar o perfil para atualizar o comando."
                                                       Style="{StaticResource StoreCardSubtitleStyle}"
                                                       Margin="0,0,0,12" />
                                            <WrapPanel>
                                                <ui:Button x:Name="PublishBootstrapButton"
                                                           Appearance="Secondary"
                                                           Click="PublishBootstrapButton_Click"
                                                           Style="{StaticResource StoreActionButtonStyle}"
                                                           Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="16" Margin="0,0,8,0" />
                                                        <TextBlock Text="Publicar Orchestrator" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button x:Name="CopyBootstrapCommandButton"
                                                           Appearance="Secondary"
                                                           Click="CopyBootstrapCommandButton_Click"
                                                           Style="{StaticResource StoreActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="16" Margin="0,0,8,0" />
                                                        <TextBlock Text="Copiar comando" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>



                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>

            </Grid>

            <!--  ================= Rodapé =================  -->
            <Border Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Style="{StaticResource PageStatusIconStyle}" />
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource PageStatusTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>
