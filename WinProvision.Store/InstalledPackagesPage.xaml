<Page x:Class="WinProvision.Store.InstalledPackagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      Background="Transparent"
      ScrollViewer.CanContentScroll="False"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />

        <!--  Tipografia Fluent (Segoe UI Variable)  -->
        <Style x:Key="PageTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentPageTitleStyle}" />

        <Style x:Key="CardTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCardTitleStyle}" />

        <Style x:Key="CardSubtitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Cartão Base "Mica-Friendly"  -->
        <Style x:Key="CardStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="Padding" Value="{StaticResource Spacing24}" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.2"
                                      BlurRadius="24"
                                      ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Botões de Ação Uniformes  -->
        <Style x:Key="ActionUniformButtonStyle"
               TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="InstalledCardStyle" TargetType="Border">
            <Setter Property="Width" Value="214" />
            <Setter Property="Height" Value="248" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#4CAF6B" />
                    <Setter Property="Background" Value="#154CAF6B" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#254CAF6B" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="InstalledGridTemplate">
            <Border Style="{StaticResource InstalledCardStyle}"
                    MouseLeftButtonUp="SelectPackage_Click"
                    Visibility="{Binding IsSearchMatch, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon Grid.Row="0"
                                   Symbol="CheckmarkCircle24"
                                   FontSize="20"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF6B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Width="56"
                                Height="56"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                ClipToBounds="True">
                            <Grid>
                                <ui:SymbolIcon Symbol="Box24"
                                               FontSize="34"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=GridInstalledImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <Image x:Name="GridInstalledImage"
                                       Stretch="Uniform"
                                       conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=GridInstalledImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   Margin="0,0,0,2"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0">
                        <WrapPanel HorizontalAlignment="Center">
                            <Border Background="{DynamicResource AppBorderSubtleBrush}"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Margin="2">
                                <TextBlock Text="{Binding SourceLabel}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Background="{DynamicResource AppBorderSubtleBrush}"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Margin="2">
                                <TextBlock Text="{Binding VersionLabel}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,3,0,0">
                            <TextBlock Text="{Binding InstallationMethodGlyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <TextBlock Text="{Binding InstallationMethodLabel}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InstalledListTemplate">
            <Border Padding="12,10"
                    Margin="0,0,0,6"
                    Visibility="{Binding IsSearchMatch, Converter={StaticResource BoolToVisibilityConverter}}"
                    MouseLeftButtonUp="SelectPackage_Click"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                    BorderThickness="1"
                    Height="80">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#4CAF6B" />
                                <Setter Property="Background" Value="#154CAF6B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Height="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="CheckmarkCircle24"
                                   FontSize="20"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF6B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <Border Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            Background="{DynamicResource AppSurfaceBrush}"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            ClipToBounds="True">
                        <Grid>
                            <ui:SymbolIcon Symbol="Box24"
                                           FontSize="22"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=ListInstalledImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Image x:Name="ListInstalledImage"
                                   Stretch="Uniform"
                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=ListInstalledImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Id}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,5">
                            <TextBlock Text="{Binding SourceLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="  ·  "
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding VersionLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding InstallationMethodGlyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <TextBlock Text="{Binding InstallationMethodLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Margin="{StaticResource PageContentMargin}"
          MaxWidth="1600"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Style="{StaticResource FluentPageIconStyle}" Text="&#xE71D;" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Pacotes Instalados" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Veja e remova os aplicativos instalados."
                           Style="{StaticResource CardSubtitleStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="{StaticResource PageColumnGap}" />
                <ColumnDefinition Width="{StaticResource PageSidebarWidth}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="20,20,20,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Aplicativos instalados"
                                   Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.Column="1"
                                    Width="220"
                                    Margin="0,0,12,0"
                                    PlaceholderText="Pesquisar aplicativos..."
                                    Icon="Search24"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="SearchBox_TextChanged" />
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Orientation="Horizontal">
                            <ToggleButton x:Name="GridViewToggleButton"
                                          IsChecked="True"
                                          Padding="8,4"
                                          Margin="0,0,4,0"
                                          Click="GridViewToggleButton_Click"
                                          ToolTip="Visualização em cartões">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="18" />
                            </ToggleButton>
                            <ToggleButton x:Name="ListViewToggleButton"
                                          Padding="8,4"
                                          Margin="0,0,12,0"
                                          Click="ListViewToggleButton_Click"
                                          ToolTip="Visualização em lista">
                                <ui:SymbolIcon Symbol="List24" FontSize="18" />
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedCount, StringFormat={}Selecionados: {0}}"
                                       Style="{StaticResource CardSubtitleStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <ui:Button Content="Selecionar todos"
                                       Click="ToggleSelectAll_Click"
                                       Padding="8,4"
                                       Margin="0,0,8,0" />
                            <ui:Button Content="Atualizar"
                                       Click="Refresh_Click"
                                       Padding="8,4">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="GridViewScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True">
                            <ItemsControl ItemsSource="{Binding Packages}" ItemTemplate="{StaticResource InstalledGridTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <ListView x:Name="ListViewScrollViewer"
                                  Visibility="Collapsed"
                                  ItemsSource="{Binding Packages}"
                                  ItemTemplate="{StaticResource InstalledListTemplate}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Visibility" Value="{Binding IsSearchMatch, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsInitialLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="34"
                                             Height="34"
                                             HorizontalAlignment="Center" />
                            <TextBlock Text="Carregando pacotes instalados…"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="Box24"
                                           FontSize="40"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Nenhum pacote instalado encontrado."
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="ErrorCircle24"
                                           FontSize="34"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{Binding Status}"
                                       TextWrapping="Wrap"
                                       MaxWidth="520"
                                       TextAlignment="Center"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <ui:SymbolIcon Symbol="DataPie24"
                                           FontSize="20"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Resumo"
                                       Style="{StaticResource CardTitleStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding VisibleCount}"
                                   FontSize="48"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Aplicativos instalados"
                                   FontSize="16"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Status}"
                                   Style="{StaticResource CardSubtitleStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,24" />
                        <Rectangle Height="1"
                                   Fill="#1AFFFFFF"
                                   Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Selecionados" VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="#1A4CC2FF"
                                    BorderBrush="#334CC2FF"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource OverlayCornerRadius}"
                                    Padding="12,4">
                                <TextBlock Text="{Binding SelectedCount}"
                                           Foreground="#4CC2FF"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <ui:SymbolIcon Symbol="Delete24"
                                           FontSize="20"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Ações rápidas"
                                       Style="{StaticResource CardTitleStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <ui:Button Content="Desinstalar Selecionados"
                                   Height="44"
                                   Appearance="Primary"
                                   HorizontalAlignment="Stretch"
                                   IsEnabled="{Binding CanRemove}"
                                   Click="Remove_Click"
                                   Margin="0,0,0,8">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="4,8,0,0">
            <ui:SymbolIcon Symbol="Info24"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="16"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
            <TextBlock Text="{Binding Status}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
