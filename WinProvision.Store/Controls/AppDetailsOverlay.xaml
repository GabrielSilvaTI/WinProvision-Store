<UserControl x:Class="WinProvision.Store.Controls.AppDetailsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:WinProvision.Store.Converters"
             Focusable="True"
             IsVisibleChanged="AppDetailsOverlay_IsVisibleChanged">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <!--
        Scrim: cobre a janela inteira (ver MainWindow.xaml, onde este controle é
        posicionado com Grid.RowSpan cobrindo TitleBar + NavigationView). Clicar em
        qualquer ponto fora do cartão fecha o painel - não é preciso acertar um botão
        pequeno e integrado ao fluxo visual da janela principal.
    -->
    <Grid x:Name="Scrim"
          Background="#99000000"
          Opacity="0"
          MouseLeftButtonUp="Scrim_MouseLeftButtonUp">

        <!--
            Cartão: intercepta o clique antes que ele borbulhe até o Scrim, então
            clicar dentro do painel (inclusive em espaços vazios, não só nos botões)
            nunca fecha por engano.
        -->
        <Border x:Name="Card"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Width="720"
                MaxWidth="900"
                MaxHeight="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Opacity="0"
                MouseLeftButtonUp="Card_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTransform" Y="12" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  Opacity="0.25"
                                  BlurRadius="40"
                                  ShadowDepth="0" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Cabeçalho: só o título + botão de fechar. O botão tem 40x40 de área
                    de clique de verdade (não um X de poucos pixels dentro do chrome de
                    uma janela) - é o que resolve a reclamação original.
                -->
                <Grid Grid.Row="0" Margin="28,20,20,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Detalhes do aplicativo"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1"
                               x:Name="CloseButton"
                               Style="{StaticResource SmoothControlTransitionStyle}"
                               Appearance="Transparent"
                               Width="40"
                               Height="40"
                               Padding="0"
                               ToolTip="Fechar"
                               Click="CloseButton_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                    </ui:Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="32,8,32,20">
                    <StackPanel>

                        <!--  Cabeçalho do pacote no estilo da página de detalhes do UniGetUI  -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                Padding="20"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="88"
                                        Height="88"
                                        Margin="0,0,20,0"
                                        CornerRadius="{StaticResource OverlayCornerRadius}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Box24"
                                                       FontSize="48"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=AppIcon, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image x:Name="AppIcon"
                                               Stretch="Uniform"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=AppIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppNameText"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap" />
                                    <ui:HyperlinkButton x:Name="PublisherLink"
                                                        Padding="0"
                                                        Margin="0,4,0,0">
                                        <TextBlock x:Name="PublisherLinkText" FontSize="14" />
                                    </ui:HyperlinkButton>
                                    <TextBlock x:Name="PublisherPlainText"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                    <TextBlock x:Name="PackageSourceText"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,7,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="12,8"
                                        VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Tag24"
                                                       FontSize="16"
                                                       Margin="0,0,7,0" />
                                        <TextBlock x:Name="VersionBadgeText"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="Sobre este aplicativo"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <!--  Tags  -->
                        <ItemsControl x:Name="TagsList" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="{StaticResource OverlayCornerRadius}"
                                            Padding="10,4"
                                            Margin="0,0,8,8">
                                        <TextBlock Text="{Binding}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Descrição  -->
                        <TextBlock x:Name="DescriptionText"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   LineHeight="21"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,20" />

                        <TextBlock Text="Informações do pacote"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <!--  Separador  -->
                        <Border Height="1"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                Margin="0,0,0,16" />

                        <!--  Metadados  -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="ID do pacote"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,10" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       x:Name="IdText"
                                       FontSize="12"
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Versão"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       x:Name="VersionText"
                                       FontSize="12"
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       x:Name="SizeLabel"
                                       Text="Tamanho estimado"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       x:Name="SizeText"
                                       FontSize="12"
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Relevância no catálogo"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,10" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       x:Name="ScoreText"
                                       FontSize="12"
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       x:Name="GitHubStarsLabel"
                                       Text="Estrelas no GitHub"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,10" />
                            <StackPanel Grid.Row="4"
                                        Grid.Column="1"
                                        x:Name="GitHubStarsRow"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Star24"
                                               FontSize="14"
                                               Foreground="#FFD700"
                                               Margin="0,0,4,0" />
                                <TextBlock x:Name="GitHubStarsText"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       x:Name="LicenseLabel"
                                       Text="Licença"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <ui:HyperlinkButton Grid.Row="5"
                                                Grid.Column="1"
                                                x:Name="LicenseLink"
                                                Padding="0">
                                <TextBlock x:Name="LicenseLinkText" FontSize="12" />
                            </ui:HyperlinkButton>
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       x:Name="LicensePlainText"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!--  Ações  -->
                <Grid Grid.Row="2" Margin="32,0,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <ui:Button x:Name="AddToCatalogButton"
                                   Style="{StaticResource SmoothControlTransitionStyle}"
                                   Content="Adicionar ao catálogo"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Background="{StaticResource InstallActionBrush}"
                                   MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                                   PressedBackground="{StaticResource InstallActionPressedBrush}"
                                   Foreground="White"
                                   PressedForeground="White"
                                   FontSize="14"
                                   Padding="20,11"
                                   FontWeight="SemiBold"
                                   Click="AddToCatalogButton_Click"
                                   Margin="0,0,10,0" />
                        <ui:Button x:Name="InstallButton"
                                   Style="{StaticResource SmoothControlTransitionStyle}"
                                   Content="Instalar"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Background="{StaticResource InstallActionBrush}"
                                   MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                                   PressedBackground="{StaticResource InstallActionPressedBrush}"
                                   Foreground="White"
                                   PressedForeground="White"
                                   Width="150"
                                   Padding="16,11"
                                   Click="InstallButton_Click" />
                        <ui:Button x:Name="UninstallButton"
                                   Style="{StaticResource SmoothControlTransitionStyle}"
                                   Content="Desinstalar"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Width="150"
                                   Padding="16,11"
                                   Visibility="Collapsed"
                                   Click="UninstallButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <ui:Button x:Name="HomepageButton"
                                   Style="{StaticResource SmoothControlTransitionStyle}"
                                   Content="Página do app"
                                   Appearance="Secondary"
                                   Click="OpenLink_Click"
                                   Margin="0,0,8,0" />
                        <ui:Button x:Name="ReleaseNotesButton"
                                   Style="{StaticResource SmoothControlTransitionStyle}"
                                   Content="Notas de versão"
                                   Appearance="Secondary"
                                   Click="OpenLink_Click"
                                   Margin="0,0,8,0" />
                        <ui:Button x:Name="SelectLocationButton"
                                   Style="{StaticResource SmoothControlTransitionStyle}"
                                   Content="Escolher pasta"
                                   Appearance="Secondary"
                                   ToolTip="Usar um local de instalação personalizado"
                                   Click="SelectLocationButton_Click"
                                   Margin="0,0,8,0"
                                   Padding="12,8" />
                        <ui:Button x:Name="ClearLocationButton"
                                   Style="{StaticResource SmoothControlTransitionStyle}"
                                   Content="Limpar pasta"
                                   Appearance="Secondary"
                                   Visibility="Collapsed"
                                   Click="ClearLocationButton_Click"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
