<UserControl x:Class="WinProvision.Store.Controls.AppDetailsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="True"
             IsVisibleChanged="AppDetailsOverlay_IsVisibleChanged">

    <!-- Scrim: cobre a janela inteira (ver MainWindow.xaml, onde este controle é
         posicionado com Grid.RowSpan cobrindo TitleBar + NavigationView). Clicar em
         qualquer ponto fora do cartão fecha o painel - não é preciso acertar um botão
         pequeno, ao contrário da antiga AppDetailsWindow (janela separada, cujo botão
         de fechar era o botão nativo minúsculo do TitleBar). -->
    <Grid x:Name="Scrim" Background="#99000000" MouseLeftButtonUp="Scrim_MouseLeftButtonUp">

        <!-- Cartão: intercepta o clique antes que ele borbulhe até o Scrim, então
             clicar dentro do painel (inclusive em espaços vazios, não só nos botões)
             nunca fecha por engano. -->
        <Border x:Name="Card"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Width="620" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonUp="Card_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="32" ShadowDepth="0" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho: só o título + botão de fechar. O botão tem 40x40 de área
                     de clique de verdade (não um X de poucos pixels dentro do chrome de
                     uma janela) - é o que resolve a reclamação original. -->
                <Grid Grid.Row="0" Margin="24,18,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Detalhes do pacote" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" x:Name="CloseButton"
                               Appearance="Transparent"
                               Width="40" Height="40" Padding="0"
                               ToolTip="Fechar"
                               Click="CloseButton_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                    </ui:Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,28,16">
                    <StackPanel>

                        <!-- Ícone + Nome + Publisher -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="72" Height="72" Margin="0,0,18,0" CornerRadius="16" ClipToBounds="True">
                                <Image x:Name="AppIcon" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AppNameText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                <ui:HyperlinkButton x:Name="PublisherLink" Padding="0" Margin="0,4,0,0">
                                    <TextBlock x:Name="PublisherLinkText" FontSize="13" />
                                </ui:HyperlinkButton>
                                <TextBlock x:Name="PublisherPlainText" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Tags -->
                        <ItemsControl x:Name="TagsList" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="12" Padding="10,4" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Descrição -->
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,20" />

                        <!-- Separador -->
                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,16" />

                        <!-- Metadados -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID do pacote" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="IdText" FontSize="12" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Versão" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionText" FontSize="12" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SizeLabel" Text="Tamanho estimado" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SizeText" FontSize="12" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Score de relevância" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ScoreText" FontSize="12" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="GitHubStarsLabel" Text="Estrelas no GitHub"
                                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" />
                            <StackPanel Grid.Row="4" Grid.Column="1" x:Name="GitHubStarsRow" Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Star24" FontSize="14" Foreground="#FFD700" Margin="0,0,4,0" />
                                <TextBlock x:Name="GitHubStarsText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" x:Name="LicenseLabel" Text="Licença" FontWeight="SemiBold" FontSize="12" />
                            <ui:HyperlinkButton Grid.Row="5" Grid.Column="1" x:Name="LicenseLink" Padding="0">
                                <TextBlock x:Name="LicenseLinkText" FontSize="12" />
                            </ui:HyperlinkButton>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LicensePlainText" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- Ações -->
                <Grid Grid.Row="2" Margin="28,0,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:Button x:Name="AddToCatalogButton" Content="Adicionar ao catálogo"
                                   Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                   FontSize="14" Padding="20,11" FontWeight="SemiBold"
                                   Click="AddToCatalogButton_Click" Margin="0,0,10,0" />
                        <ui:Button x:Name="InstallButton" Content="Instalar"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Background="{StaticResource InstallActionBrush}"
                                   MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                                   PressedBackground="{StaticResource InstallActionPressedBrush}"
                                   Foreground="White" PressedForeground="White"
                                   Padding="16,11"
                                   Click="InstallButton_Click" />
                        <ui:Button x:Name="OpenButton" Content="Abrir"
                                   Icon="{ui:SymbolIcon Open24}"
                                   Background="{StaticResource InstallActionBrush}"
                                   MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                                   PressedBackground="{StaticResource InstallActionPressedBrush}"
                                   Foreground="White" PressedForeground="White"
                                   Padding="16,11"
                                   Visibility="Collapsed"
                                   Click="OpenButton_Click" Margin="0,0,10,0" />
                        <ui:Button x:Name="UninstallButton" Content="Desinstalar" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Padding="16,11"
                                   Visibility="Collapsed"
                                   Click="UninstallButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <ui:Button x:Name="HomepageButton" Content="Página do app" Appearance="Secondary"
                                   Click="OpenLink_Click" Margin="0,0,8,0" />
                        <ui:Button x:Name="ReleaseNotesButton" Content="Notas de versão" Appearance="Secondary"
                                   Click="OpenLink_Click" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
