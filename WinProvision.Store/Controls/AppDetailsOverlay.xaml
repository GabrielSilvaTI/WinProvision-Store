<UserControl x:Class="WinProvision.Store.Controls.AppDetailsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:WinProvision.Store.Converters"
             Focusable="True"
             IsVisibleChanged="AppDetailsOverlay_IsVisibleChanged">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="RowValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="InlineLinkStyle" TargetType="ui:HyperlinkButton">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MouseOverBackground" Value="Transparent" />
            <Setter Property="MouseOverBorderBrush" Value="Transparent" />
            <Setter Property="PressedBackground" Value="Transparent" />
            <Setter Property="PressedBorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#4CC2FF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:HyperlinkButton">
                        <Border Background="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#70D0FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Scrim cobrindo a janela inteira -->
    <Grid x:Name="Scrim"
          Background="#99000000"
          Opacity="0"
          MouseLeftButtonUp="Scrim_MouseLeftButtonUp">

        <!-- Painel de detalhes do WinProvision Store -->
        <Border x:Name="Card"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinWidth="760"
                MaxWidth="1040"
                MaxHeight="820"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Opacity="0"
                MouseLeftButtonUp="Card_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTransform" Y="12" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="40" ShadowDepth="0" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ── Top bar: título do diálogo + botão fechar ── -->
                <Grid Grid.Row="0" Margin="22,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Detalhes do pacote"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <ui:Button Grid.Column="1"
                               x:Name="CloseButton"
                               Appearance="Transparent"
                               Width="32" Height="32"
                               Padding="0"
                               ToolTip="Fechar (Esc)"
                               Click="CloseButton_Click">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ui:Button>
                </Grid>

                <!-- Barra de carregamento superior enquanto busca os dados estendidos -->
                <ProgressBar Grid.Row="1"
                             x:Name="LoadingProgressBar"
                             IsIndeterminate="True"
                             Height="2"
                             Visibility="Collapsed" />

                <!-- ── Conteúdo rolável em duas colunas ── -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,6,24,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ═══════════════════ COLUNA ESQUERDA ═══════════════════ -->
                        <StackPanel Grid.Column="0">

                            <!-- Cabeçalho: Ícone + Título + Gerenciador de Pacotes -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Ícone do pacote -->
                                <Border Grid.Column="0"
                                        Width="68" Height="68"
                                        CornerRadius="16"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,16,0"
                                        ClipToBounds="True">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Box24" FontSize="36"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=AppIcon, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <Image x:Name="AppIcon"
                                               Width="56" Height="56"
                                               Stretch="Uniform"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=AppIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppNameText"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               LineHeight="38"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="PackageSourceText"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Tags do pacote -->
                            <ItemsControl x:Name="TagsList" Margin="0,0,0,14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                CornerRadius="12"
                                                Padding="10,3"
                                                Margin="0,0,6,6"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="11.5"
                                                       Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Descrição direta sem bordas de cartão pesadas -->
                            <TextBlock x:Name="DescriptionText"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="20"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,18" />

                            <!-- Comparação de versão (quando atualização disponível) -->
                            <Border x:Name="UpdateVersionPanel"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Versão instalada" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="CurrentUpdateVersionText" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" FontSize="16"
                                                   VerticalAlignment="Center" Margin="10,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nova versão" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="AvailableUpdateVersionText" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Metadados principais do pacote -->
                            <StackPanel Margin="0,0,0,20">

                                <!-- Página Inicial -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="Página Inicial:" Style="{StaticResource RowLabelStyle}" />
                                    <ui:HyperlinkButton x:Name="HomepageLink"
                                                        Style="{StaticResource InlineLinkStyle}"
                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="HomepageLinkText"
                                                   Foreground="#4CC2FF"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </ui:HyperlinkButton>
                                    <TextBlock x:Name="HomepageNotAvailableText"
                                               Text="Não disponível"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               FontSize="13"
                                               Visibility="Collapsed" />
                                </WrapPanel>

                                <!-- Desenvolvedor -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="Desenvolvedor:" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="DeveloperText" Style="{StaticResource RowValueStyle}" />
                                </WrapPanel>

                                <!-- Autor -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="Autor:" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="AuthorText" Style="{StaticResource RowValueStyle}" />
                                </WrapPanel>

                                <!-- Licença -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="Licença:" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="LicenseText" Style="{StaticResource RowValueStyle}" Margin="0,0,6,0" />
                                    <ui:HyperlinkButton x:Name="LicenseLink"
                                                        Style="{StaticResource InlineLinkStyle}"
                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="LicenseLinkText"
                                                   Foreground="#4CC2FF"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </ui:HyperlinkButton>
                                </WrapPanel>

                                <!-- Última atualização -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="Última atualização:" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="LastUpdatedText" Style="{StaticResource RowValueStyle}" />
                                </WrapPanel>

                                <!-- Gerenciador de pacotes -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="Gerenciador de pacotes:" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="PackageManagerText" Style="{StaticResource RowValueStyle}" />
                                </WrapPanel>

                            </StackPanel>

                            <!-- Ações do pacote -->
                            <StackPanel Margin="0,0,0,14">

                                <Grid HorizontalAlignment="Left">

                                    <!-- Ação padrão: Instalar (Split Button) -->
                                    <Grid x:Name="InstallSplitGroup" Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Grid.Column="0"
                                                   x:Name="InstallButton"
                                                   Content="Instalar"
                                                   Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   Foreground="White"
                                                   Height="36"
                                                   Padding="22,0"
                                                   CornerRadius="6,0,0,6"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Click="InstallButton_Click" />

                                        <ui:Button Grid.Column="1"
                                                   x:Name="InstallChevronButton"
                                                   Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   Foreground="White"
                                                   Height="36"
                                                   Width="32"
                                                   Padding="0"
                                                   BorderThickness="1,0,0,0"
                                                   BorderBrush="#33FFFFFF"
                                                   CornerRadius="0,6,6,0"
                                                   ToolTip="Opções adicionais de instalação"
                                                   Click="InstallChevronButton_Click">
                                            <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" />
                                        </ui:Button>
                                    </Grid>
                                    <!-- Atualizar -->
                                    <ui:Button x:Name="UpdateButton"
                                               Content="Atualizar"
                                               Appearance="Primary"
                                               Height="36"
                                               Padding="22,0"
                                               CornerRadius="6"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Visibility="Collapsed"
                                               Click="UpdateButton_Click" />

                                    <!-- Desinstalar e opções para apps já instalados -->
                                    <Grid x:Name="UninstallSplitGroup" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0"
                                                   x:Name="UninstallButton"
                                                   Content="Desinstalar"
                                                   Appearance="Secondary"
                                                   Height="36"
                                                   Padding="22,0"
                                                   CornerRadius="6,0,0,6"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Click="UninstallButton_Click" />
                                        <ui:Button Grid.Column="1"
                                                   x:Name="UninstallChevronButton"
                                                   Appearance="Secondary"
                                                   Height="36"
                                                   Width="32"
                                                   Padding="0"
                                                   Margin="1,0,0,0"
                                                   CornerRadius="0,6,6,0"
                                                   ToolTip="Mais opções"
                                                   Click="UninstallChevronButton_Click">
                                            <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" />
                                        </ui:Button>
                                    </Grid>
                                </Grid>

                                <!-- Status / feedback inline -->
                                <TextBlock x:Name="StatusText"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- ── Barra retrátil "Opções de instalação" com botão [ Salvar ] ── -->
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Header da barra -->
                                    <Grid Margin="12,8"
                                          Cursor="Hand"
                                          MouseLeftButtonUp="OptionsHeader_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Grid.Column="0"
                                                       Symbol="Options24"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="Opções de instalação"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <ui:Button Grid.Column="2"
                                                   x:Name="SaveOptionsButton"
                                                   Content="Salvar"
                                                   Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   Foreground="White"
                                                   CornerRadius="5"
                                                   Height="26"
                                                   Padding="14,0"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Margin="0,0,8,0"
                                                   Click="SaveOptionsButton_Click" />

                                        <ui:SymbolIcon Grid.Column="3"
                                                       x:Name="OptionsChevronIcon"
                                                       Symbol="ChevronDown16"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Corpo expansível -->
                                    <StackPanel x:Name="OptionsBodyPanel"
                                                Visibility="Collapsed"
                                                Margin="14,0,14,14">
                                        <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,10" />

                                        <CheckBox x:Name="InstallAllUsersCheckBox"
                                                  Content="Instalar para todos os usuários"
                                                  Margin="0,0,0,8"
                                                  FontSize="12.5" />

                                        <CheckBox x:Name="SkipHashCheckCheckBox"
                                                  Content="Pular verificação de integridade (hash)"
                                                  Margin="0,0,0,10"
                                                  FontSize="12.5" />

                                        <WrapPanel VerticalAlignment="Center">
                                            <ui:Button x:Name="SelectLocationButton"
                                                       Content="Escolher pasta..."
                                                       Appearance="Secondary"
                                                       Padding="10,5"
                                                       FontSize="12"
                                                       Click="SelectLocationButton_Click"
                                                       Margin="0,0,8,0" />
                                            <TextBlock x:Name="SelectedLocationText"
                                                       Text="Local padrão do sistema"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="220" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ═══════════════════ COLUNA DIREITA ═══════════════════ -->
                        <StackPanel Grid.Column="2">
<!-- Metadados detalhados do pacote -->
                            <StackPanel>

                                <!-- ID do Pacote -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="ID do Pacote:" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="PackageIdText" Style="{StaticResource RowValueStyle}" />
                                </WrapPanel>

                                <!-- Manifesto -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="Manifesto:" Style="{StaticResource RowLabelStyle}" />
                                    <ui:HyperlinkButton x:Name="ManifestLink"
                                                        Style="{StaticResource InlineLinkStyle}"
                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="ManifestLinkText"
                                                   Foreground="#4CC2FF"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </ui:HyperlinkButton>
                                </WrapPanel>

                                <!-- Versão -->
                                <WrapPanel Margin="0,0,0,14">
                                    <TextBlock Text="Versão:" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="PackageVersionText" Style="{StaticResource RowValueStyle}" />
                                </WrapPanel>

                                <!-- Tipo de Instalador -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="Tipo de Instalador:" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="InstallerTypeText" Style="{StaticResource RowValueStyle}" />
                                </WrapPanel>

                                <!-- URL do Instalador -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="URL do Instalador :" Style="{StaticResource RowLabelStyle}" />
                                    <ui:HyperlinkButton x:Name="InstallerUrlLink"
                                                        Style="{StaticResource InlineLinkStyle}"
                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="InstallerUrlLinkText"
                                                   Foreground="#4CC2FF"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </ui:HyperlinkButton>
                                </WrapPanel>

                                <!-- SHA256 do Instalador -->
                                <TextBlock Text="SHA256 do Instalador:" Style="{StaticResource RowLabelStyle}" Margin="0,0,0,2" />
                                <TextBlock x:Name="Sha256Text"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />

                                <!-- Baixar instalador + tamanho -->
                                <WrapPanel Margin="0,0,0,14">
                                    <ui:HyperlinkButton x:Name="DownloadInstallerLink"
                                                        Style="{StaticResource InlineLinkStyle}"
                                                        Click="OpenLink_Click"
                                                        Margin="0,0,6,0">
                                        <TextBlock Text="Baixar instalador"
                                                   Foreground="#4CC2FF"
                                                   TextDecorations="Underline" />
                                    </ui:HyperlinkButton>
                                    <TextBlock x:Name="InstallerSizeText"
                                               Text="(Tamanho desconhecido)"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </WrapPanel>

                                <!-- Dependências -->
                                <TextBlock Text="Dependências:" Style="{StaticResource RowLabelStyle}" Margin="0,0,0,2" />
                                <TextBlock x:Name="DependenciesText"
                                           Text="Nenhuma dependência especificada"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />

                                <!-- Notas de lançamento -->
                                <TextBlock Text="Notas de lançamento:" Style="{StaticResource RowLabelStyle}" Margin="0,0,0,2" />
                                <TextBlock x:Name="ReleaseNotesText"
                                           Text="Não disponível"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />

                                <!-- URL das notas de lançamento -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock Text="URL das notas de lançamento:" Style="{StaticResource RowLabelStyle}" />
                                    <ui:HyperlinkButton x:Name="ReleaseNotesUrlLink"
                                                        Style="{StaticResource InlineLinkStyle}"
                                                        Visibility="Collapsed"
                                                        Click="OpenLink_Click">
                                        <TextBlock x:Name="ReleaseNotesUrlLinkText"
                                                   Foreground="#4CC2FF"
                                                   TextDecorations="Underline"
                                                   TextWrapping="Wrap" />
                                    </ui:HyperlinkButton>
                                    <TextBlock x:Name="ReleaseNotesUrlNotAvailableText"
                                               Text="Não disponível"
                                               FontStyle="Italic"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </WrapPanel>

                            </StackPanel>

                        </StackPanel>

                    </Grid>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</UserControl>
