<UserControl x:Class="WinProvision.Store.Controls.OperationsQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:WinProvision.Store.Converters"
             xmlns:models="clr-namespace:WinProvision.Core.Models;assembly=WinProvision.Core"
             x:Name="Root"
             MaxHeight="290"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WinProvision.Store;component/Styles/VisualPolish.xaml" />
                <ResourceDictionary Source="/WinProvision.Store;component/Styles/GradientProgressBar.xaml" />
                <ResourceDictionary Source="/WinProvision.Store;component/Styles/InstallActionBrushes.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NotFinishedToVisibilityConverter x:Key="NotFinishedToVisibilityConverter" />
            <conv:FinishedToVisibilityConverter x:Key="FinishedToVisibilityConverter" />
            <conv:OperationStateToBrushConverter x:Key="OperationStateToBrushConverter" />
            <conv:OperationStateToBrushMultiConverter x:Key="OperationStateToBrushMultiConverter" />
            <conv:OperationStateToTextConverter x:Key="OperationStateToTextConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.25"
                              BlurRadius="32"
                              ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  CABEÇALHO  -->
            <ToggleButton x:Name="ExpanderToggle"
                          Grid.Row="0"
                          IsChecked="True"
                          Cursor="Hand">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="4,2,4,2" Background="Transparent" Height="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon x:Name="Chevron"
                                               Grid.Column="0"
                                               Symbol="ChevronDown24"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Opacity="0.65">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} de {1} operações concluídas">
                                            <Binding Path="Queue.CompletedCount" ElementName="Root" />
                                            <Binding Path="Queue.TotalCount" ElementName="Root" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <ui:Button Grid.Column="2"
                                           HorizontalAlignment="Right"
                                           Margin="0"
                                           Appearance="Transparent"
                                           Padding="6"
                                           Icon="{ui:SymbolIcon Broom24}"
                                           Click="ClearFinished_Click" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Chevron" Property="Symbol" Value="ChevronUp24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <!--  LISTA DE OPERAÇÕES  -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="252"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsChecked, ElementName=ExpanderToggle, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Queue.Operations, ElementName=Root}"
                              Margin="10,5,10,7">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8"
                                    Margin="0,3"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    Background="{DynamicResource AcrylicSurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  ÍCONE  -->
                                    <Border Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="5"
                                            Background="{DynamicResource AppSurfaceBrush}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="Box24"
                                                           FontSize="20"
                                                           Opacity="0.55"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OperationImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                            <Image x:Name="OperationImage"
                                                   Stretch="Uniform"
                                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OperationImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>

                                    <!--  TÍTULO + STATUS + PROGRESSO  -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding OperationTitle, Mode=OneWay}" />
                                        </TextBlock>

                                        <!--  Enquanto está em andamento: linha de status + barra em degradê  -->
                                        <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource NotFinishedToVisibilityConverter}}">
                                            <TextBlock Text="{Binding UserFacingStatusText}"
                                                       FontSize="11.5"
                                                       Opacity="0.78"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,5" />
                                        </StackPanel>

                                        <!--  Quando termina: resumo colorido no lugar da barra  -->
                                        <TextBlock Margin="0"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Visibility="{Binding IsFinished, Converter={StaticResource FinishedToVisibilityConverter}}"
                                                   >
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource OperationStateToBrushMultiConverter}">
                                                    <Binding Path="State" />
                                                    <Binding Path="Method" />
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                            <TextBlock.Text>
                                                <Binding Path="UserFacingStatusText" />
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <!-- A barra permanece visível após a conclusão, como no painel do UniGetUI. -->
                                        <ProgressBar Style="{StaticResource GradientProgressBarStyle}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Foreground="{Binding Method, Converter={StaticResource WingetMethodBrushConverter}}"
                                                     Height="4"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     conv:AnimatedProgress.Percent="{Binding Progress, Mode=OneWay}" />
                                    </StackPanel>

                                    <!--  CANCELAR  -->
                                    <ui:Button Grid.Column="2"
                                               Content="Cancelar"
                                               Appearance="Secondary"
                                               FontSize="11.5"
                                               Padding="10,5"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsFinished, Converter={StaticResource NotFinishedToVisibilityConverter}}"
                                               Command="{Binding CancelCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
