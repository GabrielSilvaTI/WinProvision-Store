<UserControl x:Class="WinProvision.Store.Controls.OperationsQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:WinProvision.Store.Converters"
             xmlns:models="clr-namespace:WinProvision.Core.Models;assembly=WinProvision.Core"
             x:Name="Root"
             MaxHeight="340"
             HorizontalAlignment="Stretch"
             PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:NotFinishedToVisibilityConverter x:Key="NotFinishedToVisibilityConverter" />
            <conv:FinishedToVisibilityConverter x:Key="FinishedToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Effect="{DynamicResource StoreCardShadowEffect}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="44"
                  Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Chevron de alternância (▼ / ▲) -->
                <ToggleButton x:Name="ExpanderToggle"
                              Grid.Column="0"
                              Width="32"
                              Height="32"
                              Padding="0"
                              IsChecked="True"
                              Cursor="Hand"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTip="Expandir ou recolher operações"
                              AutomationProperties.Name="Expandir ou recolher operações"
                              FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent"
                                    CornerRadius="{StaticResource CompactCornerRadius}"
                                    x:Name="ToggleBorder">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="ChevronIcon"
                                                   Symbol="ChevronDown24"
                                                   FontSize="12"
                                                   Opacity="0.75" />
                                    <!-- Badge vermelho se recolhido e houver falha -->
                                    <Rectangle x:Name="FailedBadge"
                                             Width="6"
                                             Height="6"
                                             Fill="{DynamicResource AppOperationFailureBrush}"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,-2,-2,0"
                                             Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="ChevronIcon" Property="Symbol" Value="ChevronUp24" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False" />
                                        <Condition Binding="{Binding Queue.HasFailedOperations, ElementName=Root}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="FailedBadge" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <TextBlock Grid.Column="1"
                           Text="{Binding Queue.HeaderText, ElementName=Root}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,0,8,0" />

                <!-- Menu de operações em massa (...) -->
                <ui:Button x:Name="BulkMenuButton"
                           Grid.Column="2"
                           Style="{StaticResource StoreActionButtonStyle}"
                           Width="34"
                           Height="34"
                           Padding="0"
                           Margin="0,0,4,0"
                           Appearance="Transparent"
                           Background="Transparent"
                           BorderThickness="0"
                           ToolTip="Mais ações da fila"
                           AutomationProperties.Name="Mais ações da fila"
                           Click="BulkMenuButton_Click">
                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" />
                </ui:Button>

                <ui:Button Grid.Column="3"
                           Style="{StaticResource StoreActionButtonStyle}"
                           Width="34"
                           Height="34"
                           Padding="0"
                           Appearance="Transparent"
                           Background="Transparent"
                           BorderThickness="0"
                           ToolTip="Fechar painel de operações"
                           AutomationProperties.Name="Fechar painel de operações"
                           Click="ClosePanelButton_Click">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                </ui:Button>
            </Grid>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- ── LISTA DE OPERAÇÕES ── -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="280"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=ExpanderToggle, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Queue.Operations, ElementName=Root}"
                              Margin="10,8,10,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    Background="{DynamicResource AppCardBackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Coluna 0: ícone do pacote ou do aplicativo -->
                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="28"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="{StaticResource CompactCornerRadius}"
                                            Background="Transparent"
                                            ClipToBounds="True">
                                        <Grid>
                                            <!-- A cor do ícone acompanha o método atual. -->
                                            <ui:SymbolIcon Symbol="Box24"
                                                           FontSize="22"
                                                           Foreground="{Binding Method, Converter={StaticResource WingetMethodBrushConverter}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OperationImage, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            <!-- Imagem personalizada se houver -->
                                            <Image x:Name="OperationImage"
                                                   Stretch="Uniform"
                                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=OperationImage, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <!-- Coluna 1: Título, LiveLine e Barra de Progresso Fina -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">

                                        <!-- Título da Operação: ex. "Atualizando Boto3..." -->
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- LiveLine (Log ou mensagem ao vivo): clicável para ver terminal -->
                                        <Button Margin="0,2,0,0"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Clique para ver os detalhes da saída no terminal"
                                                Click="LiveLineButton_Click"
                                                Tag="{Binding}">
                                            <TextBlock Text="{Binding LiveLine}"
                                                       FontSize="11"
                                                       Opacity="0.75"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>

                                        <!-- Barra de progresso fina, colorida pelo método atual. -->
                                        <ProgressBar x:Name="OperationProgress"
                                                     Style="{StaticResource GradientProgressBarStyle}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Foreground="{Binding Method, Converter={StaticResource WingetMethodBrushConverter}}"
                                                     Height="3"
                                                     Margin="0,4,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     conv:AnimatedProgress.Percent="{Binding Progress, Mode=OneWay}"
                                                     Visibility="{Binding IsFinished, Converter={StaticResource NotFinishedToVisibilityConverter}}" />

                                        <!-- Badge de Status após Finalizar -->
                                        <Border x:Name="StatusBadge"
                                                Margin="0,4,0,0"
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                CornerRadius="{StaticResource CompactCornerRadius}"
                                                Background="{DynamicResource AppOperationSuccessSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding IsFinished, Converter={StaticResource FinishedToVisibilityConverter}}">
                                            <TextBlock x:Name="StatusText"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppOperationSuccessBrush}"
                                                       Text="{Binding UserFacingStatusText}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Coluna 2: Fused Split Button [ Cancelar / Fechar | ⋯ ] -->
                                    <Border Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Height="28"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            ClipToBounds="True">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Ação Principal: Cancelar (enquanto roda) ou Fechar (concluído) -->
                                            <ui:Button Content="{Binding ButtonText}"
                                                       Command="{Binding ActionCommand}"
                                                       CornerRadius="0"
                                                       Height="28"
                                                       Padding="12,0"
                                                       FontSize="12"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       VerticalAlignment="Stretch"
                                                       VerticalContentAlignment="Center"
                                                       ToolTip="Ação da operação" />

                                            <!-- Divisor vertical sutil -->
                                            <Rectangle Width="1"
                                                       VerticalAlignment="Stretch"
                                                       Fill="{DynamicResource AppBorderSubtleBrush}" />

                                            <!-- Botão de Opções (...) para este item -->
                                            <ui:Button Width="28"
                                                       Height="28"
                                                       CornerRadius="0"
                                                       Padding="0"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       VerticalAlignment="Stretch"
                                                       VerticalContentAlignment="Center"
                                                       HorizontalContentAlignment="Center"
                                                       ToolTip="Mais opções desta operação"
                                                       Click="ItemMoreButton_Click"
                                                       Tag="{Binding}">
                                                <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:OperationState.Failed}">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource AppOperationFailureSurfaceBrush}" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource AppOperationFailureBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static models:OperationState.Canceled}">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource AppOperationCanceledSurfaceBrush}" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource AppOperationCanceledBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── OVERLAY MODAL: SAÍDA / LOG DO TERMINAL ── -->
            <Grid x:Name="OutputModalHost"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Background="#A0000000"
                  Visibility="Collapsed">
                <Border Margin="12"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource AppCardBorderBrush}"
                        Background="{DynamicResource AppSurfaceBrush}">
                    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
                        <!-- Topo: Título + Botão de Fechar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="WindowConsole20" FontSize="18" Margin="0,0,8,0" />
                                <TextBlock x:Name="OutputModalTitle"
                                           Text="Saída da Operação"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Style="{StaticResource StoreActionButtonStyle}"
                                       Appearance="Transparent"
                                       Padding="6"
                                       ToolTip="Fechar saída da operação"
                                       AutomationProperties.Name="Fechar saída da operação"
                                       Click="CloseOutputModal_Click">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                            </ui:Button>
                        </Grid>

                        <!-- Centro: Console / Log text com fonte monoespaçada -->
                        <Border Grid.Row="1"
                                CornerRadius="{StaticResource CompactCornerRadius}"
                                Background="{DynamicResource AppWindowBackgroundBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppBorderSubtleBrush}">
                            <TextBox x:Name="OutputModalTextBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12" />
                        </Border>

                        <!-- Rodapé: Ações Copiar e Fechar -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Copiar log"
                                           Style="{StaticResource StoreActionButtonStyle}"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           Click="CopyOutputLog_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Copy24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="Fechar"
                                           Style="{StaticResource StoreActionButtonStyle}"
                                           Appearance="Primary"
                                           Click="CloseOutputModal_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
