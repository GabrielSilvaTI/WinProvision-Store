<UserControl x:Class="WinProvision.Store.Controls.StageItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:WinProvision.Store.Converters"
             FontFamily="{DynamicResource StoreFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border CornerRadius="{StaticResource StoreCardCornerRadius}"
            Padding="20,16"
            MinHeight="88"
            BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                        <Setter Property="Background" Value="{DynamicResource FluentAccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource InstallActionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="CompletedWithWarnings">
                        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Number}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />

            <Border Grid.Column="1"
                    Width="44"
                    Height="44"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1">
                <!--
                    Fundo do badge é neutro e igual para as 4 fases (padronização pedida) —
                    só o símbolo muda por fase, e só a cor/preenchimento do símbolo muda
                    por status (ver Converters/StageIconConverters.cs).
                -->
                <ui:SymbolIcon FontSize="21"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Symbol="{Binding Stage, Converter={StaticResource StageToSymbolConverter}}"
                               Filled="{Binding Status, Converter={StaticResource StageStatusToFilledConverter}}"
                               Foreground="{Binding Status, Converter={StaticResource StageStatusToIconForegroundConverter}}" />
            </Border>

            <Grid Grid.Column="2"
                  Margin="15,0,20,0"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           FontSize="15.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Grid.Row="1"
                           Text="{Binding Description}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="2"
                           Text="{Binding CurrentDetail}"
                           FontSize="11"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <!--
                        Mesmo estilo de barra usado nas operações isoladas da Store
                        (GradientProgressBarStyle): degrade com shimmer, tanto no modo
                        indeterminado (nenhum item da etapa concluído ainda) quanto no
                        determinado (preenchimento em degraus — 1 item concluído / total
                        de itens da etapa, ver AutoStageViewModel.IsIndeterminate).
                    -->
                    <ProgressBar Style="{StaticResource GradientProgressBarStyle}"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 conv:AnimatedProgress.Percent="{Binding Progress}" />
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,17,0">
                <TextBlock Text="{Binding ExecutionTime}"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ProgressText}"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Right"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Column="4"
                  Width="30"
                  Height="30"
                  VerticalAlignment="Center">
                <!--
                    Com a barra de progresso já cobrindo o andamento (Pending/InProgress),
                    este círculo agora é só o indicador final do resultado da etapa —
                    ProcessRing removido; sem conteúdo nenhum enquanto não há um resultado.
                -->
                <Ellipse Width="29"
                         Height="29"
                         Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                         StrokeThickness="1.5" />
                <ContentControl Width="29" Height="29">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                                           FontSize="28"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="CompletedWithWarnings">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ui:SymbolIcon Symbol="ErrorCircle24"
                                                           FontSize="28"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ui:SymbolIcon Symbol="DismissCircle24"
                                                           FontSize="28"
                                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
