<Page x:Class="WinProvision.Store.StoreStatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Status da Store"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      UseLayoutRounding="True">
    <Grid Margin="{StaticResource PageContentMargin}"
          MaxWidth="{StaticResource PageContentMaxWidth}"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource PageHeaderMargin}">
            <Border Style="{StaticResource PageHeaderIconTileStyle}">
                <ui:SymbolIcon Symbol="Info24" Style="{StaticResource PageHeaderSymbolIconStyle}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WinProvision Store Status" Style="{StaticResource FluentPageTitleStyle}" />
                <TextBlock Text="Estado do WinGet, dos catálogos da API e do cache local."
                           Style="{StaticResource FluentPageSubtitleStyle}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,16" MinHeight="36">
            <TextBlock x:Name="LastCheckedText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Ainda não verificado" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CopyButton"
                           Content="Copiar diagnóstico"
                           Style="{StaticResource StoreActionButtonStyle}"
                           Click="CopyButton_Click"
                           IsEnabled="False"
                           Margin="0,0,8,0" />
                <ui:Button x:Name="RefreshButton"
                           Content="Verificar novamente"
                           Style="{StaticResource StoreActionButtonStyle}"
                           Appearance="Primary"
                           Click="RefreshButton_Click" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource StoreCardSurfaceStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Box24" Width="24" Height="24" Margin="0,2,16,0"
                                       Foreground="{DynamicResource AppIconBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="WinGet" Style="{StaticResource FluentCardTitleStyle}" />
                            <TextBlock x:Name="WingetStatusText" Text="Aguardando verificação"
                                       FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock x:Name="WingetVersionText" Text="Versão: —" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="WingetSourcesText" Text="Fontes: —" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="WingetDetailText" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Catálogos da API" Style="{StaticResource PageSectionHeaderStyle}" Margin="0,0,0,12" />
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource StoreCardSurfaceStyle}" Margin="0,0,8,16">
                        <StackPanel>
                            <TextBlock Text="WinGet" Style="{StaticResource FluentCardTitleStyle}" />
                            <TextBlock x:Name="WingetApiStatusText" Text="Aguardando verificação" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock x:Name="WingetApiDetailsText" Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StoreCardSurfaceStyle}" Margin="8,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Microsoft Store" Style="{StaticResource FluentCardTitleStyle}" />
                            <TextBlock x:Name="MsStoreApiStatusText" Text="Aguardando verificação" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock x:Name="MsStoreApiDetailsText" Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource StoreCardSurfaceStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Database24" Width="24" Height="24" Margin="0,2,16,0"
                                       Foreground="{DynamicResource AppIconBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cache local da API" Style="{StaticResource FluentCardTitleStyle}" />
                            <TextBlock x:Name="CacheStatusText" Text="Aguardando verificação" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock x:Name="CacheDetailsText" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
