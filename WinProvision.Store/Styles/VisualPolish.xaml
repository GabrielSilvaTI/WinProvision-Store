<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Visual language: dark Mica, restrained glass surfaces and Fluent accents. -->
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppSurfaceStrongBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#BCC5D2" />
    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#8793A5" />
    <SolidColorBrush x:Key="AppIconBrush" Color="#DDE7F5" />
    <SolidColorBrush x:Key="AppIconMutedBrush" Color="#91A0B5" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#4AA3FF" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#264AA3FF" />

    <!-- Superfície comum dos cartões: translúcida para preservar o efeito Mica e
         adaptável aos temas claro/escuro do WPF-UI. -->
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#1FFFFFFF" />

    <!-- Sem isso, o WPF usa o modo padrão de reamostragem de bitmap (que prioriza
         velocidade, não qualidade) pra reduzir os ícones — que chegam em alta resolução
         (o .ico do winget costuma trazer até 256x256, ver IconBitmapDecoder em
         Converters/AsyncImage.cs) até o tamanho pequeno exibido nas listas (24-64px). O
         resultado é serrilhado/blocado, mais perceptível em ícones com bordas finas ou
         curvas. HighQuality troca pra um reamostrador bicúbico — mesmo efeito de nitidez
         que o Explorer do Windows usa pra miniaturas. Implícito (sem x:Key), então cobre
         toda Image do app automaticamente, sem precisar tocar em cada .xaml. -->
    <Style TargetType="Image">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- WPF-UI's SymbolIcon is a FontIcon; color it consistently instead of leaving
         individual pages with mismatched white/blue glyphs. Explicit Foreground values
         on action buttons still win when an accent icon is intentional.

         Sem x:Key, este Style é IMPLÍCITO e substitui por completo o Style padrão que o
         próprio WPF-UI registra pra ui:SymbolIcon (mesmo mecanismo que apagava o
         Foreground correto dos títulos — ver PageTitleStyle/CardTitleStyle nas páginas).
         Sem um Foreground aqui, o Foreground herdado (propriedade de dependência
         "inherited") cai no valor padrão do WPF (preto), em vez do branco/tema que o
         WPF-UI usaria. Usa TextFillColorPrimaryBrush — o mesmo token (reage a Dark/Light
         automaticamente) usado no Foreground global de TextBlock logo abaixo — em vez do
         AppIconBrush definido no topo deste arquivo: aquele é uma cor fixa (#DDE7F5, quase-
         branca sempre) que sofreria exatamente do mesmo problema já corrigido pro texto
         (sumiria no tema Claro, ver comentário no Style de TextBlock). -->
    <Style TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Opacity" Value="0.94" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SelectAllButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ComboBoxItem (o item individual dentro da lista suspensa de qualquer ComboBox
         puro do app — Tema/Barra de tarefas/Busca/Região/Plano de energia em
         Provisionamento, Categoria/Plano/Canal/Arquitetura/Idioma no Office, guias em
         Pacotes) não tinha estilo próprio em lugar nenhum do app. Sem isso, o item cai no
         template padrão do WPF, cujo texto sai no preto/cinza-escuro clássico do Windows
         (SystemColors.ControlTextBrush) em vez de acompanhar o tema escuro — feio e
         difícil de ler contra o popup translúcido/com blur (a legibilidade varia com o
         que está atrás, dando a impressão de mudar "com o ângulo"). Aqui força o mesmo
         token de texto usado no resto do app (branco/quase-branco no tema Dark, preto no
         Light — sempre correto pro tema atual) e um destaque sutil de fundo ao passar o
         mouse/selecionar, usando os brushes de vidro já definidos acima. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="4,1" />
        <!-- Template próprio (em vez de só sobrescrever Background/Foreground em
             cima do template padrão) porque o template padrão do ComboBoxItem é um
             Border sem CornerRadius exposto — dava um retângulo de destaque
             encostado nas duas bordas, o "quadradão" clássico do Win10. Aqui o
             destaque é um Border arredondado com respiro nas laterais (Margin no
             ComboBoxItem, Padding no Border interno), igual ao recorte de item de
             menu que o próprio app já usa no mock do menu de contexto do Win11
             (ver Win11MenuItemStyle em ProvisioningPage.xaml). -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Margin="{TemplateBinding Margin}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppSurfaceStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sem Background/Foreground explícitos aqui, o ToolTip usava o chrome claro padrão
         do Windows (fundo branco) + o Foreground quase-branco herdado do Style global de
         TextBlock acima (usado pelo TextBlock interno que o WPF gera pra um ToolTip de
         string simples) — texto branco sobre fundo branco, ilegível no tema Escuro. Aqui
         fixamos os mesmos tokens do WPF-UI/Fluent usados no resto do app (superfície e
         texto primário), que já reagem à troca de tema em runtime. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
</ResourceDictionary>
