<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:conv="clr-namespace:WinProvision.Store.Converters">

    <!--
        Barra de progresso com degradê animado ("dinâmico"), no lugar da barra amarela
        sólida do UnigetUI. Dois modos, controlados pela propriedade padrão IsIndeterminate:
        
        - IsIndeterminate = True  -> uma faixa de degradê desliza continuamente da
        esquerda para a direita sobre o trilho inteiro. Use enquanto a etapa não
        tem percentual conhecido (ex.: "Na fila...", "Preparando...").
        - IsIndeterminate = False -> a barra preenche até Value/Maximum normalmente
        (aproveitando o comportamento nativo do ProgressBar via PART_Track/PART_Indicator),
        só que o preenchimento em si tem um "shimmer" de degradê correndo por dentro,
        então continua parecendo vivo mesmo com progresso real.

        Cor por via (ver OperationItem.Method): cada GradientStop tem o Color ligado por
        Binding direto (não StaticResource) ao WingetMethodStopColorConverter, que devolve o
        tom certo (roxo=COM, amarelo=API própria, ciano=winget.exe, azul=sem via identificada).
        Isso vale tanto pro preenchimento determinado quanto pra faixa indeterminada — a cor
        acompanha a via do início ao fim da operação, não só no instante da troca de camada.

        Não dá pra fazer isso com Setter.TargetName num GradientStop dentro de
        ControlTemplate.Triggers (erro de compilação MC4111 - essa restrição só existe pra
        Setter/Trigger, não pra Binding direto), por isso o Color é bindado na própria
        declaração do GradientStop. Em telas que reusam esse estilo mas cujo DataContext não
        tem "Method" (StageItemControl, SettingsPage, UpdatesPage), o Binding falha e cada
        FallbackValue abaixo devolve exatamente a cor azul original — nada muda pra elas.
    -->

    <Color x:Key="GradientProgressColorA">#FF3A8DFF</Color>
    <Color x:Key="GradientProgressColorB">#FF7CD4FD</Color>
    <Color x:Key="GradientProgressColorC">#FFEAF6FF</Color>
    <SolidColorBrush x:Key="GradientProgressTrackBrush" Color="#FFFFFFFF" Opacity="0.08" />

    <conv:WingetMethodStopColorConverter x:Key="WingetMethodStopColorConverter" />

    <Style x:Key="GradientProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{StaticResource GradientProgressTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">

                        <!--  Trilho de fundo  -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource CompactCornerRadius}" />

                        <!--
                            Preenchimento determinado: WPF calcula a largura de PART_Indicator
                            automaticamente a partir de Value/Minimum/Maximum, desde que os
                            nomes PART_Track/PART_Indicator existam no template.
                        -->
                        <Border x:Name="PART_Track"
                                Background="Transparent"
                                CornerRadius="{StaticResource CompactCornerRadius}"
                                ClipToBounds="True">
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border CornerRadius="{StaticResource CompactCornerRadius}"
                                        ClipToBounds="True"
                                        MinWidth="6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0.0"
                                                          Color="{Binding Method, Converter={StaticResource WingetMethodStopColorConverter}, ConverterParameter=A, FallbackValue={StaticResource GradientProgressColorA}}" />
                                            <GradientStop Offset="0.5"
                                                          Color="{Binding Method, Converter={StaticResource WingetMethodStopColorConverter}, ConverterParameter=C, FallbackValue={StaticResource GradientProgressColorC}}" />
                                            <GradientStop Offset="1.0"
                                                          Color="{Binding Method, Converter={StaticResource WingetMethodStopColorConverter}, ConverterParameter=A, FallbackValue={StaticResource GradientProgressColorA}}" />
                                            <LinearGradientBrush.RelativeTransform>
                                                <TranslateTransform x:Name="DeterminateShimmerTransform" X="-1" />
                                            </LinearGradientBrush.RelativeTransform>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Decorator>
                        </Border>

                        <!--  Faixa deslizante para o modo indeterminado  -->
                        <Border x:Name="IndeterminateRoot"
                                CornerRadius="{StaticResource CompactCornerRadius}"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <Rectangle x:Name="PART_GlowRect"
                                       Width="140"
                                       HorizontalAlignment="Left">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0.0" />
                                        <GradientStop Offset="0.15"
                                                      Color="{Binding Method, Converter={StaticResource WingetMethodStopColorConverter}, ConverterParameter=A, FallbackValue={StaticResource GradientProgressColorA}}" />
                                        <GradientStop Offset="0.5"
                                                      Color="{Binding Method, Converter={StaticResource WingetMethodStopColorConverter}, ConverterParameter=C, FallbackValue={StaticResource GradientProgressColorC}}" />
                                        <GradientStop Offset="0.85"
                                                      Color="{Binding Method, Converter={StaticResource WingetMethodStopColorConverter}, ConverterParameter=B, FallbackValue={StaticResource GradientProgressColorB}}" />
                                        <GradientStop Color="Transparent" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="IndeterminateTransform" X="-140" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateRoot" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard>
                                        <!--
                                            "To" precisa ser um valor fixo (não um Binding): o Storyboard é
                                            compartilhado entre árvores visuais diferentes (ex.: painel dentro
                                            de um Popup), e o WPF tenta "congelar" o Storyboard para isso -
                                            uma animação com propriedade vinculada a Binding não pode ser
                                            congelada, o que gera XamlParseException/InvalidOperationException
                                            ao abrir o Popup. Como PART_GlowRect está dentro de um Border com
                                            ClipToBounds="True", ultrapassar a largura real não tem efeito
                                            visual - só precisamos de um valor grande o bastante para cobrir
                                            qualquer largura razoável da barra.
                                        -->
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-140"
                                                         To="900"
                                                         Duration="0:0:1.4"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsIndeterminate" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="DeterminateStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DeterminateShimmerTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-1.5"
                                                         To="1.5"
                                                         Duration="0:0:1.6"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="DeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
