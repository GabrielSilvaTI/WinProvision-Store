<Page x:Class="WinProvision.Store.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:WinProvision.Store"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="HomePage"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InstallStateToLabelConverter x:Key="InstallStateToLabelConverter" />
        <conv:InstallStateToIconConverter x:Key="InstallStateToIconConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--  Tipografia Fluent  -->
        <Style x:Key="PageTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentPageTitleStyle}" />

        <Style x:Key="CardTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCardTitleStyle}" />

        <!-- Cartões da Visão Geral usam a mesma superfície das demais páginas. -->
        <Style x:Key="DashboardCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}" />

        <DataTemplate x:Key="AppIconTileTemplate">
            <Border Width="112" Height="112" Padding="10" Margin="0,0,8,8"
                    Background="Transparent" CornerRadius="{StaticResource ControlCornerRadius}"
                    Cursor="Hand" MouseLeftButtonUp="AppCard_Click">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="{Binding IconUrl}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="30" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StoreBannerTileTemplate">
            <Border Height="82"
                    Margin="0,0,0,10"
                    CornerRadius="{StaticResource StoreCardCornerRadius}"
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseLeftButtonUp="AppCard_Click">
                <Grid>
                    <Image conv:AsyncImage.SourceUrl="{Binding StoreBannerUrl}" Stretch="UniformToFill" Opacity="0.72" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#CC07111E" Offset="0" />
                                <GradientStop Color="#7007111E" Offset="0.62" />
                                <GradientStop Color="#1807111E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,8" MaxWidth="210" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="White" />
                        <TextBlock Text="{Binding Publisher}" FontSize="10" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="#DDE8F4" />
                    </StackPanel>
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PopularAppTileTemplate">
            <Border Height="54" Margin="2" Padding="5" CornerRadius="{StaticResource ControlCornerRadius}"
                    Cursor="Hand" MouseLeftButtonUp="AppCard_Click" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Center">
                        <Image conv:AsyncImage.SourceUrl="{Binding IconUrl}" Stretch="Uniform" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="30"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="DashboardSideCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!--  Template dos Banners em Destaque  -->
        <DataTemplate x:Key="FeaturedAppTemplate">
            <Border Height="148"
                    Margin="0,0,8,8"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseLeftButtonUp="AppCard_Click"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1">

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Topo: Ícone e Badge "Destaque"  -->
                    <Grid Grid.Row="0">
                        <Border CornerRadius="{StaticResource OverlayCornerRadius}"
                                ClipToBounds="True"
                                HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="34" />
                                    <Setter Property="Height" Value="34" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="msstore">
                                            <Setter Property="Width" Value="44" />
                                            <Setter Property="Height" Value="44" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <ui:SymbolIcon Symbol="Box24"
                                               FontSize="20"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=FeaturedIconImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <Image x:Name="FeaturedIconImage"
                                       conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=FeaturedIconImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <Border Background="#1AFFFFFF"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="7,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,8,8,0">
                            <TextBlock Text="Destaque"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <!--  Centro: Textos  -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Top"
                                Margin="0,6,0,4">
                        <TextBlock Text="{Binding Name, TargetNullValue=Aplicativo sem nome, FallbackValue=Aplicativo sem nome}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Publisher}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding StoreRating, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="★"
                                           FontSize="12"
                                           Foreground="#D6A644"
                                           Margin="0,0,3,0" />
                                <TextBlock Text="{Binding StoreRating, StringFormat={}{0:F1}}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding StoreRatingCount, StringFormat={} · {0:N0}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="3,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Estrelas no GitHub">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GitHubStars}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source}" Value="msstore">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="★" FontSize="12" Foreground="#D6A644" Margin="0,0,3,0" />
                                <TextBlock Text="{Binding GitHubStars, StringFormat={}{0:N0}}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="22"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Base: Botão  -->
                    <ui:Button Grid.Row="2"
                               Style="{StaticResource StorePillButtonStyle}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Padding="14,6"
                               Background="{StaticResource InstallActionBrush}"
                               MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                               PressedBackground="{StaticResource InstallActionPressedBrush}"
                               Foreground="White"
                               PressedForeground="White"
                               IsHitTestVisible="{Binding IsInstalled, Converter={StaticResource InverseBooleanConverter}}"
                               Click="InstallButton_Click"
                               Tag="{Binding}">
                        <ui:Button.Content>
                            <MultiBinding Converter="{StaticResource InstallStateToLabelConverter}">
                                <Binding Path="IsInstalled" />
                                <Binding Path="IsInstalling" />
                                <Binding Source="Adquirir" />
                            </MultiBinding>
                        </ui:Button.Content>
                        <ui:Button.Icon>
                            <MultiBinding Converter="{StaticResource InstallStateToIconConverter}">
                                <Binding Path="IsInstalled" />
                                <Binding Path="IsInstalling" />
                            </MultiBinding>
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AppListTemplate">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Style="{StaticResource DashboardCardStyle}"
                    Cursor="Hand"
                    MouseLeftButtonUp="AppCard_Click">
                <Grid MinHeight="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,12,0"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="40" />
                                <Setter Property="Height" Value="40" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source}" Value="msstore">
                                        <Setter Property="Width" Value="48" />
                                        <Setter Property="Height" Value="48" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <ui:SymbolIcon Symbol="Box24"
                                           FontSize="18"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=ListIconImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Image x:Name="ListIconImage"
                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=ListIconImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Publisher}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding StoreRating, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="★"
                                           FontSize="12"
                                           Foreground="#D6A644"
                                           Margin="0,0,3,0" />
                                <TextBlock Text="{Binding StoreRating, StringFormat={}{0:F1}}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding StoreRatingCount, StringFormat={} · {0:N0}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="3,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Estrelas no GitHub">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GitHubStars}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source}" Value="msstore">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="★" FontSize="12" Foreground="#D6A644" Margin="0,0,3,0" />
                                <TextBlock Text="{Binding GitHubStars, StringFormat={}{0:N0}}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ui:Button Grid.Column="2"
                               Visibility="Collapsed"
                               Padding="14,6"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Background="{StaticResource InstallActionBrush}"
                               MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                               PressedBackground="{StaticResource InstallActionPressedBrush}"
                               Foreground="White"
                               PressedForeground="White"
                               IsHitTestVisible="{Binding IsInstalled, Converter={StaticResource InverseBooleanConverter}}"
                               Click="InstallButton_Click"
                               Tag="{Binding}">
                        <ui:Button.Content>
                            <MultiBinding Converter="{StaticResource InstallStateToLabelConverter}">
                                <Binding Path="IsInstalled" />
                                <Binding Path="IsInstalling" />
                            </MultiBinding>
                        </ui:Button.Content>
                        <ui:Button.Icon>
                            <MultiBinding Converter="{StaticResource InstallStateToIconConverter}">
                                <Binding Path="IsInstalled" />
                                <Binding Path="IsInstalling" />
                            </MultiBinding>
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--  Layout Principal: 3 Colunas (Conteúdo | Espaço | Sidebar)  -->
    <Grid Margin="12"
          MaxWidth="{StaticResource PageContentMaxWidth}"
          HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SidebarGapColumn" Width="{StaticResource PageColumnGap}" />
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
        </Grid.ColumnDefinitions>

        <!--  ================= COLUNA ESQUERDA (Principal) =================  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Cabeçalho & Busca  -->
                <RowDefinition Height="Auto" />
                <!--  Filtros/Chips  -->
                <RowDefinition Height="*" />
                <!--  Banners e Grade (Rolável juntos)  -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  1. CABEÇALHO + BUSCA RESPONSIVO  -->
            <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PageHeaderIconTileStyle}"><ui:SymbolIcon Symbol="Grid24" Style="{StaticResource PageHeaderSymbolIconStyle}" /></Border>
                        <TextBlock Text="Descobrir" Style="{StaticResource PageTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="Pesquise e instale aplicativos."
                               Style="{StaticResource FluentPageSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!--  Campo de Busca embutido no topo direito com largura segura  -->
                <ui:TextBox x:Name="SearchBox"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Width="260"
                            MinWidth="180"
                            MaxWidth="340"
                            PlaceholderText="Pesquisar aplicativos..."
                            TextChanged="SearchBox_TextChanged"
                            KeyDown="SearchBox_KeyDown"
                            Padding="12,8">
                    <ui:TextBox.Icon>
                        <ui:FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
            </Grid>

            <!--  2. CHIPS DE CATEGORIA (WrapPanel para quebrar linha em meia tela sem cortar)  -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" x:Name="CategoryList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CategoryChip}">
                            <RadioButton GroupName="CategoryFilter"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Checked="CategoryChip_Checked"
                                         Tag="{Binding Tag}"
                                         Margin="0,0,8,8"
                                         Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Chip"
                                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                                Padding="16,8"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource AppBorderSubtleBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FontIcon Glyph="{Binding Icon}"
                                                             FontFamily="Segoe Fluent Icons"
                                                             Margin="0,0,8,0"
                                                             FontSize="16" />
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="13"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>

            <!--  3. ÁREA DE ROLAGEM (Destaques + Grade de Apps)  -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                <StackPanel Margin="0,0,4,0">

                    <!-- Banners editoriais carregados pelo Display Catalog da Microsoft Store. -->
                    <Grid Height="176" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.08*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="HeroBanner" Grid.Column="0" CornerRadius="{StaticResource StoreCardCornerRadius}"
                                ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="AppCard_Click"
                                Background="{DynamicResource AppSurfaceElevatedBrush}">
                            <Grid>
                                <Image x:Name="HeroBannerImage" conv:AsyncImage.SourceUrl="{Binding StoreBannerUrl}"
                                       Stretch="UniformToFill" Opacity="0.86" />
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#D9091A2C" Offset="0" />
                                            <GradientStop Color="#9C091A2C" Offset="0.38" />
                                            <GradientStop Color="#18091A2C" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="24,12,24,14" MaxWidth="340">
                                    <TextBlock Text="Descubra" FontSize="25" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="Aplicativos, jogos e mais para o seu dia a dia"
                                               FontSize="12" Foreground="#E6EDF7" Margin="0,2,0,12" TextWrapping="Wrap" />
                                    <ui:Button Content="Ver detalhes" Click="HeroBannerDetails_Click"
                                               HorizontalAlignment="Left" MinHeight="30" Padding="14,4"
                                               Background="{DynamicResource InstallActionBrush}" Foreground="White" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                    <ui:Button x:Name="HeroBannerPreviousButton" Appearance="Transparent" Padding="4" MinWidth="24" MinHeight="24"
                                               Click="HeroBannerPrevious_Click" ToolTip="Banner anterior">
                                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" Foreground="White" />
                                    </ui:Button>
                                    <ui:Button x:Name="HeroBannerDot0" Tag="0" Appearance="Transparent" Padding="4" MinWidth="18" MinHeight="24"
                                               Click="HeroBannerDot_Click" ToolTip="Primeiro banner">
                                        <Ellipse x:Name="HeroBannerIndicator0" Width="6" Height="6" Fill="#FF32B5FF" />
                                    </ui:Button>
                                    <ui:Button x:Name="HeroBannerDot1" Tag="1" Appearance="Transparent" Padding="4" MinWidth="18" MinHeight="24"
                                               Click="HeroBannerDot_Click" ToolTip="Segundo banner">
                                        <Ellipse x:Name="HeroBannerIndicator1" Width="6" Height="6" Fill="#FFFFFFFF" />
                                    </ui:Button>
                                    <ui:Button x:Name="HeroBannerDot2" Tag="2" Appearance="Transparent" Padding="4" MinWidth="18" MinHeight="24"
                                               Click="HeroBannerDot_Click" ToolTip="Terceiro banner">
                                        <Ellipse x:Name="HeroBannerIndicator2" Width="6" Height="6" Fill="#FFFFFFFF" />
                                    </ui:Button>
                                    <ui:Button x:Name="HeroBannerNextButton" Appearance="Transparent" Padding="4" MinWidth="24" MinHeight="24"
                                               Click="HeroBannerNext_Click" ToolTip="Próximo banner">
                                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" Foreground="White" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="SideStoreBannerList" Grid.Column="2" ItemsSource="{Binding SideStoreBannerApps}"
                                      ItemTemplate="{StaticResource StoreBannerTileTemplate}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Aplicativos em destaque" Style="{StaticResource CardTitleStyle}" FontSize="15" />
                        <TextBlock Grid.Column="1" Text="{Binding FeaturedApps.Count, StringFormat={}{0} aplicativos}"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Destaques do catálogo local seguem disponíveis nos três modos de visualização. -->
                    <Grid Margin="0,0,0,12">
                        <ItemsControl x:Name="FeaturedAppsList"
                                      ItemsSource="{Binding FeaturedApps}"
                                      ItemTemplate="{StaticResource FeaturedAppTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding FeaturedColumns, RelativeSource={RelativeSource AncestorType=local:HomePage}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl x:Name="FeaturedAppsListView"
                                      Visibility="Collapsed"
                                      ItemsSource="{Binding FeaturedApps}"
                                      ItemTemplate="{StaticResource AppListTemplate}" />
                        <ItemsControl x:Name="FeaturedAppsIconsList" Visibility="Collapsed"
                                      ItemsSource="{Binding FeaturedApps}"
                                      ItemTemplate="{StaticResource AppIconTileTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <!--  SEÇÃO: Aplicativos em Destaque (Grade principal adaptativa)  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mais aplicativos"
                                       Style="{StaticResource CardTitleStyle}"
                                       FontSize="16" />
                            <TextBlock Text="Explore outras opções."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <ScrollViewer x:Name="AppsGridScrollViewer"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Disabled"
                                      behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                            <ItemsControl x:Name="AppsList" ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding AppsColumns, RelativeSource={RelativeSource AncestorType=local:HomePage}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  Cartão Limpo e Compacto  -->
                                        <Border Margin="0,0,12,12"
                                                Padding="14"
                                                Style="{StaticResource DashboardCardStyle}"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="AppCard_Click">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!--  Topo: Ícone + Títulos  -->
                                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="40"
                                                            Height="40"
                                                            Margin="0,0,12,0"
                                                            CornerRadius="{StaticResource OverlayCornerRadius}"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <ui:SymbolIcon Symbol="Box24"
                                                                           FontSize="18"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=CategoryIconImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                            <Image x:Name="CategoryIconImage"
                                                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                                                   Stretch="Uniform"
                                                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=CategoryIconImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <!--  CORREÇÃO: MaxLines removido.  -->
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,0,2" />
                                                        <TextBlock Text="{Binding Publisher}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,0,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <!--  Meio: Descrição  -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Description}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="36"
                                                           LineHeight="18"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,0,16"
                                                           VerticalAlignment="Top"
                                                           Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}" />

                                                <!--  Base: Botão Direita  -->
                                                <ui:Button Grid.Row="2"
                                                           Visibility="Collapsed"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom"
                                                           Padding="16,6"
                                                           Background="{StaticResource InstallActionBrush}"
                                                           MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                                                           PressedBackground="{StaticResource InstallActionPressedBrush}"
                                                           Foreground="White"
                                                           PressedForeground="White"
                                                           IsHitTestVisible="{Binding IsInstalled, Converter={StaticResource InverseBooleanConverter}}"
                                                           Click="InstallButton_Click"
                                                           Tag="{Binding}">
                                                    <ui:Button.Content>
                                                        <MultiBinding Converter="{StaticResource InstallStateToLabelConverter}">
                                                            <Binding Path="IsInstalled" />
                                                            <Binding Path="IsInstalling" />
                                                        </MultiBinding>
                                                    </ui:Button.Content>
                                                    <ui:Button.Icon>
                                                        <MultiBinding Converter="{StaticResource InstallStateToIconConverter}">
                                                            <Binding Path="IsInstalled" />
                                                            <Binding Path="IsInstalling" />
                                                        </MultiBinding>
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ScrollViewer x:Name="AppsListScrollViewer"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Disabled"
                                      behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                            <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppListTemplate}" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="AppsIconsScrollViewer" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AppsIconsList" ItemsSource="{Binding Apps}"
                                          ItemTemplate="{StaticResource AppIconTileTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!--  Rodapé / Paginação  -->
                    <Grid Margin="0,16,0,24">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Mostrando " />
                            <Run Text="{Binding Items.Count, ElementName=AppsList, Mode=OneWay}" />
                            <Run Text=" aplicativos" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ui:Button Appearance="Transparent" Padding="8,4">
                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" />
                            </ui:Button>
                            <TextBlock Text="Página 1 de 1"
                                       VerticalAlignment="Center"
                                       Margin="12,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Appearance="Transparent" Padding="8,4">
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ordenar e exibir aplicativos"
                           Style="{StaticResource PageStatusTextStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Classificar por:" Style="{StaticResource PageStatusTextStyle}" Margin="0,0,8,0" />
                    <ComboBox x:Name="CatalogSortComboBox" Width="150" Height="32" SelectedIndex="0"
                              SelectionChanged="CatalogSortComboBox_SelectionChanged" Margin="0,0,12,0">
                        <ComboBoxItem Content="Popularidade" />
                        <ComboBoxItem Content="Nome" />
                    </ComboBox>
                    <ToggleButton x:Name="ListViewToggleButton" Style="{StaticResource PageViewModeToggleStyle}"
                                  Click="ListViewToggleButton_Click" ToolTip="Visualização em lista">
                        <ui:SymbolIcon Symbol="List24" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="GridViewToggleButton" Style="{StaticResource PageViewModeToggleStyle}"
                                  IsChecked="True" Click="GridViewToggleButton_Click" ToolTip="Visualização em cartões">
                        <ui:SymbolIcon Symbol="Grid24" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="IconsViewToggleButton" Style="{StaticResource PageViewModeToggleStyle}"
                                  Click="IconsViewToggleButton_Click" ToolTip="Visualização em ícones">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="16" />
                    </ToggleButton>
                </StackPanel>
              </Grid>
            </Border>
        </Grid>

        <!--  ================= COLUNA DIREITA (Sidebar) =================  -->
        <StackPanel x:Name="SidebarPanel" Grid.Column="2">

            <!--  1. Resumo do Catálogo  -->
            <Border Style="{StaticResource DashboardSideCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Resumo do Catálogo"
                                   Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center" />
                        <ui:Button x:Name="RefreshCatalogButton"
                                   Appearance="Transparent"
                                   Padding="6"
                                   HorizontalAlignment="Right"
                                   Click="RefreshButton_Click"
                                   ToolTip="Atualizar catálogo">
                            <ui:SymbolIcon Symbol="ArrowClockwise24"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="CatalogCountText"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Aplicativos"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="8"
                                       FontSize="32"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Categorias"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Última atualização"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LastCatalogSyncText"
                               Text="Sincronização ainda não realizada"
                               FontSize="12"
                               Margin="0,2,0,16" />
                    <TextBlock x:Name="StatusText" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon x:Name="CatalogStatusIcon"
                                     Glyph="&#xE930;"
                                     FontFamily="Segoe Fluent Icons"
                                     FontSize="14"
                                     Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                     Margin="0,0,8,0" />
                        <TextBlock x:Name="CatalogStatusText"
                                   Text="Atualizado"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  2. Categorias Populares  -->
            <Border Style="{StaticResource DashboardSideCardStyle}">
                <StackPanel>
                    <TextBlock Text="Categorias populares"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12"
                                VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE943;"
                                     FontFamily="Segoe Fluent Icons"
                                     Width="24"
                                     FontSize="16"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="Desenvolvimento"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12"
                                VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xEC7A;"
                                     FontFamily="Segoe Fluent Icons"
                                     Width="24"
                                     FontSize="16"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="Utilitários"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12"
                                VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE7C3;"
                                     FontFamily="Segoe Fluent Icons"
                                     Width="24"
                                     FontSize="16"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="Produtividade"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12"
                                VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE768;"
                                     FontFamily="Segoe Fluent Icons"
                                     Width="24"
                                     FontSize="16"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="Multimídia"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE83D;"
                                     FontFamily="Segoe Fluent Icons"
                                     Width="24"
                                     FontSize="16"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="Segurança"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="RightStorePromo" Height="112" Margin="0,0,0,10"
                    CornerRadius="{StaticResource StoreCardCornerRadius}" ClipToBounds="True"
                    Cursor="Hand" MouseLeftButtonUp="AppCard_Click"
                    Background="{DynamicResource AppSurfaceElevatedBrush}">
                <Grid>
                    <Image conv:AsyncImage.SourceUrl="{Binding StoreBannerUrl}" Stretch="UniformToFill" Opacity="0.8" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#C8091828" Offset="0" />
                                <GradientStop Color="#55091828" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="12,8">
                        <TextBlock Text="Destaque da Microsoft Store" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Conheça o aplicativo Xbox" FontSize="10" Foreground="#DDE8F4" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,11" />
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardSideCardStyle}">
                <StackPanel>
                    <TextBlock Text="Aplicativos populares" Style="{StaticResource CardTitleStyle}" FontSize="14" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding PopularApps}" ItemTemplate="{StaticResource PopularAppTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>
