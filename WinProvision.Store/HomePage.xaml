<Page
    x:Class="WinProvision.Store.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:WinProvision.Store"
    xmlns:conv="clr-namespace:WinProvision.Store.Converters"
    xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
    ScrollViewer.CanContentScroll="False"
    Title="HomePage"
    Background="Transparent"
    TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
    TextElement.FontSize="14"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Auto"
    RenderOptions.ClearTypeHint="Enabled"
    UseLayoutRounding="True">

    <Page.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InstalledToLabelConverter x:Key="InstalledToLabelConverter" />
        <conv:InstalledToIconConverter x:Key="InstalledToIconConverter" />
        <conv:InstallStateToLabelConverter x:Key="InstallStateToLabelConverter" />
        <conv:InstallStateToIconConverter x:Key="InstallStateToIconConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Tipografia Fluent -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <!-- Estilo base para os painéis e cartões -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Template dos Banners em Destaque -->
        <DataTemplate x:Key="FeaturedAppTemplate">
            <Border Height="184" Margin="0,0,12,12" CornerRadius="12" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="AppCard_Click"
                    Background="{StaticResource AppCardBackgroundBrush}" BorderBrush="{StaticResource AppCardBorderBrush}" BorderThickness="1">

                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Topo: Ícone e Badge "Destaque" -->
                    <Grid Grid.Row="0">
                        <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left">
                            <Grid>
                                <ui:SymbolIcon Symbol="Box24" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=FeaturedIconImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                <Image x:Name="FeaturedIconImage" conv:AsyncImage.SourceUrl="{Binding IconUrl}" Stretch="Uniform"
                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=FeaturedIconImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <Border Background="#1AFFFFFF" CornerRadius="6" Padding="7,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                            <TextBlock Text="Destaque" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <!-- Centro: Textos -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,12,0,8">
                        <TextBlock Text="{Binding Name, TargetNullValue=Aplicativo sem nome, FallbackValue=Aplicativo sem nome}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Publisher}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Base: Botão -->
                    <ui:Button Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="14,6"
                               Background="{StaticResource InstallActionBrush}"
                               MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                               PressedBackground="{StaticResource InstallActionPressedBrush}"
                               Foreground="White" PressedForeground="White"
                               IsHitTestVisible="{Binding IsInstalled, Converter={StaticResource InverseBooleanConverter}}"
                               Click="InstallButton_Click" Tag="{Binding}">
                        <ui:Button.Content>
                            <MultiBinding Converter="{StaticResource InstallStateToLabelConverter}">
                                <Binding Path="IsInstalled" />
                                <Binding Path="IsInstalling" />
                            </MultiBinding>
                        </ui:Button.Content>
                        <ui:Button.Icon>
                            <MultiBinding Converter="{StaticResource InstallStateToIconConverter}">
                                <Binding Path="IsInstalled" />
                                <Binding Path="IsInstalling" />
                            </MultiBinding>
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- Layout Principal: 3 Colunas (Conteúdo | Espaço | Sidebar) -->
    <Grid Margin="24,20,24,20" MaxWidth="1600" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SidebarGapColumn" Width="20" />
            <ColumnDefinition x:Name="SidebarColumn" Width="264" />
        </Grid.ColumnDefinitions>

        <!-- ================= COLUNA ESQUERDA (Principal) ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Cabeçalho & Busca -->
                <RowDefinition Height="Auto"/>
                <!-- Filtros/Chips -->
                <RowDefinition Height="*"/>
                <!-- Banners e Grade (Rolável juntos) -->
            </Grid.RowDefinitions>

            <!-- 1. CABEÇALHO + BUSCA RESPONSIVO -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Visão Geral" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock                     Text="Encontre e instale seus aplicativos."
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"
                               FontFamily="Segoe UI Variable Text" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Campo de Busca embutido no topo direito com largura segura -->
                <ui:TextBox x:Name="SearchBox" Grid.Column="2" VerticalAlignment="Center"
                            Width="260" MinWidth="180" MaxWidth="340"
                            PlaceholderText="Pesquise apps, pacotes e mais..."
                            Icon="{ui:SymbolIcon Search24}"
                            TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                            Padding="12,8" />
            </Grid>

            <!-- 2. CHIPS DE CATEGORIA (WrapPanel para quebrar linha em meia tela sem cortar) -->
            <ItemsControl Grid.Row="1" Margin="0,0,0,12" x:Name="CategoryList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CategoryChip}">
                        <RadioButton GroupName="CategoryFilter" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Checked="CategoryChip_Checked" Tag="{Binding Tag}" Margin="0,0,8,8" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Chip" CornerRadius="16" Padding="16,8" Background="{StaticResource AppSurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource AppBorderSubtleBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,8,0" FontSize="16"/>
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 3. ÁREA DE ROLAGEM (Destaques + Grade de Apps) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                <StackPanel Margin="0,0,4,0">

                    <!-- SEÇÃO: Destaques (Colunas adaptativas ao tamanho da janela) -->
                    <ItemsControl x:Name="FeaturedAppsList" ItemsSource="{Binding FeaturedApps}" ItemTemplate="{StaticResource FeaturedAppTemplate}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding FeaturedColumns, RelativeSource={RelativeSource AncestorType=local:HomePage}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- SEÇÃO: Aplicativos em Destaque (Grade principal adaptativa) -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Mais aplicativos" Style="{StaticResource CardTitleStyle}" FontSize="16" />
                            <TextBlock Text="Mais opções para você." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="AppsList" ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding AppsColumns, RelativeSource={RelativeSource AncestorType=local:HomePage}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Cartão Limpo e Compacto -->
                                <Border Margin="0,0,12,12" Padding="14" Style="{StaticResource DashboardCardStyle}" Cursor="Hand" MouseLeftButtonUp="AppCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Topo: Ícone + Títulos -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="8" ClipToBounds="True">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="Box24" FontSize="18" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=CategoryIconImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                    <Image x:Name="CategoryIconImage" conv:AsyncImage.SourceUrl="{Binding IconUrl}" Stretch="Uniform"
                                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=CategoryIconImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- CORREÇÃO: MaxLines removido. -->
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Meio: Descrição -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" VerticalAlignment="Top"
                                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Base: Botão Direita -->
                                        <ui:Button Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="16,6"
                                                   IsHitTestVisible="{Binding IsInstalling, Converter={StaticResource InverseBooleanConverter}}"
                                                   Click="InstallButton_Click" Tag="{Binding}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Background" Value="{StaticResource InstallActionBrush}" />
                                                    <Setter Property="MouseOverBackground" Value="{StaticResource InstallActionHoverBrush}" />
                                                    <Setter Property="PressedBackground" Value="{StaticResource InstallActionPressedBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="PressedForeground" Value="White" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Appearance" Value="Secondary" />
                                                            <Setter Property="Background" Value="#0AFFFFFF" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                            <ui:Button.Content>
                                                <MultiBinding Converter="{StaticResource InstallStateToLabelConverter}">
                                                    <Binding Path="IsInstalled" />
                                                    <Binding Path="IsInstalling" />
                                                </MultiBinding>
                                            </ui:Button.Content>
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Rodapé / Paginação -->
                    <Grid Margin="0,16,0,24">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Mostrando " />
                            <Run Text="{Binding Items.Count, ElementName=AppsList, Mode=OneWay}" />
                            <Run Text=" aplicativos" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:Button Appearance="Transparent" Padding="8,4">
                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14"/>
                            </ui:Button>
                            <TextBlock Text="Página 1 de 1" VerticalAlignment="Center" Margin="12,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:Button Appearance="Transparent" Padding="8,4">
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= COLUNA DIREITA (Sidebar) ================= -->
        <StackPanel x:Name="SidebarPanel" Grid.Column="2">

            <!-- 1. Resumo do Catálogo -->
            <Border Style="{StaticResource DashboardCardStyle}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,24">
                        <TextBlock Text="Resumo do Catálogo" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                        <ui:Button x:Name="RefreshCatalogButton" Appearance="Transparent" Padding="6" HorizontalAlignment="Right" Click="RefreshButton_Click" ToolTip="Atualizar catálogo">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="CatalogCountText" Text="0" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="Aplicativos" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="8" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="Categorias" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Última atualização" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StatusText" Text="Hoje às 13:40" FontSize="12" Margin="0,2,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Atualizado" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Categorias Populares -->
            <Border Style="{StaticResource DashboardCardStyle}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Categorias populares" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Code24" Width="24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Desenvolvimento" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Wrench24" Width="24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Utilitários" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Document24" Width="24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Produtividade" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Play24" Width="24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Multimídia" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Shield24" Width="24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Segurança" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>