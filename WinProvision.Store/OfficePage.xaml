<Page x:Class="WinProvision.Store.OfficePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="OfficePage"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <!-- Todos os botões desta página usam a geometria compacta compartilhada. -->
        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontFamily" Value="{StaticResource StoreFontFamily}" />
        </Style>
    </Page.Resources>

<Grid Margin="{StaticResource PageContentMargin}"
          MaxWidth="{StaticResource PageContentMaxWidth}"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ================= Cabeçalho =================  -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="{StaticResource PageHeaderMargin}">
            <Border Style="{StaticResource PageHeaderIconTileStyle}"><ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource PageHeaderSymbolIconStyle}" /></Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Office" Style="{StaticResource FluentPageTitleStyle}" />
                <TextBlock Text="Instale, repare, atualize ou remova o Office." Style="{StaticResource FluentPageSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Barra de ações no topo da página, alinhada ao padrão de Atualizações. -->
        <Border Grid.Row="1" Style="{StaticResource PageToolbarContainerStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="InstallRepairButton"
                               Appearance="Primary"
                               Height="34"
                               MinHeight="34"
                               Margin="0,0,8,0"
                               CornerRadius="{StaticResource ControlCornerRadius}"
                               Padding="12,0"
                               ToolTip="Instalar ou reparar o Office com a interface escolhida abaixo"
                               Click="InstallRepairButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Instalar" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <ui:Button x:Name="AddToCatalogButton"
                               Style="{StaticResource StoreActionButtonStyle}"
                               Margin="0,0,8,0"
                               ToolTip="Adicionar este plano do Office ao catálogo de pacotes"
                               Click="AddToCatalogButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Catálogo" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="PreviewConfigurationButton"
                               Style="{StaticResource StoreActionButtonStyle}"
                               Margin="0,0,8,0"
                               ToolTip="Conferir e exportar o XML que será enviado ao ODT"
                               Click="PreviewConfigurationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Prévia XML" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ToggleButton x:Name="AutoUpdatesToggleButton"
                                  Style="{StaticResource StoreToggleButtonStyle}"
                                  Margin="0,0,8,0"
                                  Width="Auto"
                                  MinWidth="0"
                                  Height="34"
                                  MinHeight="34"
                                  Padding="10,0"
                                  IsChecked="True"
                                  ToolTip="Ativar ou desativar atualizações automáticas do Office"
                                  Checked="AutoUpdatesToggleButton_Toggled"
                                  Unchecked="AutoUpdatesToggleButton_Toggled">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <ui:Button x:Name="UninstallButton"
                               Style="{StaticResource StoreActionButtonStyle}"
                               Margin="0,0,8,0"
                               ToolTip="Remover todas as instalações do Office"
                               Click="UninstallButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Desinstalar" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="OpenWorkFolderButton"
                               Style="{StaticResource StoreActionButtonStyle}"
                               Margin="0,0,8,0"
                               ToolTip="Abrir a pasta de trabalho do Office Deployment Tool"
                               Click="OpenWorkFolderButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Abrir pasta" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  ================= Corpo =================  -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
          <Grid>
              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="6.5*" MinWidth="440" />
                  <ColumnDefinition Width="{StaticResource PageColumnGap}" />
                  <ColumnDefinition Width="3.5*"
                                    MinWidth="320"
                                    MaxWidth="450" />
              </Grid.ColumnDefinitions>

            <!--  Esquerda: Configurações e Apps  -->
                <StackPanel Grid.Column="0">

                    <!-- Ofertas Microsoft 365 da Microsoft Store. -->
                    <Border Style="{StaticResource StoreCardSurfaceStyle}">
                        <StackPanel>
                            <TextBlock Text="Microsoft 365" Style="{StaticResource FluentCardTitleStyle}" />
                            <TextBlock Text="Ofertas Microsoft 365 com mídia servida pelo catálogo WinProvision."
                                       Style="{StaticResource StoreCardSubtitleStyle}" Margin="0,4,0,12" />
                            <ItemsControl x:Name="StoreOffersItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Click="StoreOfferButton_Click"
                                                       Margin="0,0,8,0" Padding="0"
                                                       BorderThickness="0" Appearance="Transparent"
                                                       CornerRadius="{StaticResource ControlCornerRadius}"
                                                       Background="Transparent" Cursor="Hand"
                                                       ToolTip="{Binding DisplayName}">
                                                <Border MinHeight="190" CornerRadius="{StaticResource StoreCardCornerRadius}"
                                                        Background="{DynamicResource AppCardBackgroundBrush}"
                                                        BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="96" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}">
                                                            <Image conv:AsyncImage.SourceUrl="{Binding BannerUrl}" Stretch="UniformToFill" />
                                                            <Border Width="42" Height="42" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}"
                                                                    BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="5">
                                                                <Image conv:AsyncImage.SourceUrl="{Binding IconUrl}" Stretch="Uniform" />
                                                            </Border>
                                                            <ui:SymbolIcon Symbol="DocumentText24" FontSize="28"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                        </Grid>
                                                        <StackPanel Grid.Row="1" Margin="12,8,12,10" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxHeight="30" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Grid.RowSpan="2" BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                BorderThickness="2" CornerRadius="{StaticResource StoreCardCornerRadius}" IsHitTestVisible="False"
                                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Seleção de Aplicativos  -->
                    <Border Style="{StaticResource StoreCardSurfaceStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Seleção de Aplicativos" Style="{StaticResource FluentCardTitleStyle}" />
                                    <TextBlock Text="Escolha os aplicativos da suíte e inclua Visio ou Project se precisar." Style="{StaticResource StoreCardSubtitleStyle}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1"
                                           x:Name="SelectAllAppsButton"
                                           Content="Selecionar todos"
                                           Style="{StaticResource StoreActionButtonStyle}"
                                           Click="SelectAllAppsButton_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Checkmark24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>

                            <ItemsControl x:Name="AppToggleItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource StoreOfficeAppTileStyle}"
                                                      IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsEnabled}"
                                                      Click="AppTileToggle_Click">
                                            <StackPanel>
                                                <Image conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                                       Width="44"
                                                       Height="44"
                                                       Margin="0,0,0,12"
                                                       Stretch="Uniform"
                                                       RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}" />
                                                    </Image.RenderTransform>
                                                </Image>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="Segoe UI Variable Text"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Configurações de Instalação  -->
                    <Border Style="{StaticResource StoreCardSurfaceStyle}">
                        <StackPanel>
                            <TextBlock Text="Instalação" Style="{StaticResource FluentCardTitleStyle}" />
                            <TextBlock Text="Escolha a arquitetura, o idioma e o canal."
                                       Style="{StaticResource StoreCardSubtitleStyle}"
                                       Margin="0,0,0,24" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Categoria" Style="{StaticResource StoreFieldLabelStyle}" />
                                    <ComboBox x:Name="CategoryComboBox"
                                              SelectionChanged="CategoryComboBox_SelectionChanged"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Plano (nome oficial)" Style="{StaticResource StoreFieldLabelStyle}" />
                                    <ComboBox x:Name="PlanComboBox"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="PlanComboBox_SelectionChanged"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Canal de atualização" Style="{StaticResource StoreFieldLabelStyle}" />
                                    <ComboBox x:Name="ChannelComboBox" HorizontalAlignment="Stretch"
                                              SelectionChanged="ChannelComboBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Arquitetura" Style="{StaticResource StoreFieldLabelStyle}" />
                                    <ComboBox x:Name="ArchitectureComboBox" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="64 bits"
                                                      Tag="64"
                                                      IsSelected="True" />
                                        <ComboBoxItem Content="32 bits" Tag="32" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="Idioma" Style="{StaticResource StoreFieldLabelStyle}" />
                                    <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Português (Brasil)"
                                                      Tag="pt-br"
                                                      IsSelected="True" />
                                        <ComboBoxItem Content="English (United States)" Tag="en-us" />
                                        <ComboBoxItem Content="Español" Tag="es-es" />
                                        <ComboBoxItem Content="Français" Tag="fr-fr" />
                                        <ComboBoxItem Content="Deutsch" Tag="de-de" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="Interface" Style="{StaticResource StoreFieldLabelStyle}" />
                                    <ComboBox x:Name="InterfaceComboBox" HorizontalAlignment="Stretch"
                                              ToolTip="Escolha se o instalador do Office exibirá sua interface.">
                                        <ComboBoxItem Content="Oculto" Tag="Silent" IsSelected="True" />
                                        <ComboBoxItem Content="Visível" Tag="Visible" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="AdditionalProductsPanel" Visibility="Collapsed" Margin="0,20,0,0">
                                <TextBlock Text="Edições adicionais para instalar junto ao Office" Style="{StaticResource StoreFieldLabelStyle}" />
                                <WrapPanel>
                                    <StackPanel x:Name="VisioProductSelector" Width="280" Margin="0,0,16,8" Visibility="Collapsed">
                                        <TextBlock Text="Edição do Visio" Style="{StaticResource StoreFieldLabelStyle}" />
                                        <ComboBox x:Name="VisioProductComboBox" DisplayMemberPath="DisplayName"
                                                  ToolTip="Escolha a edição do Visio a incluir no XML ODT." />
                                    </StackPanel>
                                    <StackPanel x:Name="ProjectProductSelector" Width="280" Margin="0,0,16,8" Visibility="Collapsed">
                                        <TextBlock Text="Edição do Project" Style="{StaticResource StoreFieldLabelStyle}" />
                                        <ComboBox x:Name="ProjectProductComboBox" DisplayMemberPath="DisplayName"
                                                  ToolTip="Escolha a edição do Project a incluir no XML ODT." />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <Expander Header="Opções avançadas"
                                      Margin="0,24,0,0"
                                      FontFamily="Segoe UI Variable Text"
                                      Style="{StaticResource SmoothExpanderStyle}">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Idiomas adicionais no mesmo produto" Style="{StaticResource StoreFieldLabelStyle}" />
                                    <WrapPanel Margin="0,0,0,16">
                                        <CheckBox x:Name="LangAdditionalPtBr"
                                                  Content="pt-br"
                                                  Tag="pt-br"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="LangAdditionalEnUs"
                                                  Content="en-us"
                                                  Tag="en-us"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="LangAdditionalEsEs"
                                                  Content="es-es"
                                                  Tag="es-es"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="LangAdditionalFrFr"
                                                  Content="fr-fr"
                                                  Tag="fr-fr"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="LangAdditionalDeDe"
                                                  Content="de-de"
                                                  Tag="de-de"
                                                  Margin="0,0,16,8" />
                                    </WrapPanel>

                                    <TextBlock Text="Excluir também (Ferramentas legadas)" Style="{StaticResource StoreFieldLabelStyle}" />
                                    <WrapPanel Margin="0,0,0,16">
                                        <CheckBox x:Name="ExcludeOneDriveCheckBox"
                                                  Content="OneDrive (Groove)"
                                                  Tag="Groove"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="ExcludeSkypeCheckBox"
                                                  Content="Skype for Business"
                                                  Tag="Lync"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="ExcludeBingCheckBox"
                                                  Content="Suplementos Bing"
                                                  Tag="Bing"
                                                  Margin="0,0,16,8" />
                                    </WrapPanel>

                                    <CheckBox x:Name="CleanStoreEditionCheckBox"
                                              Content="Ao remover, excluir AppX (Microsoft Store)"
                                              IsChecked="True" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

            <!--  Direita: Barra Lateral  -->
            <StackPanel Grid.Column="2">

                <!--  Produtos Instalados (Movido para o topo)  -->
                <Border Style="{StaticResource StoreCardSurfaceStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Instalados" Style="{StaticResource FluentCardTitleStyle}" />
                                <TextBlock x:Name="InstalledSummaryText"
                                           Text="Status da máquina atual"
                                           Style="{StaticResource StoreCardSubtitleStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Appearance="Secondary"
                                       Padding="8"
                                       Click="RefreshInstalledButton_Click"
                                       ToolTip="Recarregar"
                                       CornerRadius="{StaticResource ControlCornerRadius}"
                                       VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" />
                            </ui:Button>
                        </Grid>

                        <ItemsControl x:Name="AppStatusItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                    <Grid MinHeight="64" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                               Width="32"
                                               Height="32"
                                               Stretch="Uniform"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}" />
                                            </Image.RenderTransform>
                                        </Image>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource StoreFontFamily}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{Binding StatusBrush}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Padding="12,6"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding StatusText}">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoInstalledProductsText"
                                   Text="Nenhuma instalação do Office foi encontrada."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontFamily="Segoe UI Variable Text"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!--  ================= Rodapé (Status) =================  -->
        <Border Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Style="{StaticResource PageStatusIconStyle}" />
            <TextBlock x:Name="StatusText"
                       Text="Escolha as opções e inicie."
                       Style="{StaticResource PageStatusTextStyle}" />
          </StackPanel>
        </Border>
    </Grid>
</Page>
