<Page x:Class="WinProvision.Store.OfficePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="OfficePage"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <!--  Tipografia Fluent  -->
        <Style x:Key="PageTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentPageTitleStyle}" />

        <Style x:Key="CardTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCardTitleStyle}" />

        <Style x:Key="CardSubtitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  Cartão "Mica-Friendly"  -->
        <Style x:Key="CardStyle"
               TargetType="Border"
               BasedOn="{StaticResource StoreCardSurfaceStyle}">
            <Setter Property="Padding" Value="{StaticResource Spacing24}" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        </Style>

        <!-- Barra de ações no mesmo padrão compacto usado em Atualizações. -->
        <Style x:Key="ToolbarButtonStyle"
               TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource StorePillCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Seleção de Apps: Estilo Windows 11 Fluent Settings Card  -->
        <Style x:Key="AppTileToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="116" />
            <Setter Property="Height" Value="116" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource StoreBrush_0AFFFFFF}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StoreBrush_1AFFFFFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                Padding="12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:SymbolIcon x:Name="CheckIcon"
                                               Symbol="CheckmarkCircle24"
                                               FontSize="18"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Foreground="Transparent" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource StoreBrush_14FFFFFF}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource StoreBrush_4CAF6B}" />
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource StoreBrush_154CAF6B}" />
                                <Setter TargetName="CheckIcon" Property="Foreground" Value="{DynamicResource StoreBrush_4CAF6B}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource StoreBrush_254CAF6B}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="{StaticResource PageContentMargin}"
          MaxWidth="{StaticResource PageContentMaxWidth}"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ================= Cabeçalho =================  -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="{StaticResource PageHeaderMargin}">
            <Border Style="{StaticResource PageHeaderIconTileStyle}"><ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource PageHeaderSymbolIconStyle}" /></Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Office" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Instale, repare, atualize ou remova o Office." Style="{StaticResource FluentPageSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Barra de ações no topo da página, alinhada ao padrão de Atualizações. -->
        <Border Grid.Row="1" Style="{StaticResource PageToolbarContainerStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Margin="0,0,6,0"
                            Height="34">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="InstallRepairButton"
                                       Appearance="Transparent"
                                       Foreground="White"
                                       Height="34"
                                       Padding="12,0"
                                       ToolTip="Instalar ou reparar o Office de forma autônoma"
                                       Click="InstallRepairButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0" Foreground="White" />
                                    <TextBlock Text="Instalar" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                            <Rectangle Width="1" Fill="{DynamicResource StoreBrush_33FFFFFF}" VerticalAlignment="Stretch" Margin="0,5" />
                            <ui:Button x:Name="InstallVariantsButton"
                                       Appearance="Transparent"
                                       Foreground="White"
                                       Width="26"
                                       Height="34"
                                       Padding="0"
                                       ToolTip="Mais opções de instalação"
                                       Click="InstallVariantsButton_Click">
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Foreground="White" />
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />

                    <ui:Button x:Name="AddToCatalogButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Adicionar este plano do Office ao catálogo de pacotes"
                               Click="AddToCatalogButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Catálogo" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ToggleButton x:Name="AutoUpdatesToggleButton"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  IsChecked="True"
                                  ToolTip="Ativar ou desativar atualizações automáticas do Office"
                                  Checked="AutoUpdatesToggleButton_Toggled"
                                  Unchecked="AutoUpdatesToggleButton_Toggled">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <ui:Button x:Name="UninstallButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Remover todas as instalações do Office"
                               Click="UninstallButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Desinstalar" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="OpenWorkFolderButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Abrir a pasta de trabalho do Office Deployment Tool"
                               Click="OpenWorkFolderButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Abrir pasta" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  ================= Corpo =================  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*" MinWidth="400" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="3.5*"
                                  MinWidth="320"
                                  MaxWidth="450" />
            </Grid.ColumnDefinitions>

            <!--  Esquerda: Configurações e Apps  -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                <StackPanel Margin="0,0,8,0">

                    <!--  Seleção de Aplicativos  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Seleção de Aplicativos" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="Selecione os aplicativos do plano." Style="{StaticResource CardSubtitleStyle}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1"
                                           x:Name="SelectAllAppsButton"
                                           Content="Selecionar todos"
                                           Style="{StaticResource SelectAllButtonStyle}"
                                           Click="SelectAllAppsButton_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Checkmark24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>

                            <ItemsControl x:Name="AppToggleItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource AppTileToggleStyle}" IsChecked="{Binding IsOn, Mode=TwoWay}">
                                            <StackPanel>
                                                <Image conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                                       Width="44"
                                                       Height="44"
                                                       Margin="0,0,0,12"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="Segoe UI Variable Text"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Configurações de Instalação  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Instalação" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Escolha a arquitetura, o idioma e o canal."
                                       Style="{StaticResource CardSubtitleStyle}"
                                       Margin="0,0,0,24" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Categoria" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="CategoryComboBox"
                                              SelectionChanged="CategoryComboBox_SelectionChanged"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Plano (nome oficial)" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="PlanComboBox"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="PlanComboBox_SelectionChanged"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Canal de atualização" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="ChannelComboBox" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Arquitetura" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="ArchitectureComboBox" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="64 bits"
                                                      Tag="64"
                                                      IsSelected="True" />
                                        <ComboBoxItem Content="32 bits" Tag="32" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="Idioma" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Português (Brasil)"
                                                      Tag="pt-br"
                                                      IsSelected="True" />
                                        <ComboBoxItem Content="English (United States)" Tag="en-us" />
                                        <ComboBoxItem Content="Español" Tag="es-es" />
                                        <ComboBoxItem Content="Français" Tag="fr-fr" />
                                        <ComboBoxItem Content="Deutsch" Tag="de-de" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Expander Header="Opções avançadas"
                                      Margin="0,24,0,0"
                                      FontFamily="Segoe UI Variable Text"
                                      Style="{StaticResource SmoothExpanderStyle}">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Idiomas adicionais no mesmo produto" Style="{StaticResource FieldLabelStyle}" />
                                    <WrapPanel Margin="0,0,0,16">
                                        <CheckBox x:Name="LangAdditionalPtBr"
                                                  Content="pt-br"
                                                  Tag="pt-br"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="LangAdditionalEnUs"
                                                  Content="en-us"
                                                  Tag="en-us"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="LangAdditionalEsEs"
                                                  Content="es-es"
                                                  Tag="es-es"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="LangAdditionalFrFr"
                                                  Content="fr-fr"
                                                  Tag="fr-fr"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="LangAdditionalDeDe"
                                                  Content="de-de"
                                                  Tag="de-de"
                                                  Margin="0,0,16,8" />
                                    </WrapPanel>

                                    <TextBlock Text="Excluir também (Ferramentas legadas)" Style="{StaticResource FieldLabelStyle}" />
                                    <WrapPanel Margin="0,0,0,16">
                                        <CheckBox x:Name="ExcludeOneDriveCheckBox"
                                                  Content="OneDrive (Groove)"
                                                  Tag="Groove"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="ExcludeSkypeCheckBox"
                                                  Content="Skype for Business"
                                                  Tag="Lync"
                                                  Margin="0,0,16,8" />
                                        <CheckBox x:Name="ExcludeBingCheckBox"
                                                  Content="Suplementos Bing"
                                                  Tag="Bing"
                                                  Margin="0,0,16,8" />
                                    </WrapPanel>

                                    <CheckBox x:Name="CleanStoreEditionCheckBox"
                                              Content="Ao remover, excluir AppX (Microsoft Store)"
                                              IsChecked="True" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  Direita: Barra Lateral  -->
            <StackPanel Grid.Column="2">

                <!--  Produtos Instalados (Movido para o topo)  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Instalados" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="InstalledSummaryText"
                                           Text="Status da máquina atual"
                                           Style="{StaticResource CardSubtitleStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Appearance="Transparent"
                                       Padding="8"
                                       Click="RefreshInstalledButton_Click"
                                       ToolTip="Recarregar"
                                       CornerRadius="{StaticResource ControlCornerRadius}"
                                       VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" />
                            </ui:Button>
                        </Grid>

                        <ItemsControl x:Name="AppStatusItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="64" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                               Width="32"
                                               Height="32"
                                               Margin="0,0,12,0"
                                               Stretch="Uniform" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource StoreFontFamily}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{Binding StatusBrush}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource StorePillCornerRadius}"
                                                Padding="12,6"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding StatusText}">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoInstalledProductsText"
                                   Text="Nenhuma instalação do Office foi encontrada."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontFamily="Segoe UI Variable Text"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!--  ================= Rodapé (Status) =================  -->
        <Border Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Style="{StaticResource PageStatusIconStyle}" />
            <TextBlock x:Name="StatusText"
                       Text="Escolha as opções e inicie."
                       Style="{StaticResource PageStatusTextStyle}" />
          </StackPanel>
        </Border>
    </Grid>
</Page>
