<ui:FluentWindow x:Class="WinProvision.Store.ProvisioningJsonEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Visualizador JSON completo"
                 Height="680"
                 Width="820"
                 MinHeight="420"
                 MinWidth="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Visualizador JSON completo" />

        <Border x:Name="EditorBorder"
                Grid.Row="1"
                Margin="20,4,20,12"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Background="#33000000"
                Padding="12"
                BorderThickness="1"
                BorderBrush="Transparent">
            <TextBox x:Name="JsonTextBox"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="13"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Border>

        <Border Grid.Row="2"
                Margin="20,0,20,10"
                Padding="12,8"
                Background="{DynamicResource AppSurfaceSecondaryBrush}"
                BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
            <TextBlock x:Name="ValidationText"
                       Text="Validando..."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,0,20,0">
            <ui:Button Content="Copiar"
                       Appearance="Secondary"
                       Margin="0,0,8,0"
                       Click="CopyButton_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button x:Name="SaveButton"
                       Content="Salvar como..."
                       Appearance="Secondary"
                       Margin="0,0,8,0"
                       Click="SaveAsButton_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="Fechar"
                       Appearance="Primary"
                       Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
