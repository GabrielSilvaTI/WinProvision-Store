<ui:FluentWindow x:Class="WinProvision.Store.ProvisioningJsonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Editor de Perfil — JSON"
        Height="680" Width="820"
        MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Editor de Perfil — JSON" />

        <Border Grid.Row="1" Margin="20,4,20,12" CornerRadius="8" Background="#33000000" Padding="12">
            <TextBox x:Name="JsonTextBox"
                     BorderThickness="0" Background="Transparent"
                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,0">
            <ui:Button Content="Copiar" Appearance="Secondary" Margin="0,0,8,0" Click="CopyButton_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="Salvar como..." Appearance="Secondary" Margin="0,0,8,0" Click="SaveAsButton_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="Fechar" Appearance="Primary" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
