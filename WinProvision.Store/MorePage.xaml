<Page x:Class="WinProvision.Store.MorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Mais"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="14"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      UseLayoutRounding="True">
    <Page.Resources>
        <Style x:Key="MoreActionCardButtonStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="340" />
            <Setter Property="MinHeight" Value="205" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
            <Setter Property="MouseOverBackground" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="PressedBackground" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid Margin="{StaticResource PageContentMargin}"
          MaxWidth="{StaticResource PageContentMaxWidth}"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource PageHeaderMargin}">
            <Border Style="{StaticResource PageHeaderIconTileStyle}">
                <ui:SymbolIcon Symbol="MoreHorizontal24" Style="{StaticResource PageHeaderSymbolIconStyle}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mais" Style="{StaticResource FluentPageTitleStyle}" />
                <TextBlock Text="Informações do projeto, histórico e registros de diagnóstico."
                           Style="{StaticResource FluentPageSubtitleStyle}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel Margin="0,0,0,8">
                <ui:Button Style="{StaticResource MoreActionCardButtonStyle}" Click="AboutCard_Click" ToolTip="Abrir o Sobre e o GitHub Pages do projeto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PageHeaderIconTileStyle}" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="Globe24" Style="{StaticResource PageHeaderSymbolIconStyle}" />
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,16,0,16">
                            <TextBlock Text="Sobre o WinProvision" Style="{StaticResource FluentCardTitleStyle}" />
                            <TextBlock Text="Conheça o projeto e abra o site hospedado no GitHub Pages."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Abrir Sobre" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="ArrowRight24" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ui:Button>

                <ui:Button Style="{StaticResource MoreActionCardButtonStyle}" Click="HistoryCard_Click" ToolTip="Abrir o histórico de operações">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PageHeaderIconTileStyle}" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="History24" Style="{StaticResource PageHeaderSymbolIconStyle}" />
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,16,0,16">
                            <TextBlock Text="Histórico de operações" Style="{StaticResource FluentCardTitleStyle}" />
                            <TextBlock Text="Consulte instalações, atualizações e remoções concluídas."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Abrir histórico" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="ArrowRight24" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ui:Button>

                <ui:Button Style="{StaticResource MoreActionCardButtonStyle}" Click="LogCard_Click" ToolTip="Abrir o visualizador do log de diagnóstico">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PageHeaderIconTileStyle}" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource PageHeaderSymbolIconStyle}" />
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,16,0,16">
                            <TextBlock Text="Log de diagnóstico" Style="{StaticResource FluentCardTitleStyle}" />
                            <TextBlock Text="Leia diretamente as mensagens técnicas recentes do WinProvision e do WinGet."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Visualizar log" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="ArrowRight24" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ui:Button>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Page>
