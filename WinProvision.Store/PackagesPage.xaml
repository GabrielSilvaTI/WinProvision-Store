<Page x:Class="WinProvision.Store.PackagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="PackagesPage">

    <Page.Resources>
        <DataTemplate x:Key="CollectionEntryCardTemplate">
            <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="6" ClipToBounds="True">
                        <Image conv:AsyncImage.SourceUrl="{Binding IconUrl}" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Publisher, StringFormat=' ({0})'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11">
                            <Run Text="ID: " />
                            <Run Text="{Binding Id, Mode=OneWay}" />
                            <Run Text="   Versão: " />
                            <Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <ui:Button Grid.Column="2" VerticalAlignment="Center" Content="Remover" Appearance="Secondary"
                               Click="RemoveButton_Click" Tag="{Binding}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- Grid principal restrito à tela -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Row 0: Cabeçalho Fixo -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Barra de Ferramentas Fixa -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Guias + Lista de Apps (Única área rolável) -->
            <RowDefinition Height="*" />
            <!-- Row 3: Rodapé Fixo -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecalho Fixo -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="32" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Coleção de Pacotes" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Gerencie múltiplos perfis e exporte/importe suas listas de aplicativos." Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- BARRA DE FERRAMENTAS SUPERIOR -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="8" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <WrapPanel Orientation="Horizontal">
                <ui:Button x:Name="NewTabButton" Content="Novo" Appearance="Transparent" Margin="0,0,4,0" Click="NewTabButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button x:Name="ImportProfileButton" Content="Abrir perfil" Appearance="Transparent" Margin="0,0,4,0" Click="ImportProfileButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button x:Name="ExportProfileButton" Content="Salvar como..." Appearance="Transparent" Margin="0,0,4,0" Click="ExportProfileButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button x:Name="ExportScriptButton" Content="Criar script .ps1" Appearance="Transparent" Margin="0,0,4,0" Click="ExportScriptButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Code24" />
                    </ui:Button.Icon>
                </ui:Button>

                <Rectangle Width="1" Height="20" Margin="4,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <ui:Button x:Name="ClearCollectionButton" Content="Limpar guia atual" Appearance="Transparent" Click="ClearCollectionButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:Button.Icon>
                </ui:Button>
            </WrapPanel>
        </Border>

        <!-- TAB CONTROL COM ROLAGEM FLUIDA E CAPTURA DE MOUSE EM TODA A ÁREA -->
        <TabControl x:Name="ProfileTabControl" 
                    Grid.Row="2" 
                    VerticalAlignment="Stretch" 
                    SelectionChanged="ProfileTabControl_SelectionChanged">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:Button Appearance="Transparent" Padding="2" Click="CloseTabButton_Click" Tag="{Binding}">
                            <ui:SymbolIcon Symbol="Dismiss12" />
                        </ui:Button>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <!-- Background="Transparent" garante que o ScrollViewer capture eventos do ponteiro do mouse em áreas vazias -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  Focusable="False"
                                  Margin="0,8,0,0"
                                  behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                        <ItemsControl ItemsSource="{Binding Items}" 
                                      ItemTemplate="{StaticResource CollectionEntryCardTemplate}" 
                                      Background="Transparent" />
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Rodapé Fixo -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Nenhum pacote nesta guia ainda." Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
