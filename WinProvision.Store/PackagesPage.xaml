<Page x:Class="WinProvision.Store.PackagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="Coleção de Pacotes"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="13"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <conv:PackageSourceLabelConverter x:Key="PackageSourceLabelConverter" />

        <Style x:Key="CollectionWingetSourceIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="MailInboxArrowDown16" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="winget">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CollectionStoreSourceIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="StoreMicrosoft24" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="msstore">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Estilos de Cabeçalho / Cartões  -->
        <Style x:Key="PageTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentPageTitleStyle}" />
        <Style x:Key="CardTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCardTitleStyle}" />

        <Style x:Key="CardSubtitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Ações da coleção no padrão visual das páginas principais  -->
        <Style x:Key="ToolbarButtonStyle"
               TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ToolbarToggleButtonStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{DynamicResource InstallActionBrush}" />
                                <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{DynamicResource InstallActionBrush}" />
                                <Setter TargetName="ToggleSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceSelectionButtonStyle"
               TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!--  Estilo de linha da coleção  -->
        <Style x:Key="PackageTableRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource StoreCardCornerRadius}" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelectedForInstall}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionSuccessSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SelectionSuccessBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelectedForInstall}" Value="True" />
                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SelectionSuccessSubtleBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Template da linha da tabela de coleção  -->
        <DataTemplate x:Key="CollectionTableRowTemplate">
            <Border Style="{StaticResource PackageTableRowStyle}"
                    MouseLeftButtonUp="TableRow_Click"
                    MouseRightButtonUp="TableRow_RightClick"
                    Tag="{Binding}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Instalar" Click="ContextMenuInstall_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Instalar como administrador" Click="ContextMenuInstallAdmin_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Shield24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Baixar instalador" Click="ContextMenuDownload_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remover da coleção" Click="ContextMenuRemove_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Detalhes do pacote" Click="ContextMenuDetails_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Info24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copiar ID do pacote" Click="ContextMenuCopyId_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid Margin="5,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <!--  Indicador de seleção, sem checkbox no item.  -->
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Checkmark24"
                                   FontSize="18"
                                   Foreground="{DynamicResource SelectionSuccessBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsSelectedForInstall, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!--  Ícone  -->
                    <Grid Grid.Column="1"
                          Width="26"
                          Height="26"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          ClipToBounds="True">
                        <ui:SymbolIcon Symbol="Box24"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=TableAppImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        <Image x:Name="TableAppImage"
                               conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                               conv:AsyncImage.DecodePixelWidth="64"
                               Stretch="Uniform"
                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=TableAppImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <!--  Nome + Fornecedor  -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="6,0,12,0">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Publisher}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--  ID do Pacote  -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Id}"
                               FontSize="11.5"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis" />

                    <!--  Versão  -->
                    <TextBlock Grid.Column="4"
                               Text="{Binding Version}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis" />

                    <!--  Fonte / Gerenciador com Badge  -->
                    <Border Grid.Column="5"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource StoreRadius_4}"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16"
                                  Height="16"
                                  Margin="0,0,6,0">
                                <ui:SymbolIcon Style="{StaticResource CollectionWingetSourceIconStyle}" />
                                <ui:SymbolIcon Style="{StaticResource CollectionStoreSourceIconStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding Source, Converter={StaticResource PackageSourceLabelConverter}}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!--  Tamanho Estimado  -->
                    <TextBlock Grid.Column="6"
                               Text="{Binding InstallerSizeDisplay, Mode=OneWay}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />

                    <!--  Ação Rápida: Remover  -->
                    <ui:Button Grid.Column="7"
                               Appearance="Transparent"
                               Width="28"
                               Height="28"
                               Padding="0"
                               CornerRadius="{StaticResource StoreRadius_4}"
                               Click="RemoveButton_Click"
                               Tag="{Binding}"
                               ToolTip="Remover da coleção">
                        <ui:SymbolIcon Symbol="Dismiss24"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Template do Cartão Grid (Modo Grade)  -->
        <DataTemplate x:Key="AppGridCardTemplate">
            <Border Width="220"
                    Height="240"
                    Padding="14"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Margin="0,0,14,14"
                    Cursor="Hand"
                    MouseLeftButtonUp="Card_Click"
                    Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelectedForInstall}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SelectionSuccessBrush}" />
                                <Setter Property="Background" Value="{DynamicResource SelectionSuccessSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Topo: Checkbox e Fonte  -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Checkmark24"
                                       FontSize="18"
                                       Foreground="{DynamicResource SelectionSuccessBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsSelectedForInstall, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource StoreRadius_4}"
                                Padding="6,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="14"
                                      Height="14"
                                      Margin="0,0,4,0">
                                    <ui:SymbolIcon Style="{StaticResource CollectionWingetSourceIconStyle}" FontSize="14" />
                                    <ui:SymbolIcon Style="{StaticResource CollectionStoreSourceIconStyle}" FontSize="14" />
                                </Grid>
                                <TextBlock Text="{Binding Source, Converter={StaticResource PackageSourceLabelConverter}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Centro: Ícone e Títulos  -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Grid Width="52"
                              Height="52"
                              Margin="0,0,0,10"
                              ClipToBounds="True"
                              HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Box24"
                                           FontSize="26"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=GridCardAppImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Image x:Name="GridCardAppImage"
                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                   conv:AsyncImage.DecodePixelWidth="96"
                                   Stretch="Uniform"
                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=GridCardAppImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="190" />

                        <TextBlock Text="{Binding Publisher}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="190"
                                   Margin="0,2,0,0" />

                        <TextBlock Text="{Binding Version}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!--  Base: Botão Remover  -->
                    <ui:Button Grid.Row="2"
                               HorizontalAlignment="Center"
                               Appearance="Secondary"
                               Click="RemoveButton_Click"
                               Tag="{Binding}"
                               CornerRadius="{StaticResource ControlCornerRadius}"
                               Padding="14,4"
                               FontSize="11"
                               ToolTip="Remover da coleção">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24"
                                           FontSize="13"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="Remover" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AppIconTileTemplate">
            <Border Width="112"
                    Height="116"
                    Margin="0,0,8,8"
                    Padding="8"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    MouseLeftButtonUp="Card_Click"
                    Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelectedForInstall}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionSuccessSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SelectionSuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ui:SymbolIcon Symbol="Checkmark24"
                                   FontSize="17"
                                   Foreground="{DynamicResource SelectionSuccessBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding IsSelectedForInstall, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="40" Height="40">
                            <ui:SymbolIcon Symbol="Box24"
                                           FontSize="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=IconTileImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Image x:Name="IconTileImage"
                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                   conv:AsyncImage.DecodePixelWidth="64"
                                   Stretch="Uniform"
                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=IconTileImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   MaxHeight="30"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--  Estrutura principal da coleção  -->
    <Grid Margin="{StaticResource PageContentMargin}"
          MaxWidth="{StaticResource PageContentMaxWidth}"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ==================== HEADER (TOPO) ====================  -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="{StaticResource PageHeaderMargin}">
            <Border Style="{StaticResource PageHeaderIconTileStyle}">
                <ui:SymbolIcon Symbol="Layer24" Style="{StaticResource PageHeaderSymbolIconStyle}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Coleção de Pacotes" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Crie, gerencie e instale coleções de pacotes personalizadas."
                           Style="{StaticResource FluentPageSubtitleStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <!--  ==================== AÇÕES DA COLEÇÃO ====================  -->
        <Border Grid.Row="1" Style="{StaticResource PageToolbarContainerStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="SidebarToggleToolbarButton"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  IsChecked="True"
                                  Click="ToggleSidebarButton_Click"
                                  ToolTip="Exibir ou ocultar o painel de filtros">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Filter24"
                                           FontSize="16"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="Filtros" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ui:SplitButton x:Name="InstallSelectedButton"
                                    Appearance="Primary"
                                    Height="34"
                                    MinHeight="34"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                                    ToolTip="Instalar os aplicativos selecionados; use a seta para opções avançadas"
                                    Click="InstallSelectedButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24"
                                           FontSize="16"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="Instalar seleção"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:SplitButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="Instalar como administrador"
                                          Tag="Admin"
                                          Click="InstallOption_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Shield24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Instalação interativa"
                                          Tag="Interactive"
                                          Click="InstallOption_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Window24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Pular verificação de integridade"
                                          Tag="SkipHash"
                                          Click="InstallOption_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ShieldDismiss24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Baixar instaladores dos selecionados"
                                          Tag="Download"
                                          Click="InstallOption_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:SplitButton.Flyout>
                    </ui:SplitButton>

                    <ui:Button x:Name="PackageDetailsToolbarButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Ver detalhes do pacote selecionado"
                               Click="PackageDetailsToolbarButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24"
                                           FontSize="16"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="Detalhes" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="ReloadCollectionButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Recalcular dados e atualizar a coleção"
                               Click="ReloadCollectionButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise24"
                                           FontSize="16"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="Recarregar" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="MoreActionsButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Mais ações da coleção"
                               Click="MoreActionsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="MoreHorizontal24"
                                           FontSize="16"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="Mais" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button.ContextMenu>
                            <ContextMenu x:Name="MoreActionsMenu">
                                <MenuItem Header="Selecionar todos" Click="ToggleSelectAllButton_Click" />
                                <MenuItem Header="Remover seleção da coleção" Click="RemoveSelectedButton_Click" />
                                <Separator />
                                <MenuItem Header="Novo perfil" Click="NewTabButton_Click" />
                                <MenuItem Header="Renomear perfil" Click="RenameProfileButton_Click" />
                                <MenuItem Header="Excluir perfil" Click="CloseTabButton_Click" />
                                <Separator />
                                <MenuItem Header="Abrir coleção JSON" Click="OpenBundleButton_Click" />
                                <MenuItem Header="Salvar coleção como JSON" Click="SaveBundleButton_Click" />
                                <MenuItem Header="Criar script PowerShell" Click="ExportScriptButton_Click" />
                                <Separator />
                                <MenuItem Header="Limpar coleção" Click="ClearCollectionButton_Click" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>

                    <!--  Controles auxiliares mantidos para sincronizar o estado e os comandos da página.  -->
                    <StackPanel Visibility="Collapsed">
                        <ui:Button x:Name="ToggleSelectAllButton" Click="ToggleSelectAllButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="ToggleSelectAllIcon" Symbol="CheckmarkCircle24" />
                                <TextBlock x:Name="ToggleSelectAllText" Text="Selecionar todos" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="RemoveSelectedButton" Click="RemoveSelectedButton_Click" />
                        <ui:Button x:Name="RenameProfileButton" Click="RenameProfileButton_Click" />
                        <ui:Button x:Name="CloseProfileButton" Click="CloseTabButton_Click" />
                        <ui:Button x:Name="CollapseSidebarButton" Click="ToggleSidebarButton_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  ==================== ÁREA PRINCIPAL ====================  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterSidebarColumn" Width="260" />
                <ColumnDefinition x:Name="FilterSplitterColumn" Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ========== PAINEL LATERAL DE FILTROS ==========  -->
            <Border x:Name="FilterSidebarPanel"
                    Grid.Column="0"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource StoreCardCornerRadius}"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!--  Título do Painel  -->
                        <TextBlock Text="Filtros"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,10"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <!--  Expander: Fontes  -->
                        <Expander IsExpanded="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,2"
                                  Margin="0,0,0,8">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Apps24"
                                                   FontSize="16"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Fontes"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource StoreRadius_6}"
                                    Padding="6"
                                    Margin="0,6,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0"
                                                   Style="{StaticResource SourceSelectionButtonStyle}"
                                                   Margin="0,0,4,0"
                                                   Padding="6,0"
                                                   Click="SelectAllCollectionSources_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                                               FontSize="14"
                                                               Margin="0,0,4,0" />
                                                <TextBlock Text="Selecionar tudo" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button Grid.Column="1"
                                                   Style="{StaticResource SourceSelectionButtonStyle}"
                                                   Margin="4,0,0,0"
                                                   Padding="6,0"
                                                   Click="ClearCollectionSources_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="DismissCircle24"
                                                               FontSize="14"
                                                               Margin="0,0,4,0" />
                                                <TextBlock Text="Limpar" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>
                                    <CheckBox x:Name="FilterSourceAllCheckBox"
                                              Content="Todas as fontes"
                                              IsChecked="True"
                                              Click="FilterCheckBox_Click"
                                              Margin="2,3" />
                                    <CheckBox x:Name="FilterSourceWingetCheckBox"
                                              IsChecked="True"
                                              Click="FilterCheckBox_Click"
                                              Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="MailInboxArrowDown16"
                                                           FontSize="16"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="WinGet" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="FilterSourceMsStoreCheckBox"
                                              IsChecked="True"
                                              Click="FilterCheckBox_Click"
                                              Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="StoreMicrosoft24"
                                                           FontSize="16"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="Microsoft Store" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="FilterSourceOfficeCheckBox"
                                              IsChecked="True"
                                              Click="FilterCheckBox_Click"
                                              Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Apps24"
                                                           FontSize="16"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="Office (ODT)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Rectangle Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,0,0,8" />

                        <!--  Expander: Filtros adicionais  -->
                        <Expander IsExpanded="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,2"
                                  Margin="0,0,0,8">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Filter24"
                                                   FontSize="16"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Filtros"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource StoreRadius_6}"
                                    Padding="6"
                                    Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Perfil"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="2,0,0,4" />
                                    <StackPanel x:Name="ViewProfilePanel"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <ComboBox x:Name="ProfileTabControl"
                                                  Height="32"
                                                  HorizontalAlignment="Stretch"
                                                  Width="205"
                                                  DisplayMemberPath="Title"
                                                  SelectedIndex="0"
                                                  SelectionChanged="ProfileTabControl_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel x:Name="EditProfilePanel"
                                                Orientation="Horizontal"
                                                Visibility="Collapsed"
                                                VerticalAlignment="Center">
                                        <ui:TextBox x:Name="RenameProfileTextBox"
                                                    Width="140"
                                                    Height="32"
                                                    Margin="0,0,6,0"
                                                    KeyDown="RenameProfileTextBox_KeyDown" />
                                        <ui:Button Appearance="Primary"
                                                   Height="32"
                                                   Padding="8,0"
                                                   Margin="0,0,4,0"
                                                   ToolTip="Salvar nome"
                                                   Click="SaveProfileNameButton_Click">
                                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="15" />
                                        </ui:Button>
                                        <ui:Button Appearance="Secondary"
                                                   Height="32"
                                                   Padding="8,0"
                                                   ToolTip="Cancelar"
                                                   Click="CancelProfileNameButton_Click">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" />
                                        </ui:Button>
                                    </StackPanel>
                                    <CheckBox x:Name="FilterOnlySelectedCheckBox"
                                              Content="Apenas selecionados"
                                              Click="FilterCheckBox_Click"
                                              Margin="2,8,2,3" />
                                    <Rectangle Height="1"
                                               Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                               Margin="0,6" />
                                    <TextBlock Text="Estimativas"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="2,0,0,4" />
                                    <TextBlock Text="Tamanho total"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="EstimatedSizeText"
                                               Text="Calculando…"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="2,1,0,6" />
                                    <TextBlock Text="Tempo de download aprox."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="EstimatedTimeText"
                                               Text="Calculando…"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="2,1,0,0" />
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Rectangle Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,0,0,8" />

                        <!--  Modo de pesquisa  -->
                        <Expander IsExpanded="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,2">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24"
                                                   FontSize="16"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Modo de pesquisa"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <ui:AutoSuggestBox x:Name="PackageSearchTextBox"
                                               PlaceholderText="Pesquisar nome ou ID..."
                                               Icon="{ui:SymbolIcon Search24}"
                                               ClearButtonEnabled="True"
                                               MaxSuggestionListHeight="280"
                                               Height="36"
                                               Margin="0,6,0,8"
                                               TextChanged="PackageSearchTextBox_TextChanged"
                                               QuerySubmitted="PackageSearchBox_QuerySubmitted"
                                               AutomationProperties.Name="Pesquisar aplicativos na coleção"
                                               ToolTip="Pesquise pelo nome ou ID do pacote" />
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  GridSplitter Vertical  -->
            <Rectangle Grid.Column="1"
                       Width="1"
                       Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                       HorizontalAlignment="Center" />

            <!--  ========== CONTEÚDO PRINCIPAL (TABELA / GRADE) ==========  -->
            <Border Grid.Column="2"
                    Background="{DynamicResource AppCardBackgroundBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource StoreCardCornerRadius}"
                    Padding="8,8,8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  CABEÇALHO DA TABELA com cantos arredondados  -->
                    <Border x:Name="TableHeaderBar"
                            Grid.Row="0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Effect="{x:Null}"
                            CornerRadius="{StaticResource StoreRadius_5}"
                            Height="34"
                            Padding="0"
                            Margin="0,0,0,4">
                        <Grid Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      x:Name="SelectAllHeaderCheckBox"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Padding="0"
                                      Margin="0"
                                      Click="SelectAllHeaderCheckBox_Click"
                                      ToolTip="Selecionar ou desmarcar todos" />

                            <TextBlock x:Name="NameSortHeader"
                                       Grid.Column="2"
                                       Text="Nome do aplicativo"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="6,0,0,0"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="SortByName_Click" />
                            <TextBlock x:Name="IdSortHeader"
                                       Grid.Column="3"
                                       Text="ID do Pacote"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="SortById_Click" />
                            <TextBlock x:Name="VersionSortHeader"
                                       Grid.Column="4"
                                       Text="Versão"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="SortByVersion_Click" />
                            <TextBlock x:Name="SourceSortHeader"
                                       Grid.Column="5"
                                       Text="Origem"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="SortBySource_Click" />
                            <TextBlock Grid.Column="6"
                                       Text="Tamanho"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock Grid.Column="7"
                                       Text="Ações"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!--  MODO TABELA (LISTVIEW / ITEMSCONTROL)  -->
                    <ScrollViewer x:Name="ListViewScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ItemsControl x:Name="AppCollectionListItemsControl"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ItemTemplate="{StaticResource CollectionTableRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  MODO GRADE (CARDS VIEW)  -->
                    <ScrollViewer x:Name="GridViewScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="AppCollectionItemsControl"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ItemTemplate="{StaticResource AppGridCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ui:VirtualizingWrapPanel Orientation="Vertical"
                                                              ItemSize="248,258"
                                                              SpacingMode="Uniform" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer x:Name="IconsViewScrollViewer"
                                  Grid.Row="1"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ItemsControl x:Name="AppCollectionIconsItemsControl"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ItemTemplate="{StaticResource AppIconTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ui:VirtualizingWrapPanel Orientation="Vertical"
                                                              ItemSize="128,132"
                                                              SpacingMode="Uniform" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  ESTADO VAZIO (EMPTY STATE)  -->
                    <StackPanel x:Name="EmptyCollectionPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Margin="32">
                        <Border Width="72"
                                Height="72"
                                CornerRadius="{StaticResource StoreRadius_16}"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Image Source="{DynamicResource EmptyStateBrandIcon}"
                                   Width="48"
                                   Height="48"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Ícone do WinProvision" />
                        </Border>

                        <TextBlock Text="Sua coleção de pacotes está vazia"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Text="Adicione aplicativos a partir da Visão Geral ou abra um arquivo de coleção JSON (.json)."
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,6,0,16"
                                   TextAlignment="Center"
                                   MaxWidth="440"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Appearance="Primary"
                                       Content="Abrir arquivo de coleção"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Padding="16,8"
                                       Margin="0,0,8,0"
                                       CornerRadius="{StaticResource ControlCornerRadius}"
                                       Background="{DynamicResource InstallActionBrush}"
                                       Foreground="White"
                                       Click="OpenBundleButton_Click" />
                            <ui:Button Appearance="Secondary"
                                       Content="Criar novo perfil"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Padding="16,8"
                                       CornerRadius="{StaticResource ControlCornerRadius}"
                                       Click="NewTabButton_Click" />
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <ui:InfoBar x:Name="CollectionInfoBar"
                    Style="{StaticResource StoreInfoBarStyle}"
                    Grid.Row="2"
                    IsOpen="False"
                    Severity="Error"
                    Title="Não foi possível concluir a ação"
                    Panel.ZIndex="10" />

        <!--  ==================== STATUS BAR / RODAPÉ ====================  -->
        <Border Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Status e Seleção  -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Style="{StaticResource PageStatusIconStyle}" />
                    <TextBlock x:Name="SelectionSummaryText"
                               Text="0 selecionados · Ação: Instalar seleção"
                               Style="{StaticResource PageStatusPrimaryTextStyle}" />
                    <TextBlock Text=" · "
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="Pronto."
                               Style="{StaticResource PageStatusTextStyle}" />
                </StackPanel>

                <!--  Alternador de Modo de Visualização (Tabela / Cartões)  -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Classificar por:"
                               Style="{StaticResource PageStatusTextStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="SortModeComboBox"
                              Width="150"
                              Height="32"
                              SelectedIndex="0"
                              SelectionChanged="SortModeComboBox_SelectionChanged"
                              Margin="0,0,12,0">
                        <ComboBoxItem Content="Nome" />
                        <ComboBoxItem Content="ID" />
                        <ComboBoxItem Content="Versão" />
                        <ComboBoxItem Content="Origem" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ListViewToggleButton"
                                      Style="{StaticResource PageViewModeToggleStyle}"
                                      IsChecked="True"
                                      ToolTip="Visualização em lista"
                                      Click="ListViewToggleButton_Click">
                            <ui:SymbolIcon Symbol="List24" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton x:Name="GridViewToggleButton"
                                      Style="{StaticResource PageViewModeToggleStyle}"
                                      IsChecked="False"
                                      ToolTip="Visualização em grade de cartões"
                                      Click="GridViewToggleButton_Click">
                            <ui:SymbolIcon Symbol="Grid24" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton x:Name="IconsViewToggleButton"
                                      Style="{StaticResource PageViewModeToggleStyle}"
                                      ToolTip="Visualização em ícones"
                                      Click="IconsViewToggleButton_Click">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NoResultsPanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Margin="32">
                    <ui:SymbolIcon Symbol="Search24"
                                   FontSize="30"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />
                    <TextBlock Text="Nenhum pacote encontrado"
                               FontSize="17"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Tente outro termo ou ajuste os filtros da coleção."
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               Margin="0,6,0,12"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Content="Limpar pesquisa e filtros"
                               Appearance="Secondary"
                               HorizontalAlignment="Center"
                               Click="ResetCollectionFilters_Click" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>
