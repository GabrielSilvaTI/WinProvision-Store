<Page x:Class="WinProvision.Store.PackagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="PackagesPage"
      Background="Transparent"
    TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
    TextElement.FontSize="14"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextHintingMode="Auto"
    RenderOptions.ClearTypeHint="Enabled"
    UseLayoutRounding="True">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />

        <!-- Tipografia Fluent (Segoe UI Variable) -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Cartão Base "Mica-Friendly" -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
        </Style>

        <!-- Botões de Ação Uniformes -->
        <Style x:Key="ActionUniformButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ========================================== -->
        <!-- ========================================== -->
        <!-- TEMPLATE DO CARTÃO DO APLICATIVO (GRID VIEW) -->
        <!-- ========================================== -->
        <DataTemplate x:Key="AppGridCardTemplate">
            <Border Width="214" Height="248" Padding="14" CornerRadius="12" 
                    Margin="0,0,16,16"
                    Cursor="Hand" MouseLeftButtonUp="Card_Click" Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelectedForInstall}" Value="True">
                                <Setter Property="BorderBrush" Value="#4CAF6B" />
                                <Setter Property="Background" Value="#154CAF6B" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelectedForInstall}" Value="True" />
                                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#254CAF6B" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Topo: Ícone de Checkmark verde (estilo Office) visível quando selecionado -->
                    <Grid Grid.Row="0" Height="20">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedForInstall}" Value="True">
                                            <Setter Property="Foreground" Value="#4CAF6B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Grid>

                    <!-- Centro: Ícone e Detalhes com respiro ajustado -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Border Width="56" Height="56" Margin="0,0,0,8" CornerRadius="12" ClipToBounds="True">
                            <Grid>
                                <ui:SymbolIcon Symbol="Box24" FontSize="34"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=GridCardAppImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <Image x:Name="GridCardAppImage" conv:AsyncImage.SourceUrl="{Binding IconUrl}" Stretch="Uniform"
                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=GridCardAppImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" 
                                   FontFamily="Segoe UI Variable Text" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />

                        <TextBlock Text="{Binding Publisher}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />

                        <TextBlock Text="{Binding Version, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Base: Botão Remover -->
                    <ui:Button Grid.Row="2" HorizontalAlignment="Center" Appearance="Secondary" 
                               Click="RemoveButton_Click" Tag="{Binding}" CornerRadius="6" Padding="12,6" ToolTip="Remover da coleção">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Lista compacta: mesma informação do card com seleção verde idêntica -->
        <DataTemplate x:Key="AppListTemplate">
            <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                    Cursor="Hand" MouseLeftButtonUp="Card_Click" Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AppBorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelectedForInstall}" Value="True">
                                <Setter Property="BorderBrush" Value="#4CAF6B" />
                                <Setter Property="Background" Value="#154CAF6B" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelectedForInstall}" Value="True" />
                                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#254CAF6B" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="CheckmarkCircle24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedForInstall}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF6B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0">
                        <Grid>
                            <ui:SymbolIcon Symbol="Box24" FontSize="22"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=ListAppImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Image x:Name="ListAppImage" conv:AsyncImage.SourceUrl="{Binding IconUrl}" Stretch="Uniform"
                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=ListAppImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Publisher}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ui:Button Grid.Column="5" Appearance="Transparent" Padding="8" CornerRadius="6" Click="RemoveButton_Click" Tag="{Binding}" ToolTip="Remover da coleção">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24,20" MaxWidth="1600" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Cabeçalho ================= -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="32" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Coleção de Pacotes" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Crie e gerencie seus perfis." FontSize="14" Style="{StaticResource CardSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- ================= Seletor de Perfil ================= -->
        <StackPanel Grid.Row="1" Margin="0,0,0,24">
            <!-- Painel de Visualização Padrão -->
            <StackPanel x:Name="ViewProfilePanel" Orientation="Horizontal">
                <ComboBox x:Name="ProfileTabControl" Width="280" DisplayMemberPath="Title" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="ProfileTabControl_SelectionChanged" />

                <ui:Button x:Name="RenameProfileButton" Appearance="Transparent" CornerRadius="6" Padding="8" Margin="0,0,4,0" ToolTip="Renomear perfil" Click="RenameProfileButton_Click" IsEnabled="False">
                    <ui:SymbolIcon Symbol="Edit24" FontSize="18" />
                </ui:Button>

                <ui:Button x:Name="CloseProfileButton" Appearance="Transparent" CornerRadius="6" Padding="8" ToolTip="Excluir perfil atual" Click="CloseTabButton_Click" IsEnabled="False">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                </ui:Button>
            </StackPanel>

            <!-- Painel de Renomeação (Inicia Oculto) -->
            <StackPanel x:Name="EditProfilePanel" Orientation="Horizontal" Visibility="Collapsed">
                <ui:TextBox x:Name="RenameProfileTextBox" Width="280" Margin="0,0,8,0" PlaceholderText="Novo nome do perfil..." KeyDown="RenameProfileTextBox_KeyDown" />

                <ui:Button x:Name="SaveProfileNameButton" Appearance="Primary" CornerRadius="6" Padding="8" Margin="0,0,4,0" ToolTip="Salvar" Click="SaveProfileNameButton_Click">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="18" />
                </ui:Button>

                <ui:Button x:Name="CancelProfileNameButton" Appearance="Transparent" CornerRadius="6" Padding="8" ToolTip="Cancelar" Click="CancelProfileNameButton_Click">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                </ui:Button>
            </StackPanel>
        </StackPanel>

        <!-- ================= Corpo (Listagem e Resumo) ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="16" />
                <!-- Gutter -->
                <ColumnDefinition Width="316" />
            </Grid.ColumnDefinitions>

            <!-- ESQUERDA: Coleção de Aplicativos -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="24,24,24,0"
                    ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Barra de Ferramentas Interna (2 linhas explícitas para nunca fundir) -->
                    <Grid Grid.Row="0" Margin="0,0,0,24" VerticalAlignment="Top"
                          SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="40" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Linha 1 (superior): Título à esquerda · Toggle view + Pesquisa à direita -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Aplicativos na coleção"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0,0,0,12"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <ToggleButton x:Name="GridViewToggleButton" IsChecked="True" Padding="8,4" Margin="0,0,4,0"
                                          Click="GridViewToggleButton_Click" ToolTip="Visualização em cartões"
                                          VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="18" />
                            </ToggleButton>
                            <ToggleButton x:Name="ListViewToggleButton" Padding="8,4" Margin="0,0,12,0"
                                          Click="ListViewToggleButton_Click" ToolTip="Visualização em lista"
                                          VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="List24" FontSize="18" />
                            </ToggleButton>
                            <ui:TextBox x:Name="PackageSearchTextBox"
                                        PlaceholderText="Pesquisar aplicativos..."
                                        Width="240"
                                        Icon="Search24"
                                        VerticalAlignment="Center"
                                        TextChanged="PackageSearchTextBox_TextChanged" />
                        </StackPanel>

                        <!-- Linha 2 (inferior, full-width 2 colunas): Resumo + Selecionar todos à esquerda -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                            <TextBlock x:Name="SelectionSummaryText"
                                       Text="0 pacote(s) selecionado(s)"
                                       Style="{StaticResource CardSubtitleStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <ui:Button x:Name="ToggleSelectAllButton"
                                       Style="{StaticResource SelectAllButtonStyle}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Click="ToggleSelectAllButton_Click"
                                       ToolTip="Selecionar ou desmarcar todos os aplicativos">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="ToggleSelectAllIcon"
                                                   Symbol="CheckmarkCircle24"
                                                   FontSize="15"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock x:Name="ToggleSelectAllText"
                                               Text="Selecionar todos"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Área de Listagem de Aplicativos (Grid / Lista / Vazio) -->
                    <Grid Grid.Row="1"
                          ClipToBounds="True"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True"
                          Margin="0,4,0,0">
                        <!-- Mensagem Vazia (sobreposta à lista, aparece apenas quando 0 items) -->
                        <StackPanel x:Name="EmptyStatePanel"
                                    Panel.ZIndex="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding ElementName=ProfileTabControl, Path=SelectedItem.Items.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                            <ui:SymbolIcon Symbol="Box24" FontSize="40"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Nenhum aplicativo adicionado ainda."
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Variable Text" />
                        </StackPanel>

                        <ScrollViewer x:Name="GridViewScrollViewer"
                                      Panel.ZIndex="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ClipToBounds="True"
                                      behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                            <ItemsControl x:Name="AppCollectionItemsControl"
                                          ItemTemplate="{StaticResource AppGridCardTemplate}"
                                          VerticalAlignment="Top"
                                          HorizontalAlignment="Stretch"
                                          ClipToBounds="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   SnapsToDevicePixels="True"
                                                   UseLayoutRounding="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <ScrollViewer x:Name="ListViewScrollViewer"
                                      Panel.ZIndex="1"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ClipToBounds="True"
                                      behaviors:ScrollBehavior.EnableMouseWheelOnContent="True">
                            <ItemsControl x:Name="AppCollectionListItemsControl"
                                          ItemTemplate="{StaticResource AppListTemplate}"
                                          VerticalAlignment="Top"
                                          HorizontalAlignment="Stretch"
                                          ClipToBounds="True"
                                          SnapsToDevicePixels="True"
                                          UseLayoutRounding="True" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- DIREITA: Sidebar -->
            <StackPanel Grid.Column="2">

                <!-- Card 1: Resumo da Coleção -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <ui:SymbolIcon Symbol="DataPie24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Resumo da Coleção" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding ElementName=ProfileTabControl, Path=SelectedItem.Items.Count, FallbackValue=0}" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text" Margin="0,0,0,4" />
                        <TextBlock Text="Aplicativos" FontSize="16" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text" />
                        <TextBlock Text="no perfil" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Text" Margin="0,0,0,24" />

                        <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Download" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" x:Name="EstimatedSizeText" Text="—" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text" FontSize="13" Margin="8,0,0,0" />
                        </Grid>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Clock24" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Instalação" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" x:Name="EstimatedTimeText" Text="—" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text" FontSize="13" Margin="8,0,0,0" />
                        </Grid>

                        <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Perfil ativo" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text" />
                            <Border Grid.Column="1" Background="#1A4CC2FF" BorderBrush="#334CC2FF" BorderThickness="1" CornerRadius="12" Padding="12,4">
                                <TextBlock x:Name="ActiveProfileNameTextBlock" Text="{Binding ElementName=ProfileTabControl, Path=SelectedItem.Title, FallbackValue='Perfil Padrão'}" Foreground="#4CC2FF" FontSize="12" FontFamily="Segoe UI Variable Text" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Ações Rápidas -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Ações Rápidas" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Botão de Destaque -->
                        <ui:Button x:Name="InstallSelectedButton" Content="Instalar" Height="44" HorizontalAlignment="Stretch" Margin="0,0,0,12" CornerRadius="6"
                                   Background="{StaticResource InstallActionBrush}"
                                   MouseOverBackground="{StaticResource InstallActionHoverBrush}"
                                   PressedBackground="{StaticResource InstallActionPressedBrush}"
                                   Foreground="White" PressedForeground="White"
                                   Click="InstallSelectedButton_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!-- Ações Neutras Inferiores (UniformGrid com espaçamento otimizado) -->
                        <UniformGrid Columns="2" Margin="-3,0,-3,0">
                            <ui:Button x:Name="NewTabButtonSidebar" Content="Novo Perfil" ToolTip="Criar um novo perfil" Style="{StaticResource ActionUniformButtonStyle}" Appearance="Secondary" Click="NewTabButton_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="PersonAdd24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button x:Name="ImportProfileButton" Content="Abrir Perfil" ToolTip="Importar um perfil salvo" Style="{StaticResource ActionUniformButtonStyle}" Appearance="Secondary" Click="ImportProfileButton_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowImport24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button x:Name="ExportProfileButton" Content="Exportar" ToolTip="Salvar este perfil em arquivo JSON" Style="{StaticResource ActionUniformButtonStyle}" Appearance="Secondary" Click="ExportProfileButton_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderArrowUp24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button x:Name="ExportScriptButton" Content="Gerar Script" ToolTip="Exportar um script de instalação em lote" Style="{StaticResource ActionUniformButtonStyle}" Appearance="Secondary" Click="ExportScriptButton_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Code24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </UniformGrid>

                        <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,12,0,12" />

                        <ui:Button x:Name="ClearCollectionButton" Content="Limpar tudo" ToolTip="Remover todos os aplicativos deste perfil" Height="40" HorizontalAlignment="Stretch" Appearance="Secondary" CornerRadius="6" Click="ClearCollectionButton_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ================= Rodapé ================= -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,8,0,0">
            <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
            <!-- Concordância gramatical arrumada "Nenhum aplicativo" -->
            <TextBlock x:Name="StatusText" Text="[Perfil Padrão] Nenhum aplicativo adicionado ainda."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontFamily="Segoe UI Variable Text" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>