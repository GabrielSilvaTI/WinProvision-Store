<Page x:Class="WinProvision.Store.PackagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:WinProvision.Store.Converters"
      xmlns:behaviors="clr-namespace:WinProvision.Store.Behaviors"
      ScrollViewer.CanContentScroll="False"
      Title="Coleção de Pacotes"
      Background="Transparent"
      TextElement.FontFamily="Segoe UI Variable Text, Aptos, Segoe UI"
      TextElement.FontSize="13"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextHintingMode="Auto"
      RenderOptions.ClearTypeHint="Enabled"
      UseLayoutRounding="True">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />

        <!-- Estilos de Cabeçalho / Cartões -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentPageTitleStyle}" />
        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentCardTitleStyle}" />

        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Aptos, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Ações da coleção no padrão visual das páginas principais -->
        <Style x:Key="ToolbarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource StorePillCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Estilo de linha da coleção -->
        <Style x:Key="PackageTableRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource StoreCardCornerRadius}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelectedForInstall}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelectedForInstall}" Value="True" />
                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Template da linha da tabela de coleção -->
        <DataTemplate x:Key="CollectionTableRowTemplate">
            <Border Style="{StaticResource PackageTableRowStyle}"
                    MouseLeftButtonUp="TableRow_Click"
                    MouseRightButtonUp="TableRow_RightClick"
                    Tag="{Binding}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Instalar" Click="ContextMenuInstall_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Instalar como administrador" Click="ContextMenuInstallAdmin_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Shield24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Baixar instalador" Click="ContextMenuDownload_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remover da coleção" Click="ContextMenuRemove_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Detalhes do pacote" Click="ContextMenuDetails_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Info24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copiar ID do pacote" Click="ContextMenuCopyId_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid Margin="5,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <!-- Checkbox de Seleção -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelectedForInstall, Mode=TwoWay}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Padding="0"
                              Margin="0" />

                    <!-- Ícone -->
                    <Border Grid.Column="1"
                            Width="26" Height="26"
                            CornerRadius="{StaticResource StoreRadius_6}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            ClipToBounds="True">
                        <Grid>
                            <ui:SymbolIcon Symbol="Box24"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=TableAppImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Image x:Name="TableAppImage"
                                   conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                   Stretch="Uniform"
                                   Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=TableAppImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Nome + Fornecedor -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,12,0">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Publisher}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- ID do Pacote -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Id}"
                               FontSize="11.5"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Versão -->
                    <TextBlock Grid.Column="4"
                               Text="{Binding Version}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Fonte / Gerenciador com Badge -->
                    <Border Grid.Column="5"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource StoreRadius_4}"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Source}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Tamanho Estimado -->
                    <TextBlock Grid.Column="6"
                               Text="{Binding InstallerSizeDisplay, Mode=OneWay}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- Ação Rápida: Remover -->
                    <ui:Button Grid.Column="7"
                               Appearance="Transparent"
                               Width="28" Height="28"
                               Padding="0"
                               CornerRadius="{StaticResource StoreRadius_4}"
                               Click="RemoveButton_Click"
                               Tag="{Binding}"
                               ToolTip="Remover da coleção">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template do Cartão Grid (Modo Grade) -->
        <DataTemplate x:Key="AppGridCardTemplate">
            <Border Width="220"
                    Height="240"
                    Padding="14"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Margin="0,0,14,14"
                    Cursor="Hand"
                    MouseLeftButtonUp="Card_Click"
                    Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelectedForInstall}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter Property="Background" Value="{DynamicResource StoreBrush_181688E8}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Topo: Checkbox e Fonte -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding IsSelectedForInstall, Mode=TwoWay}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource StoreRadius_4}" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Border>
                    </Grid>

                    <!-- Centro: Ícone e Títulos -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="52" Height="52"
                                CornerRadius="{StaticResource StoreRadius_12}"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,10"
                                ClipToBounds="True"
                                HorizontalAlignment="Center">
                            <Grid>
                                <ui:SymbolIcon Symbol="Box24" FontSize="26"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=GridCardAppImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <Image x:Name="GridCardAppImage"
                                       conv:AsyncImage.SourceUrl="{Binding IconUrl}"
                                       Stretch="Uniform"
                                       Visibility="{Binding (conv:AsyncImage.HasContent), ElementName=GridCardAppImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="190" />

                        <TextBlock Text="{Binding Publisher}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="190"
                                   Margin="0,2,0,0" />

                        <TextBlock Text="{Binding Version}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Base: Botão Remover -->
                    <ui:Button Grid.Row="2"
                               HorizontalAlignment="Center"
                               Appearance="Secondary"
                               Click="RemoveButton_Click"
                               Tag="{Binding}"
                               CornerRadius="{StaticResource ControlCornerRadius}"
                               Padding="14,4"
                               FontSize="11"
                               ToolTip="Remover da coleção">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Remover" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AppIconTileTemplate">
            <Border Width="112" Height="116" Margin="0,0,8,8" Padding="8"
                    Background="Transparent" CornerRadius="{StaticResource ControlCornerRadius}"
                    MouseLeftButtonUp="Card_Click" Tag="{Binding}">
                <Grid>
                    <CheckBox IsChecked="{Binding IsSelectedForInstall, Mode=TwoWay}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="{Binding IconUrl}" Width="40" Height="40" Stretch="Uniform" />
                        <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="30" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- Estrutura principal da coleção -->
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== HEADER (TOPO) ==================== -->
        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título e Seletor de Perfil -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource PageHeaderIconTileStyle}"><ui:SymbolIcon Symbol="Layer24" Style="{StaticResource PageHeaderSymbolIconStyle}" /></Border>

                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Coleção de Pacotes" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Crie, gerencie e instale coleções de pacotes personalizadas."
                               Style="{StaticResource FluentPageSubtitleStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Barra de Gestão de Perfil (Pills) -->
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource StoreRadius_6}"
                        Padding="4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- Painel normal -->
                        <StackPanel x:Name="ViewProfilePanel" Orientation="Horizontal">
                            <ComboBox x:Name="ProfileTabControl"
                                      Width="240"
                                      DisplayMemberPath="Title"
                                      SelectedIndex="0"
                                      Margin="0,0,6,0"
                                      SelectionChanged="ProfileTabControl_SelectionChanged" />

                            <ui:Button x:Name="NewTabButton"
                                       Appearance="Transparent"
                                       Padding="8,4"
                                       CornerRadius="{StaticResource StoreRadius_4}"
                                       ToolTip="Criar nova guia de perfil"
                                       Click="NewTabButton_Click">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                            </ui:Button>

                            <ui:Button x:Name="RenameProfileButton"
                                       Appearance="Transparent"
                                       Padding="8,4"
                                       CornerRadius="{StaticResource StoreRadius_4}"
                                       ToolTip="Renomear perfil atual"
                                       Click="RenameProfileButton_Click">
                                <ui:SymbolIcon Symbol="Edit24" FontSize="16" />
                            </ui:Button>

                            <ui:Button x:Name="CloseProfileButton"
                                       Appearance="Transparent"
                                       Padding="8,4"
                                       CornerRadius="{StaticResource StoreRadius_4}"
                                       ToolTip="Excluir perfil atual"
                                       Click="CloseTabButton_Click">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                            </ui:Button>
                        </StackPanel>

                        <!-- Painel de edição/renomear inline -->
                        <StackPanel x:Name="EditProfilePanel" Orientation="Horizontal" Visibility="Collapsed">
                            <ui:TextBox x:Name="RenameProfileTextBox"
                                        Width="190"
                                        Margin="0,0,6,0"
                                        KeyDown="RenameProfileTextBox_KeyDown" />
                            <ui:Button Appearance="Primary" Padding="8,4" Margin="0,0,4,0" ToolTip="Salvar nome" Click="SaveProfileNameButton_Click">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="15" />
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Padding="8,4" ToolTip="Cancelar" Click="CancelProfileNameButton_Click">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" />
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Campo de busca principal -->
            <Border Grid.Column="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource StoreRadius_6}"
                    Padding="4,2"
                    Width="280"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="15" Margin="8,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                    <ui:TextBox Grid.Column="1"
                                x:Name="PackageSearchTextBox"
                                PlaceholderText="Filtrar coleção..."
                                BorderThickness="0"
                                Background="Transparent"
                                Padding="0"
                                VerticalAlignment="Center"
                                TextChanged="PackageSearchTextBox_TextChanged" />

                    <ui:Button Grid.Column="2"
                               Appearance="Transparent"
                               Padding="6,2"
                               CornerRadius="{StaticResource StoreRadius_4}"
                               ToolTip="Limpar busca"
                               Click="ClearSearchButton_Click">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== AÇÕES DA COLEÇÃO ==================== -->
        <Border Grid.Row="1" Style="{StaticResource PageToolbarContainerStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="86">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="SidebarToggleToolbarButton"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  IsChecked="True"
                                  Click="ToggleSidebarButton_Click"
                                  ToolTip="Exibir ou ocultar o painel de filtros">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Filter24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Filtros" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <!-- Instalação em lote e ações da coleção -->
                    <Border CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{StaticResource InstallActionBrush}"
                            Margin="0,0,6,0"
                            Height="34">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="InstallSelectedButton"
                                       Appearance="Transparent"
                                       Foreground="White"
                                       Height="34"
                                       Padding="12,0"
                                       ToolTip="Instalar todos os aplicativos selecionados na coleção"
                                       Click="InstallSelectedButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0" Foreground="White" />
                                    <TextBlock Text="Instalar seleção" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <Rectangle Width="1" Fill="{DynamicResource StoreBrush_33FFFFFF}" VerticalAlignment="Stretch" Margin="0,5" />

                            <ui:Button x:Name="InstallVariantsButton"
                                       Appearance="Transparent"
                                       Foreground="White"
                                       Width="26"
                                       Height="34"
                                       Padding="0"
                                       ToolTip="Mais opções de instalação"
                                       Click="InstallVariantsButton_Click">
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Foreground="White" />
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <ui:Button x:Name="ToggleSelectAllButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Selecionar ou desmarcar todos os aplicativos da coleção"
                               Click="ToggleSelectAllButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="ToggleSelectAllIcon" Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock x:Name="ToggleSelectAllText" Text="Selecionar todos" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <ui:Button x:Name="RemoveSelectedButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Remover aplicativos selecionados desta coleção"
                               Click="RemoveSelectedButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Remover seleção" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="PackageDetailsToolbarButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Ver detalhes do pacote selecionado"
                               Click="PackageDetailsToolbarButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Detalhes" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <!-- Botão Novo -->
                    <ui:Button x:Name="NewBundleButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Criar nova coleção de pacotes"
                               Click="NewTabButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Novo" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Botão Abrir (Importar Bundle) -->
                    <ui:Button x:Name="OpenBundleButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Abrir coleção de pacotes em arquivo JSON (.json)"
                               Click="OpenBundleButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Abrir" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Botão Salvar como (Exportar Bundle) -->
                    <ui:Button x:Name="SaveBundleButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Salvar coleção de pacotes em arquivo JSON (.json)"
                               Click="SaveBundleButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Salvar como" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Botão Criar script .ps1 -->
                    <ui:Button x:Name="ExportScriptButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Gerar script automatizado PowerShell (.ps1)"
                               Click="ExportScriptButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WindowConsole20" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Criar script .ps1" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <!-- Botão Limpar coleção -->
                    <ui:Button x:Name="ClearCollectionButton"
                               Style="{StaticResource ToolbarButtonStyle}"
                               ToolTip="Remover todos os aplicativos desta coleção"
                               Click="ClearCollectionButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Limpar coleção" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                </WrapPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== ÁREA PRINCIPAL ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterSidebarColumn" Width="220" />
                <ColumnDefinition x:Name="FilterSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========== PAINEL LATERAL DE FILTROS ========== -->
            <Border x:Name="FilterSidebarPanel"
                    Grid.Column="0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Título do Painel -->
                        <Grid Margin="4,0,0,10">
                            <TextBlock Text="Filtros" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <ui:Button x:Name="CollapseSidebarButton"
                                       Appearance="Transparent"
                                       Width="26" Height="26"
                                       Padding="0"
                                       HorizontalAlignment="Right"
                                       ToolTip="Recolher painel de filtros"
                                       Click="ToggleSidebarButton_Click">
                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" />
                            </ui:Button>
                        </Grid>

                        <!-- Expander: Fontes -->
                        <Expander IsExpanded="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,2"
                                  Margin="0,0,0,6">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Apps24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Fontes" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <ScrollViewer Margin="18,4,0,4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="FilterSourceAllCheckBox" Style="{StaticResource PageFilterChipStyle}"
                                                  IsChecked="True" Click="FilterCheckBox_Click" Content="Todos" />
                                    <ToggleButton x:Name="FilterSourceWingetCheckBox" Style="{StaticResource PageFilterChipStyle}"
                                                  IsChecked="True" Click="FilterCheckBox_Click" Content="WinGet" />
                                    <ToggleButton x:Name="FilterSourceMsStoreCheckBox" Style="{StaticResource PageFilterChipStyle}"
                                                  IsChecked="True" Click="FilterCheckBox_Click" Content="Microsoft Store" />
                                    <ToggleButton x:Name="FilterSourceOfficeCheckBox" Style="{StaticResource PageFilterChipStyle}"
                                                  IsChecked="True" Click="FilterCheckBox_Click" Content="Office (ODT)" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>

                        <!-- Expander: Seleção e Status -->
                        <Expander IsExpanded="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,2"
                                  Margin="0,0,0,6">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Seleção" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <ScrollViewer Margin="18,4,0,4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="FilterOnlySelectedCheckBox" Style="{StaticResource PageFilterChipStyle}"
                                                  Content="Apenas selecionados" Click="FilterCheckBox_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>

                        <!-- Expander: Estimativas -->
                        <Expander IsExpanded="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="4,2">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Estimativas" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource StoreRadius_6}"
                                    Padding="10,8"
                                    Margin="4,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Tamanho total:" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="EstimatedSizeText" Text="Calculando…" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,6" />

                                    <TextBlock Text="Tempo de download aprox.:" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="EstimatedTimeText" Text="Calculando…" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0" />
                                </StackPanel>
                            </Border>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- GridSplitter Vertical -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ========== CONTEÚDO PRINCIPAL (TABELA / GRADE) ========== -->
            <Border Grid.Column="2"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- CABEÇALHO DA TABELA com cantos arredondados -->
                    <Border x:Name="TableHeaderBar"
                            Grid.Row="0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource StoreRadius_4}"
                            Padding="4,6"
                            Margin="0,0,0,6">
                        <Grid Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      x:Name="SelectAllHeaderCheckBox"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Padding="0"
                                      Margin="0"
                                      Click="SelectAllHeaderCheckBox_Click"
                                      ToolTip="Selecionar ou desmarcar todos" />

                            <TextBlock Grid.Column="2" Text="Nome do aplicativo ▾" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonUp="SortByName_Click" />
                            <TextBlock Grid.Column="3" Text="ID do Pacote" FontWeight="SemiBold" FontSize="12" Cursor="Hand" MouseLeftButtonUp="SortById_Click" />
                            <TextBlock Grid.Column="4" Text="Versão" FontWeight="SemiBold" FontSize="12" Cursor="Hand" MouseLeftButtonUp="SortByVersion_Click" />
                            <TextBlock Grid.Column="5" Text="Origem" FontWeight="SemiBold" FontSize="12" Cursor="Hand" MouseLeftButtonUp="SortBySource_Click" />
                            <TextBlock Grid.Column="6" Text="Tamanho" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Grid.Column="7" Text="Ações" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- MODO TABELA (LISTVIEW / ITEMSCONTROL) -->
                    <ScrollViewer x:Name="ListViewScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AppCollectionListItemsControl"
                                      ItemTemplate="{StaticResource CollectionTableRowTemplate}" />
                    </ScrollViewer>

                    <!-- MODO GRADE (CARDS VIEW) -->
                    <ScrollViewer x:Name="GridViewScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="AppCollectionItemsControl"
                                      ItemTemplate="{StaticResource AppGridCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer x:Name="IconsViewScrollViewer" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AppCollectionIconsItemsControl" ItemTemplate="{StaticResource AppIconTileTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ESTADO VAZIO (EMPTY STATE) -->
                    <StackPanel x:Name="EmptyCollectionPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Margin="32">
                        <Border Width="64" Height="64"
                                CornerRadius="{StaticResource StoreRadius_16}"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Box24" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Sua coleção de pacotes está vazia"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Text="Adicione aplicativos a partir da Visão Geral ou abra um arquivo de coleção JSON (.json)."
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,6,0,16"
                                   TextAlignment="Center"
                                   MaxWidth="440"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Appearance="Primary"
                                       Content="Abrir arquivo de coleção"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Padding="16,8"
                                       Margin="0,0,8,0"
                                       Click="OpenBundleButton_Click" />
                            <ui:Button Appearance="Secondary"
                                       Content="Criar novo perfil"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Padding="16,8"
                                       Click="NewTabButton_Click" />
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- ==================== STATUS BAR / RODAPÉ ==================== -->
        <Border Grid.Row="3" Style="{StaticResource PageStatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status e Seleção -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Style="{StaticResource PageStatusIconStyle}" />
                    <TextBlock x:Name="SelectionSummaryText"
                               Text="0 selecionados · Ação: Instalar seleção"
                               Style="{StaticResource PageStatusPrimaryTextStyle}" />
                    <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="Pronto."
                               Style="{StaticResource PageStatusTextStyle}" />
                </StackPanel>

                <!-- Alternador de Modo de Visualização (Tabela / Cartões) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Classificar por:" Style="{StaticResource PageStatusTextStyle}" Margin="0,0,8,0" />
                    <ComboBox x:Name="SortModeComboBox" Width="150" Height="32" SelectedIndex="0"
                              SelectionChanged="SortModeComboBox_SelectionChanged" Margin="0,0,12,0">
                        <ComboBoxItem Content="Nome" />
                        <ComboBoxItem Content="ID" />
                        <ComboBoxItem Content="Versão" />
                        <ComboBoxItem Content="Origem" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ListViewToggleButton" Style="{StaticResource PageViewModeToggleStyle}"
                                      IsChecked="True"
                                      ToolTip="Visualização em lista"
                                      Click="ListViewToggleButton_Click">
                            <ui:SymbolIcon Symbol="List24" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton x:Name="GridViewToggleButton" Style="{StaticResource PageViewModeToggleStyle}"
                                      IsChecked="False"
                                      ToolTip="Visualização em grade de cartões"
                                      Click="GridViewToggleButton_Click">
                            <ui:SymbolIcon Symbol="Grid24" FontSize="16" />
                        </ToggleButton>
                        <ToggleButton x:Name="IconsViewToggleButton" Style="{StaticResource PageViewModeToggleStyle}"
                                      ToolTip="Visualização em ícones" Click="IconsViewToggleButton_Click">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>
