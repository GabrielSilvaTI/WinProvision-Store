<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Silencia avisos sobre APIs exclusivas do Windows (CA1416) -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinProvision.Core\WinProvision.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pesos do score e regras de ruído ficam fora do código para permitir
         recalibragem sem recompilar. Copiados para bin/config no build e publish. -->
    <None Include="config\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
